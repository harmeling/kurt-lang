; modal logic
load prop
prefix b 20, d 20          ; box and diamond
bool b, d, A, B, p, q
alias □ b
alias ◇ d
use ◇A ≡ ¬□¬A
use □A ≡ ¬◇¬A
use ◇p ∨ ◇q ≡ ◇(p ∨ q)
use □p ∧ □q ≡ □(p ∧ q)

; system K
use □(p ⇒ q) ⇒ (□p ⇒ □q)    "K"

; system T
use p ⇒ ◇p

; for automatic testing we add the following line:
;;; Proof checked.