; integers
;
; covers: `Int`, the integers -- the natural numbers and their negatives -- closed under `+`, `-`
; and `*`. As for natural.kurt, they are numbers of numbers.kurt, so its laws (and `calc`) apply.
load propositional, equality, set, numbers, natural
default real              ; every symbol of this file is a number, except where said otherwise:
set Int                  ; the integers are a set (of numbers)
const Int
builtin Int integers                   ; `calc on` proves `-3 ∈ Int`
tex Int \mathbb{Z}
; `kurt --lean` with Mathlib: the objects are Mathlib's reals (numbers.kurt), `Int` the integers
; among them (as `Nat` in natural.kurt)
lean Int member $1 ∈ Set.range (fun n : ℤ => (n : ℝ))
alias ℤ Int
use Int ⊂ Real  "int-sub-real"      ; a set of numbers (natural.kurt's "ext-real")
lean "int-sub-real" simp only [subset]; intro z hz; obtain ⟨x, rfl, _⟩ := k_numset_elem _ z hz; exact (k_mem_Real _).mpr rfl

use $n ∈ Nat  ⇒  $n ∈ Int                         "int-nat"
use $n ∈ Nat  ⇒  -$n ∈ Int                        "int-neg-nat"
use $z ∈ Int  ⇒  $z ∈ Nat ∨ -$z ∈ Nat             "int-cases"      ; nothing else
use $a ∈ Int ∧ $b ∈ Int  ⇒  $a + $b ∈ Int         "int-add"
use $a ∈ Int ∧ $b ∈ Int  ⇒  $a - $b ∈ Int         "int-sub"
use $a ∈ Int ∧ $b ∈ Int  ⇒  $a * $b ∈ Int         "int-mul"

show 0 ∈ Int     "int-zero"
proof
    0 ∈ Nat
    0 ∈ Int
qed

show 1 ∈ Int     "int-one"
proof
    1 ∈ Nat
    1 ∈ Int
qed

show $z ∈ Int  ⇒  -$z ∈ Int     "int-neg"
proof
    assume $z ∈ Int
        $z ∈ Nat ∨ -$z ∈ Nat
        case $z ∈ Nat
            -$z ∈ Int                                  ; int-neg-nat
        case -$z ∈ Nat
            -$z ∈ Int                                  ; int-nat
        -$z ∈ Int
qed

; a positive integer is a natural number
show $z ∈ Int ∧ $z > 0  ⇒  $z ∈ Nat     "int-pos-nat"
proof
    assume $z ∈ Int ∧ $z > 0
        $z ∈ Int
        $z > 0
        $z ∈ Nat ∨ -$z ∈ Nat
        case $z ∈ Nat
            $z ∈ Nat
        case -$z ∈ Nat
            0 <= -$z                                   ; nat-nonneg
            -$z >= 0                                   ; le-ge
            -$z + $z >= 0 + $z                         ; ge-add
            -$z + $z = 0                               ; add-inverse
            0 + $z = $z                                ; add-identity
            0 >= 0 + $z
            0 >= $z
            $z <= 0                                    ; le-ge
            $z > 0 ∧ $z <= 0
            ⊥                                          ; gt-le-contra
            $z ∈ Nat
        $z ∈ Nat
qed


;; the rules as theorems of Mathlib (see numbers.kurt and natural.kurt): `Int` by its axiom `k_mem_Int`
lean "int-nat" intro x hx; obtain ⟨n, rfl⟩ := (k_mem_Nat x).mp hx; exact (k_mem_Int _).mpr ⟨n, by simp⟩
lean "int-neg-nat" intro x hx; obtain ⟨n, rfl⟩ := (k_mem_Nat x).mp hx; exact (k_mem_Int _).mpr ⟨-n, by simp⟩
lean "int-cases" intro z hz
lean "int-cases" obtain ⟨m, rfl⟩ := (k_mem_Int z).mp hz
lean "int-cases" obtain ⟨n, rfl | rfl⟩ := Int.eq_nat_or_neg m
lean "int-cases" all_goals first | (left; refine (k_mem_Nat _).mpr ⟨n, ?_⟩; simp; done) | (right; refine (k_mem_Nat _).mpr ⟨n, ?_⟩; simp; done)
lean "int-add" intro a b h; obtain ⟨⟨m, rfl⟩, ⟨n, rfl⟩⟩ := And.intro ((k_mem_Int _).mp h.1) ((k_mem_Int _).mp h.2); exact (k_mem_Int _).mpr ⟨_, Int.cast_add _ _⟩
lean "int-sub" intro a b h; obtain ⟨⟨m, rfl⟩, ⟨n, rfl⟩⟩ := And.intro ((k_mem_Int _).mp h.1) ((k_mem_Int _).mp h.2); exact (k_mem_Int _).mpr ⟨_, Int.cast_sub _ _⟩
lean "int-mul" intro a b h; obtain ⟨⟨m, rfl⟩, ⟨n, rfl⟩⟩ := And.intro ((k_mem_Int _).mp h.1) ((k_mem_Int _).mp h.2); exact (k_mem_Int _).mpr ⟨_, Int.cast_mul _ _⟩

;; the theorems Kurt proves above, as theorems of Mathlib too (see natural.kurt)
lean "int-zero" exact (k_mem_Int _).mpr ⟨0, by simp⟩
lean "int-one" exact (k_mem_Int _).mpr ⟨1, by simp⟩
lean "int-neg" intro z hz; obtain ⟨m, rfl⟩ := (k_mem_Int z).mp hz; exact (k_mem_Int _).mpr ⟨-m, by simp⟩
lean "int-pos-nat" intros; casesm* _ ∧ _
lean "int-pos-nat" obtain ⟨m, rfl⟩ := (k_mem_Int _).mp ‹k_emb _ ∈ Int›; beta_reduce at *
lean "int-pos-nat" have : 0 < m := by exact_mod_cast (‹_› : (0 : ℝ) < m)
lean "int-pos-nat" exact (k_mem_Nat _).mpr ⟨m.toNat, by beta_reduce; exact_mod_cast Int.toNat_of_nonneg this.le⟩
