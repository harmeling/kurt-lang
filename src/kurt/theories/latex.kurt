; latex.kurt
; mappings to latex
;
; not a proof theory -- a lookup table (symbol -> LaTeX macro) consulted by `-l`/`format
; latex` (see kurt.py's `expr_latex`/`latexify`). Has no effect on parsing or proving.
;
; coverage: propositional-logic keywords and symbols only (assume/case/let/pick/show/proof/
; qed/use/with, implies/and/or/not/forall/exists/true/false/iff). Missing: everything from
; arith.kurt/set.kurt/modal.kurt/natural.kurt (+, ∈, ⊂, □, Nat, ...) and several newer
; keywords (local, expect, sandbox). A symbol/keyword with no entry here just prints its own
; name unchanged in LaTeX output -- not wrong, just plain rather than a proper macro.

; keywords
latex "assume" "\text{Assume that }"
latex "case"   "\text{Case }"
latex "let"    "\text{Let }"
latex "pick"   "\text{Pick }"
latex "show"   "\text{To show: }"
latex "proof"  "\textbf{proof}"
latex "qed"    "\textbf{qed}"
latex "with"   "\text{ with }"
latex "use"    "\text{use }"

; symbols
latex implies "\Rightarrow"
latex "⇒"       "\Rightarrow"
latex "∧"       "\land"
latex "∨"       "\lor"
latex "not"     "\lnot"
latex "¬"       "\lnot"
latex "∀"       "\forall"
latex "∃"       "\exists"
latex "true"    "\text{true}"
latex "⊤"       "\top"
latex "false"   "\text{false}"
latex "⊥"       "\bot"
latex "equiv"   "\Leftrightarrow"
latex "≡"       "\equiv"