; rational numbers
;
; covers: `Rat`, the fractions m / n of an integer m and a natural number n ≠ 0, closed under
; `+`, `-`, `*` and `/` (by a number ≠ 0); and every positive rational in lowest terms
; ("lowest-terms", proven from the well-ordering of natural.kurt). As for natural.kurt, they are
; numbers of numbers.kurt, so its laws (and `calc`) apply.
load propositional, equality, logic, set, numbers, natural, integer
default real              ; every symbol of this file is a number, except where said otherwise:
set Rat                  ; the rationals are a set (of numbers)
const Rat
builtin Rat rationals                  ; `calc on` proves `1 / 3 ∈ Rat`
tex Rat \mathbb{Q}
; `kurt --lean` with Mathlib: the objects are Mathlib's reals (numbers.kurt), `Rat` the rationals
; among them (as `Nat` in natural.kurt)
lean Rat member $1 ∈ Set.range (fun q : ℚ => (q : ℝ))
alias ℚ Rat
use Rat ⊂ Real  "rat-sub-real"      ; a set of numbers (natural.kurt's "ext-real")
lean "rat-sub-real" simp only [subset]; intro z hz; obtain ⟨x, rfl, _⟩ := k_numset_elem _ z hz; exact (k_mem_Real _).mpr rfl

; A defining axiom, not `def`: `Rat` is an existing calculator-bound carrier, and this
; characterizes membership in it rather than introducing one fresh predicate abbreviation.
use $q ∈ Rat  ⇔  ∃ $m ∃ $n ($m ∈ Int ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $q = $m / $n)     "rat-def"
use $a ∈ Rat ∧ $b ∈ Rat  ⇒  $a + $b ∈ Rat                          "rat-add"
use $a ∈ Rat ∧ $b ∈ Rat  ⇒  $a - $b ∈ Rat                          "rat-sub"
use $a ∈ Rat ∧ $b ∈ Rat  ⇒  $a * $b ∈ Rat                          "rat-mul"
use $a ∈ Rat ∧ $b ∈ Rat ∧ $b ≠ 0  ⇒  $a / $b ∈ Rat                 "rat-div"

show $z ∈ Int  ⇒  $z ∈ Rat     "rat-int"
proof
    assume $z ∈ Int
        1 ∈ Nat
        calc on
        1 ≠ 0
        calc off
        $z = $z / 1                                    ; div-identity
        $z ∈ Int ∧ 1 ∈ Nat ∧ 1 ≠ 0 ∧ $z = $z / 1
        ∃ $n ($z ∈ Int ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $z = $z / $n)
        ∃ $m ∃ $n ($m ∈ Int ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $z = $m / $n)
        $z ∈ Rat
qed

; a positive rational is a fraction of natural numbers
show $q ∈ Rat ∧ $q > 0  ⇒  ∃ $m ∃ $n ($m ∈ Nat ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $q = $m / $n)     "rat-pos"
proof
    assume $q ∈ Rat ∧ $q > 0
        $q ∈ Rat
        $q > 0
        ∃ $m ∃ $n ($m ∈ Int ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $q = $m / $n)
        pick m with ∃ $n (m ∈ Int ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $q = m / $n)
            pick n with m ∈ Int ∧ n ∈ Nat ∧ n ≠ 0 ∧ $q = m / n
                m ∈ Int
                n ∈ Nat
                n ≠ 0
                $q = m / n
                0 < n                                  ; nat-pos
                n > 0                                  ; lt-gt
                ; m = q n > 0
                (m / n) * n = m                        ; div-mul
                $q * n = (m / n) * n
                       = m
                $q * n > 0                             ; mul-pos
                m > 0
                m ∈ Nat                                ; int-pos-nat
                m ∈ Nat ∧ n ∈ Nat ∧ n ≠ 0 ∧ $q = m / n
                ∃ $j (m ∈ Nat ∧ $j ∈ Nat ∧ $j ≠ 0 ∧ $q = m / $j)
                ∃ $i ∃ $j ($i ∈ Nat ∧ $j ∈ Nat ∧ $j ≠ 0 ∧ $q = $i / $j)
qed

; cancelling a common factor
show $d ≠ 0 ∧ $b ≠ 0  ⇒  ($d * $a) / ($d * $b) = $a / $b     "frac-cancel"
proof
    assume $d ≠ 0 ∧ $b ≠ 0
        $d ≠ 0
        $b ≠ 0
        ($d / $d) * ($a / $b) = ($d * $a) / ($d * $b)    ; div-mul-div
        $d / $d = 1                                    ; div-self
        1 * ($a / $b) = $a / $b                        ; mul-identity
        ($d * $a) / ($d * $b) = ($d / $d) * ($a / $b)
                              = 1 * ($a / $b)
                              = $a / $b
qed

; lowest terms: a positive rational is m / n with coprime natural numbers m, n -- take the least
; denominator n (well-ordering); a common divisor d ≥ 2 of m and n would give the smaller
; denominator n / d
show $q ∈ Rat ∧ $q > 0  ⇒  ∃ $m ∃ $n ($m ∈ Nat ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ coprime($m, $n) ∧ $q = $m / $n)     "lowest-terms"
proof
    assume $q ∈ Rat ∧ $q > 0
        ∃ $m ∃ $n ($m ∈ Nat ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $q = $m / $n)     ; rat-pos
        ; the denominators -- a subset of `Nat`: for every element, not only the numbers among
        ; them, so `c` is any set (`set c`; the `default real` would make it a number)
        set c
        let c
            assume c ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) }
                c ∈ Nat                                     ; separation-in
        { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) } ⊂ Nat
        pick m with ∃ $n (m ∈ Nat ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $q = m / $n)
            pick n with m ∈ Nat ∧ n ∈ Nat ∧ n ≠ 0 ∧ $q = m / n
                m ∈ Nat
                n ∈ Nat
                n ≠ 0
                $q = m / n
                m ∈ Nat ∧ $q = m / n
                ∃ $i ($i ∈ Nat ∧ $q = $i / n)
                n ∈ Nat ∧ n ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / n)
                n ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) }     ; separation
                ∃ $x ($x ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) })
        ∃ $x ($x ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) })
        { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) } ⊂ Nat ∧ ∃ $x ($x ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) })
        ; the least one
        ∃ $l ($l ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) } ∧ ∀ $y ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) } ($l <= $y))   ; well-ordering
        pick n with n ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) } ∧ ∀ $y ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) } (n <= $y)
            n ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) }
            ∀ $y ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) } (n <= $y)
            n ∈ Nat ∧ n ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / n)     ; separation
            n ∈ Nat
            n ≠ 0
            ∃ $i ($i ∈ Nat ∧ $q = $i / n)
            pick m with m ∈ Nat ∧ $q = m / n
                m ∈ Nat
                $q = m / n
                ; m and n are coprime
                let d ∈ Nat
                    assume d ∣ m ∧ d ∣ n
                        d ∣ m
                        d ∣ n
                        ∃ $k ($k ∈ Nat ∧ m = d * $k)
                        ∃ $k ($k ∈ Nat ∧ n = d * $k)
                        pick a with a ∈ Nat ∧ m = d * a
                            a ∈ Nat
                            m = d * a
                            pick b with b ∈ Nat ∧ n = d * b
                                b ∈ Nat
                                n = d * b
                                ; d ≠ 0 and b ≠ 0, since n ≠ 0
                                assume d = 0
                                    n = 0 * b
                                    n = 0                      ; mul-zero
                                    ¬(n = 0)
                                    n = 0 ∧ ¬(n = 0)
                                    ⊥
                                ¬(d = 0)
                                d ≠ 0
                                assume b = 0
                                    n = d * 0
                                    n = 0                      ; mul-zero
                                    ¬(n = 0)
                                    n = 0 ∧ ¬(n = 0)
                                    ⊥
                                ¬(b = 0)
                                b ≠ 0
                                ; so q = a / b, and b is a denominator too
                                (d * a) / (d * b) = a / b      ; frac-cancel
                                $q = m / n
                                   = (d * a) / n
                                   = (d * a) / (d * b)
                                   = a / b
                                a ∈ Nat ∧ $q = a / b
                                ∃ $i ($i ∈ Nat ∧ $q = $i / b)
                                b ∈ Nat ∧ b ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / b)
                                b ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) }     ; separation
                                n <= b
                                ; d = 1, since d ≥ 2 would make b < d b = n
                                assume ¬(d = 1)
                                    d ≠ 1
                                    2 <= d                     ; nat-ge-two
                                    b < d * b                  ; nat-lt-mul
                                    b < n
                                    b >= n                     ; le-ge
                                    b < n ∧ b >= n
                                    ⊥                          ; lt-ge-contra
                                ¬¬(d = 1)
                                d = 1
                ∀ $d ∈ Nat ($d ∣ m ∧ $d ∣ n  ⇒  $d = 1)
                coprime(m, n)
                m ∈ Nat ∧ n ∈ Nat ∧ n ≠ 0 ∧ coprime(m, n) ∧ $q = m / n
                ∃ $j (m ∈ Nat ∧ $j ∈ Nat ∧ $j ≠ 0 ∧ coprime(m, $j) ∧ $q = m / $j)
                ∃ $i ∃ $j ($i ∈ Nat ∧ $j ∈ Nat ∧ $j ≠ 0 ∧ coprime($i, $j) ∧ $q = $i / $j)
qed

;; the rules as theorems of Mathlib (see numbers.kurt and natural.kurt): `Rat` by its axiom `k_mem_Rat`
lean "rat-def" intro q; rw [k_mem_Rat]; constructor
lean "rat-def" · rintro ⟨r, rfl⟩
lean "rat-def"   refine ⟨r.num, r.den, ?_⟩
lean "rat-def"   refine ⟨?_, ?_, ?_, ?_⟩ <;> first | exact (k_mem_Int _).mpr ⟨r.num, rfl⟩ | exact (k_mem_Nat _).mpr ⟨r.den, rfl⟩ | exact Rat.cast_def r | (simp [r.den_nz]; done)
lean "rat-def" · rintro ⟨m, n, h⟩
lean "rat-def"   casesm* _ ∧ _
lean "rat-def"   obtain ⟨i, rfl⟩ := (k_mem_Int m).mp ‹_›
lean "rat-def"   obtain ⟨j, rfl⟩ := (k_mem_Nat n).mp ‹_›
lean "rat-def"   subst_vars
lean "rat-def"   exact ⟨(i : ℚ) / (j : ℚ), by push_cast; ring⟩
lean "rat-add" intro a b h; obtain ⟨⟨p, rfl⟩, ⟨q, rfl⟩⟩ := And.intro ((k_mem_Rat _).mp h.1) ((k_mem_Rat _).mp h.2); exact (k_mem_Rat _).mpr ⟨_, Rat.cast_add _ _⟩
lean "rat-sub" intro a b h; obtain ⟨⟨p, rfl⟩, ⟨q, rfl⟩⟩ := And.intro ((k_mem_Rat _).mp h.1) ((k_mem_Rat _).mp h.2); exact (k_mem_Rat _).mpr ⟨_, Rat.cast_sub _ _⟩
lean "rat-mul" intro a b h; obtain ⟨⟨p, rfl⟩, ⟨q, rfl⟩⟩ := And.intro ((k_mem_Rat _).mp h.1) ((k_mem_Rat _).mp h.2); exact (k_mem_Rat _).mpr ⟨_, Rat.cast_mul _ _⟩
lean "rat-div" intro a b h; casesm* _ ∧ _
lean "rat-div" obtain ⟨p, rfl⟩ := (k_mem_Rat a).mp ‹_›
lean "rat-div" obtain ⟨q, rfl⟩ := (k_mem_Rat b).mp ‹_›
lean "rat-div" exact (k_mem_Rat _).mpr ⟨_, Rat.cast_div _ _⟩

;; the theorems Kurt proves above, as theorems of Mathlib too (see natural.kurt), "lowest-terms" too
;; (`coprime` and `∣` unfolded; `Rat.reduced`: a rational's numerator and denominator are coprime)
lean "rat-int" intro z hz; obtain ⟨m, rfl⟩ := (k_mem_Int z).mp hz; exact (k_mem_Rat _).mpr ⟨m, by simp⟩
lean "rat-pos" intros; casesm* _ ∧ _
lean "rat-pos" obtain ⟨r, rfl⟩ := (k_mem_Rat _).mp ‹k_emb _ ∈ Rat›; beta_reduce at *
lean "rat-pos" have hr : 0 < r := by exact_mod_cast (‹_› : (0 : ℝ) < r)
lean "rat-pos" have hnum : 0 ≤ r.num := (Rat.num_pos.mpr hr).le
lean "rat-pos" refine ⟨(r.num.toNat : ℝ), (r.den : ℝ), ?_⟩
lean "rat-pos" refine ⟨?_, ?_, ?_, ?_⟩
lean "rat-pos" all_goals first
lean "rat-pos"   | exact (k_mem_Nat _).mpr ⟨_, rfl⟩
lean "rat-pos"   | (simp [r.den_nz]; done)
lean "rat-pos"   | (rw [show ((r.num.toNat : ℕ) : ℝ) = ((r.num.toNat : ℤ) : ℝ) from (Int.cast_natCast _).symm, Int.toNat_of_nonneg hnum]; exact Rat.cast_def r)
lean "frac-cancel" intros; casesm* _ ∧ _
lean "frac-cancel" field_simp
lean "lowest-terms" intro q h; casesm* _ ∧ _
lean "lowest-terms" obtain ⟨r, rfl⟩ := (k_mem_Rat q).mp (by assumption)
lean "lowest-terms" have hr : 0 < r := by exact_mod_cast (by assumption : (0 : ℝ) < r)
lean "lowest-terms" have key : ∃ a b : ℕ, b ≠ 0 ∧ Nat.Coprime a b ∧ (r : ℝ) = (a : ℝ) / (b : ℝ) := by
lean "lowest-terms"   have h0 : 0 ≤ r.num := (Rat.num_pos.mpr hr).le
lean "lowest-terms"   refine ⟨r.num.toNat, r.den, r.den_nz, ?_, ?_⟩
lean "lowest-terms"   · have e : r.num.toNat = r.num.natAbs := by omega
lean "lowest-terms"     rw [e]; exact r.reduced
lean "lowest-terms"   · have hnum : ((r.num.toNat : ℕ) : ℤ) = r.num := Int.toNat_of_nonneg h0
lean "lowest-terms"     rw [Rat.cast_def r]; congr 1; exact_mod_cast hnum.symm
lean "lowest-terms" obtain ⟨a, b, hb, hab, he⟩ := key
lean "lowest-terms" refine ⟨(a : ℝ), (b : ℝ), ?_⟩
lean "lowest-terms" refine ⟨?_, ?_, ?_, ?_, ?_⟩
lean "lowest-terms" all_goals first
lean "lowest-terms"   | exact he
lean "lowest-terms"   | exact (k_mem_Nat _).mpr ⟨a, rfl⟩
lean "lowest-terms"   | exact (k_mem_Nat _).mpr ⟨b, rfl⟩
lean "lowest-terms"   | exact_mod_cast hb
lean "lowest-terms"   | (simp only [coprime]
lean "lowest-terms"      intro d hd hdiv
lean "lowest-terms"      obtain ⟨e, rfl⟩ := (k_mem_Nat d).mp hd
lean "lowest-terms"      have dvd : ∀ c : ℕ, divides (e : ℝ) (c : ℝ) → e ∣ c := by
lean "lowest-terms"        intro c hc; simp only [divides] at hc; obtain ⟨s, hs⟩ := hc; casesm* _ ∧ _
lean "lowest-terms"        obtain ⟨s', rfl⟩ := (k_mem_Nat s).mp (by assumption)
lean "lowest-terms"        exact ⟨s', by exact_mod_cast (by linarith : (c : ℝ) = e * s')⟩
lean "lowest-terms"      have hda := dvd a (by first | exact hdiv.1 | exact hdiv.2)
lean "lowest-terms"      have hdb := dvd b (by first | exact hdiv.1 | exact hdiv.2)
lean "lowest-terms"      have := Nat.dvd_gcd hda hdb
lean "lowest-terms"      rw [Nat.Coprime.gcd_eq_one hab] at this
lean "lowest-terms"      simp [Nat.dvd_one.mp this])
