; rational numbers
;
; covers: `Rat`, the fractions m / n of an integer m and a natural number n ≠ 0, closed under
; `+`, `-`, `*` and `/` (by a number ≠ 0); and every positive rational in lowest terms
; ("lowest-terms", proven from the well-ordering of natural.kurt). As for natural.kurt, they are
; numbers of numbers.kurt, so its laws (and `calc`) apply.
load integer
const Rat
calc Rat rationals                  ; `calc on` proves `1 / 3 ∈ Rat`

use $q ∈ Rat  ⇔  ∃ $m ∃ $n ($m ∈ Int ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $q = $m / $n)     "rat-def"
use $a ∈ Rat ∧ $b ∈ Rat  ⇒  $a + $b ∈ Rat                          "rat-add"
use $a ∈ Rat ∧ $b ∈ Rat  ⇒  $a - $b ∈ Rat                          "rat-sub"
use $a ∈ Rat ∧ $b ∈ Rat  ⇒  $a * $b ∈ Rat                          "rat-mul"
use $a ∈ Rat ∧ $b ∈ Rat ∧ $b ≠ 0  ⇒  $a / $b ∈ Rat                 "rat-div"

show $z ∈ Int  ⇒  $z ∈ Rat     "rat-int"
proof
    assume $z ∈ Int
        1 ∈ Nat
        calc on
        1 ≠ 0
        calc off
        $z = $z / 1                                    ; div-identity
        $z ∈ Int ∧ 1 ∈ Nat ∧ 1 ≠ 0 ∧ $z = $z / 1
        ∃ $n ($z ∈ Int ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $z = $z / $n)
        ∃ $m ∃ $n ($m ∈ Int ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $z = $m / $n)
        $z ∈ Rat
qed

; a positive rational is a fraction of natural numbers
show $q ∈ Rat ∧ $q > 0  ⇒  ∃ $m ∃ $n ($m ∈ Nat ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $q = $m / $n)     "rat-pos"
proof
    assume $q ∈ Rat ∧ $q > 0
        $q ∈ Rat
        $q > 0
        ∃ $m ∃ $n ($m ∈ Int ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $q = $m / $n)
        pick m with ∃ $n (m ∈ Int ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $q = m / $n)
            pick n with m ∈ Int ∧ n ∈ Nat ∧ n ≠ 0 ∧ $q = m / n
                m ∈ Int
                n ∈ Nat
                n ≠ 0
                $q = m / n
                0 < n                                  ; nat-pos
                n > 0                                  ; lt-gt
                ; m = q n > 0
                (m / n) * n = m                        ; div-mul
                $q * n = (m / n) * n
                       = m
                $q * n > 0                             ; mul-pos
                m > 0
                m ∈ Nat                                ; int-pos-nat
                m ∈ Nat ∧ n ∈ Nat ∧ n ≠ 0 ∧ $q = m / n
                ∃ $j (m ∈ Nat ∧ $j ∈ Nat ∧ $j ≠ 0 ∧ $q = m / $j)
                ∃ $i ∃ $j ($i ∈ Nat ∧ $j ∈ Nat ∧ $j ≠ 0 ∧ $q = $i / $j)
qed

; cancelling a common factor
show $d ≠ 0 ∧ $b ≠ 0  ⇒  ($d * $a) / ($d * $b) = $a / $b     "frac-cancel"
proof
    assume $d ≠ 0 ∧ $b ≠ 0
        $d ≠ 0
        $b ≠ 0
        ($d / $d) * ($a / $b) = ($d * $a) / ($d * $b)    ; div-mul-div
        $d / $d = 1                                    ; div-self
        1 * ($a / $b) = $a / $b                        ; mul-identity
        ($d * $a) / ($d * $b) = ($d / $d) * ($a / $b)
                              = 1 * ($a / $b)
                              = $a / $b
qed

; lowest terms: a positive rational is m / n with coprime natural numbers m, n -- take the least
; denominator n (well-ordering); a common divisor d ≥ 2 of m and n would give the smaller
; denominator n / d
show $q ∈ Rat ∧ $q > 0  ⇒  ∃ $m ∃ $n ($m ∈ Nat ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ coprime($m, $n) ∧ $q = $m / $n)     "lowest-terms"
proof
    assume $q ∈ Rat ∧ $q > 0
        ∃ $m ∃ $n ($m ∈ Nat ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $q = $m / $n)     ; rat-pos
        ; the denominators
        let c
            assume c ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) }
                c ∈ Nat ∧ c ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / c)    ; separation
                c ∈ Nat
        ∀ $c ($c ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) }  implies  $c ∈ Nat)
        { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) } ⊂ Nat
        pick m with ∃ $n (m ∈ Nat ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $q = m / $n)
            pick n with m ∈ Nat ∧ n ∈ Nat ∧ n ≠ 0 ∧ $q = m / n
                m ∈ Nat
                n ∈ Nat
                n ≠ 0
                $q = m / n
                m ∈ Nat ∧ $q = m / n
                ∃ $i ($i ∈ Nat ∧ $q = $i / n)
                n ∈ Nat ∧ n ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / n)
                n ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) }     ; separation
                ∃ $x ($x ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) })
        ∃ $x ($x ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) })
        { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) } ⊂ Nat ∧ ∃ $x ($x ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) })
        ; the least one
        ∃ $l ($l ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) } ∧ ∀ $y ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) } ($l <= $y))   ; well-ordering
        pick n with n ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) } ∧ ∀ $y ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) } (n <= $y)
            n ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) }
            ∀ $y ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) } (n <= $y)
            n ∈ Nat ∧ n ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / n)     ; separation
            n ∈ Nat
            n ≠ 0
            ∃ $i ($i ∈ Nat ∧ $q = $i / n)
            pick m with m ∈ Nat ∧ $q = m / n
                m ∈ Nat
                $q = m / n
                ; m and n are coprime
                let d ∈ Nat
                    assume d ∣ m ∧ d ∣ n
                        d ∣ m
                        d ∣ n
                        ∃ $k ($k ∈ Nat ∧ m = d * $k)
                        ∃ $k ($k ∈ Nat ∧ n = d * $k)
                        pick a with a ∈ Nat ∧ m = d * a
                            a ∈ Nat
                            m = d * a
                            pick b with b ∈ Nat ∧ n = d * b
                                b ∈ Nat
                                n = d * b
                                ; d ≠ 0 and b ≠ 0, since n ≠ 0
                                assume d = 0
                                    n = 0 * b
                                    n = 0                      ; mul-zero
                                    ¬(n = 0)
                                    n = 0 ∧ ¬(n = 0)
                                    ⊥
                                ¬(d = 0)
                                d ≠ 0
                                assume b = 0
                                    n = d * 0
                                    n = 0                      ; mul-zero
                                    ¬(n = 0)
                                    n = 0 ∧ ¬(n = 0)
                                    ⊥
                                ¬(b = 0)
                                b ≠ 0
                                ; so q = a / b, and b is a denominator too
                                (d * a) / (d * b) = a / b      ; frac-cancel
                                $q = m / n
                                   = (d * a) / n
                                   = (d * a) / (d * b)
                                   = a / b
                                a ∈ Nat ∧ $q = a / b
                                ∃ $i ($i ∈ Nat ∧ $q = $i / b)
                                b ∈ Nat ∧ b ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / b)
                                b ∈ { $j ∈ Nat | $j ≠ 0 ∧ ∃ $i ($i ∈ Nat ∧ $q = $i / $j) }     ; separation
                                n <= b
                                ; d = 1, since d ≥ 2 would make b < d b = n
                                assume ¬(d = 1)
                                    d ≠ 1
                                    2 <= d                     ; nat-ge-two
                                    b < d * b                  ; nat-lt-mul
                                    b < n
                                    b >= n                     ; le-ge
                                    b < n ∧ b >= n
                                    ⊥                          ; lt-ge-contra
                                ¬¬(d = 1)
                                d = 1
                ∀ $d ∈ Nat ($d ∣ m ∧ $d ∣ n  ⇒  $d = 1)
                coprime(m, n)
                m ∈ Nat ∧ n ∈ Nat ∧ n ≠ 0 ∧ coprime(m, n) ∧ $q = m / n
                ∃ $j (m ∈ Nat ∧ $j ∈ Nat ∧ $j ≠ 0 ∧ coprime(m, $j) ∧ $q = m / $j)
                ∃ $i ∃ $j ($i ∈ Nat ∧ $j ∈ Nat ∧ $j ≠ 0 ∧ coprime($i, $j) ∧ $q = $i / $j)
qed
