; propositional logic
;
; covers: not, or, invimplies (backwards implication), iff, and the standard elimination/
; introduction rules connecting them and the hardcoded connectives (and-intro/elim, or-intro/
; elim, iff-intro, iff-elim-forward/backward, not-intro/elim, bottom-intro/elim, top-elim).
; `true`/`implies`/`and` themselves are hardcoded directly in kurt.py (see minimal.kurt for
; exactly what) -- this file adds `false`, `not`, `or`, `invimplies`, `iff`, and the rules
; relating them.
;
; loaded (directly or transitively) by nearly every other theory here -- logic.kurt,
; equality.kurt, set.kurt, and number.kurt all `load propositional` first.

;; builtin syntax
; infix  implies 13 12  ; logical implies, right associative (since 13>12)
; prop   implies 0 1 2  ; and and its inputs have type prop
; infix  and     16 16  ; logical and
; prop   and     0 1 2  ; and and its inputs have type prop
; flat   and            ; (a and b) and c  iff  a and b and c
; sym    and            ; a and b  iff  b and a
; prop   true           ; true has type prop
alias  ⊤ true
alias  ⇒ implies
alias  ∧ and

;; syntax
prefix not        18     ; logical not
infix  or      14 14     ; logical or
infix  invimplies 13 12  ; logical implies backwards, right associative (since 13>12)
infix  iff     10 10     ; logical if-and-only-if
prop   not     0 1       ; `not` and its inputs have type prop
prop   or      0 1 2     ; `or` and its inputs have type prop
prop   invimplies 0 1 2  ; `invimplies` and its inputs have type prop
prop   iff     0 1 2     ; `and` and its inputs have type prop
prop   false             ; false has type prop
; the meaning the engine gives these symbols (and nothing has it by its name alone): an `iff`
; fact is used as two implications, `case` splits an `or`, an `assume` block whose last line is
; `false` also gives `not` of its assumption, and `def` may define with `iff`
builtin iff equivalence, or disjunction, not negation, false falsum

flat   or
sym    or
sym    iff

chain  iff implies       ; implies left-to-right
chain  iff invimplies    ; implies right-to-left

alias  ¬ not
alias  ∨ or
alias  ⊥ false
alias  contradiction false
alias  ⇔ iff
alias  ⇐ invimplies
alias  ≡ iff

;; inference rules
;
; all rules have the form (with finitely many premises)
;
;     premise1   premise2
;     -------------------
;     conclusion
;
; which we write in kurt as:
; 
;     premise1 and premise2 implies conclusion
;
; (the commented out axioms are implemented in `kurt.py`

;; builtin
; use %A implies %A                 "restatement" ; special case of "impl-elim"
; use (%A implies %B) implies (%A implies %B)                       "impl-intro"
; use ((%A implies %B) and %A) implies %B                           "impl-elim"
; use true                                                          "top-intro"

use %A  and  %B   implies   %A and %B                               "and-intro"
use %A  and  %B   implies   %A                                      "and-elim"   ; `and` is symmetric and flat
; notes
; "and-intro" looks somewhat weird:  however, it will be used from the python code
; such that the formulas of the LHS conjunction will be searched for in the theory

use %A   implies   %A or %B                                         "or-intro"   ; `or` is symmetric and flat
use (%A or %B) and (%A implies %C) and (%B implies %C) implies %C   "or-elim"

; `case` supports any finite number of alternatives. The binary rule above supplies the logical
; meaning. The engine recognizes a stored flat disjunction plus one implication to the same goal
; for every alternative, and the kernel checks both the rule and that exact list. It does not
; synthesize an n-premise schema, so matching does not grow through a Cartesian product of facts.
;
; Keep the previously published 3/4-branch theorems as named compatibility lemmas. Their proofs
; now also exercise the general case-elimination certificate.
show (%A or %B or %C) and (%A implies %D) and (%B implies %D) and (%C implies %D) implies %D   "or-elim-3"
proof
    assume (%A or %B or %C) and (%A implies %D) and (%B implies %D) and (%C implies %D)
        %A or %B or %C
        %A implies %D
        %B implies %D
        %C implies %D
        %D
qed
show (%A or %B or %C or %E) and (%A implies %D) and (%B implies %D) and (%C implies %D) and (%E implies %D) implies %D   "or-elim-4"
proof
    assume (%A or %B or %C or %E) and (%A implies %D) and (%B implies %D) and (%C implies %D) and (%E implies %D)
        %A or %B or %C or %E
        %A implies %D
        %B implies %D
        %C implies %D
        %E implies %D
        %D
qed

; A defining axiom, not `def`: `invimplies` already participates in the `chain` declarations
; above, so it is no longer a fresh symbol without meaning when this equivalence is stated.
use (%A invimplies %B) iff (%B implies %A)                         "invimplies-def"

use (%A implies %B) and (%B implies %A) implies (%A iff %B)         "iff-intro"
use (%A iff %B) implies (%A implies %B)                             "iff-elim-forward"
use (%A iff %B) implies (%B implies %A)                             "iff-elim-backward"
use %A iff %A                                                       "iff-reflexive"
use (sub %x %a %A) and (%a iff %b)  implies  (sub %x %b %A)         "iff-subst"

use (true implies %A) implies %A                                    "top-elim"

; a formula equivalent to `true` holds, and a formula that holds is equivalent to `true` (e.g.
; after a chain of equivalences that ends in `⊤`)
show (%A iff true) implies %A                                       "iff-true-elim"
proof
    assume %A iff true
        true implies %A
        %A
qed
show %A implies (%A iff true)                                       "iff-true-intro"
proof
    assume %A
        assume %A
            true
        assume true
            %A
        %A iff true
qed

use %A and not %A implies false                                     "bottom-intro"
use false implies %A                                                "bottom-elim"

use (%A implies false) implies not %A                               "not-intro"
use not not %A implies %A                                           "not-elim"
use %A implies not not %A                                           "not-not-intro"
use %A iff not not %A                                               "not-not"

; the excluded middle, proven (not an axiom): from "not-elim"
show %A or not %A                                                   "excluded-middle"
proof
    assume not (%A or not %A)
        assume %A
            %A or not %A
            false
        not %A
        %A or not %A
        false
    not not (%A or not %A)
    %A or not %A
qed

;; `kurt --lean`: `invimplies` is Lean's `→` backwards (what "invimplies-def" says)
lean invimplies ($2 → $1)

;; the rules as theorems of Lean's logic (`kurt --lean`, doc/kurt-ref.md): each fact's proof in
;; Lean, `lean "label" TACTIC` -- the export writes the rule as a `theorem` with it, which Lean
;; checks (never trusted by Kurt). `grind` (Lean's own, classical) proves each of them; Kurt's
;; theorems above too, for the export of a proof that cites one
lean "and-intro" grind
lean "and-elim" grind
lean "or-intro" grind
lean "or-elim" grind
lean "or-elim-3" grind
lean "or-elim-4" grind
lean "invimplies-def" grind
lean "iff-intro" grind
lean "iff-elim-forward" grind
lean "iff-elim-backward" grind
lean "iff-reflexive" grind
lean "iff-subst" grind
lean "top-elim" grind
lean "iff-true-elim" grind
lean "iff-true-intro" grind
lean "bottom-intro" grind
lean "bottom-elim" grind
lean "not-intro" grind
lean "not-elim" grind
lean "not-not-intro" grind
lean "not-not" grind
lean "excluded-middle" grind
