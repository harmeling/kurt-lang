; derivatives
;
; covers: for continuity `cont x a T`, differentiability `diff x a T` and the derivative
; `deriv x a T` (d/dx T at x = a) -- declared and defined by ε and δ in continuity.kurt, which this
; file loads -- the rules of differentiation (constant, `x`, sum, difference, constant factor,
; product, quotient, powers, chain rule), each with the differentiability it needs; Fermat's
; theorem (a local maximum or minimum where the derivative exists) and the mean value theorem.
; See proofs/analysis/ for worked examples.
;
; Every function is defined for all numbers (Kurt's numbers are total: `1 / 0` is some number),
; so `diff x 0 (1 / x)` can't be shown -- its difference quotient is unbounded.
;
; `deriv` is a function that gives a value for *every* argument -- also where the derivative
; doesn't exist (`deriv x 0 abs(x)` is some number). So a rule says what `deriv` is only where
; `diff` holds: `deriv x 0 abs(x) = deriv x 0 abs(x)`, but not `diff x 0 abs(x)`, and the sum
; rule needs both summands differentiable (`abs(x) + -abs(x)` is differentiable at 0, its
; summands aren't).
;
; In a rule, `$T` in `deriv $v $a $T` is any function of `$v`: it may depend on `$v`, since it is
; the whole body of a binder over `$v` and occurs only inside binders over `$v` or `sub`s for it
; (doc/kurt-ref.md §4). A constant must not depend on `$v`: `$c` also occurs outside of the
; binders (the premise `$c = $c` of "deriv-const", the factor of "deriv-scale").
;
; These rules are theorems of real analysis, stated as axioms (their proofs need the
; completeness of the real numbers, which number.kurt doesn't have) -- each needs the conditions
; of the theorem. (The definitions "cont-def", "diff-def", "deriv-intro" are continuity.kurt's.)
; For Lean they are proved, from Mathlib's calculus: `kurt --lean` writes them as theorems with the
; proofs at the end of this file (`lean "label" ...`).
load propositional, equality, logic, set, number, natural, analysis
load continuity             ; `cont`, `diff`, `deriv` and their definitions (by ε and δ)
default real              ; every symbol of this file is a number, except where said otherwise


;; differentiable functions are continuous
use (diff $v $a $T)  ⇒  cont $v $a $T                                    "diff-cont"

;; the rules of differentiation
use $c = $c  ⇒  diff $v $a $c                                           "diff-const"     ; (`$c` doesn't depend on `$v`)
use $c = $c  ⇒  (deriv $v $a $c) = 0                                    "deriv-const"
use diff $v $a $v                                                       "diff-id"
use (deriv $v $a $v) = 1                                                "deriv-id"
use (diff $v $a $S) ∧ (diff $v $a $T)  ⇒  diff $v $a ($S + $T)          "diff-add"
use (diff $v $a $S) ∧ (diff $v $a $T)  ⇒  (deriv $v $a ($S + $T)) = (deriv $v $a $S) + (deriv $v $a $T)   "deriv-add"
use (diff $v $a $S) ∧ (diff $v $a $T)  ⇒  diff $v $a ($S - $T)          "diff-sub"
use (diff $v $a $S) ∧ (diff $v $a $T)  ⇒  (deriv $v $a ($S - $T)) = (deriv $v $a $S) - (deriv $v $a $T)   "deriv-sub"
use (diff $v $a $T)  ⇒  diff $v $a ($c * $T)                            "diff-scale"     ; (`$c` doesn't depend on `$v`)
use (diff $v $a $T)  ⇒  (deriv $v $a ($c * $T)) = $c * (deriv $v $a $T)   "deriv-scale"
use (diff $v $a $S) ∧ (diff $v $a $T)  ⇒  diff $v $a ($S * $T)          "diff-mul"
use (diff $v $a $S) ∧ (diff $v $a $T)  ⇒  (deriv $v $a ($S * $T)) = (deriv $v $a $S) * (sub $v $a $T) + (sub $v $a $S) * (deriv $v $a $T)   "deriv-mul"
use (diff $v $a $S) ∧ (diff $v $a $T) ∧ (sub $v $a $T) ≠ 0  ⇒  diff $v $a ($S / $T)   "diff-div"
use (diff $v $a $S) ∧ (diff $v $a $T) ∧ (sub $v $a $T) ≠ 0  ⇒  (deriv $v $a ($S / $T)) = ((deriv $v $a $S) * (sub $v $a $T) - (sub $v $a $S) * (deriv $v $a $T)) / (sub $v $a $T) ^ 2   "deriv-div"
; (for `$n = 0`: `$v ^ 0` is undefined at 0 -- number.kurt leaves `0 ^ 0` open -- so not these rules)
use ($n ∈ Nat ∧ 0 < $n)  ⇒  diff $v $a ($v ^ $n)                          "diff-pow"
use ($n ∈ Nat ∧ 0 < $n)  ⇒  (deriv $v $a ($v ^ $n)) = $n * $a ^ ($n - 1)  "deriv-pow"
; the chain rule: `$T` is the outer function (of `$w`), `$S` the inner one (of `$v`)
use (diff $v $a $S) ∧ (diff $w (sub $v $a $S) $T)  ⇒  diff $v $a (sub $w $S $T)   "diff-chain"
use (diff $v $a $S) ∧ (diff $w (sub $v $a $S) $T)  ⇒  (deriv $v $a (sub $w $S $T)) = (deriv $w (sub $v $a $S) $T) * (deriv $v $a $S)   "deriv-chain"

;; Fermat: at a local maximum (minimum) where the derivative exists, it is 0
use (diff $v $a $T) ∧ (∃ $d > 0 ∀ $y (abs($y - $a) < $d  ⇒  (sub $v $y $T) <= (sub $v $a $T)))  ⇒  (deriv $v $a $T) = 0   "deriv-max"
use (diff $v $a $T) ∧ (∃ $d > 0 ∀ $y (abs($y - $a) < $d  ⇒  (sub $v $y $T) >= (sub $v $a $T)))  ⇒  (deriv $v $a $T) = 0   "deriv-min"

;; the mean value theorem: continuous on [a, b], differentiable inside: the slope of the secant
;; is the derivative somewhere inside
use ($a < $b) ∧ (∀ $y (($a <= $y ∧ $y <= $b)  ⇒  cont $v $y $T)) ∧ (∀ $y (($a < $y ∧ $y < $b)  ⇒  diff $v $y $T))  ⇒  ∃ $c ($a < $c ∧ $c < $b ∧ (deriv $v $c $T) * ($b - $a) = (sub $v $b $T) - (sub $v $a $T))   "mean-value"

;; the rules as theorems of Mathlib (see number.kurt): `lean "label" TACTIC` is a proof in Lean
lean "diff-cont" intros; exact DifferentiableAt.continuousAt ‹_›
lean "diff-const" intros; exact differentiableAt_const _
lean "deriv-const" intros; exact deriv_const _ _
lean "diff-id" intros; exact differentiableAt_id
lean "deriv-id" intros; exact deriv_id _
lean "diff-add" intros; casesm* _ ∧ _; exact DifferentiableAt.add ‹_› ‹_›
lean "deriv-add" intros; casesm* _ ∧ _; exact deriv_add ‹_› ‹_›
lean "diff-sub" intros; casesm* _ ∧ _; exact DifferentiableAt.sub ‹_› ‹_›
lean "deriv-sub" intros; casesm* _ ∧ _; exact deriv_sub ‹_› ‹_›
lean "diff-scale" intros; exact DifferentiableAt.mul_const ‹_› _
lean "deriv-scale" intros; rw [deriv_mul_const ‹_›]; ring
lean "diff-mul" intros; casesm* _ ∧ _; exact DifferentiableAt.mul ‹_› ‹_›
lean "deriv-mul" intros; casesm* _ ∧ _; beta_reduce at *
lean "deriv-mul" refine (deriv_fun_mul ?_ ?_).trans ?_
lean "deriv-mul" · assumption
lean "deriv-mul" · assumption
lean "deriv-mul" · ring
lean "diff-div" intros; casesm* _ ∧ _; exact DifferentiableAt.div ‹_› ‹_› ‹_›
lean "deriv-div" intros; casesm* _ ∧ _; beta_reduce at *
lean "deriv-div" refine (deriv_fun_div ?_ ?_ ?_).trans ?_
lean "deriv-div" · assumption
lean "deriv-div" · assumption
lean "deriv-div" · assumption
lean "deriv-div" · rw [Real.rpow_two]; ring
lean "diff-pow" intros; casesm* _ ∧ _
lean "diff-pow" obtain ⟨m, rfl⟩ := (k_mem_Nat _).mp ‹k_emb _ ∈ Nat›
lean "diff-pow" simp only [Real.rpow_natCast]
lean "diff-pow" fun_prop
lean "deriv-pow" intros; exact Real.deriv_rpow_const _ _
lean "diff-chain" intros; casesm* _ ∧ _; beta_reduce at *
lean "diff-chain" exact DifferentiableAt.comp _ ‹_› ‹_›
lean "deriv-chain" intros; casesm* _ ∧ _; beta_reduce at *
lean "deriv-chain" refine (deriv_comp _ ?_ ?_).trans (mul_comm _ _)
lean "deriv-chain" · assumption
lean "deriv-chain" · assumption
lean "deriv-max" intros; casesm* _ ∧ _; beta_reduce at *
lean "deriv-max" apply IsLocalMax.deriv_eq_zero
lean "deriv-max" obtain ⟨d, hd, H⟩ := ‹∃ d, _›
lean "deriv-max" exact Filter.eventually_of_mem (Metric.ball_mem_nhds _ hd) (fun y hy => H y (by rwa [Metric.mem_ball, Real.dist_eq] at hy))
lean "deriv-min" intros; casesm* _ ∧ _; beta_reduce at *
lean "deriv-min" apply IsLocalMin.deriv_eq_zero
lean "deriv-min" obtain ⟨d, hd, H⟩ := ‹∃ d, _›
lean "deriv-min" exact Filter.eventually_of_mem (Metric.ball_mem_nhds _ hd) (fun y hy => H y (by rwa [Metric.mem_ball, Real.dist_eq] at hy))
lean "mean-value" have key : ∀ (f : ℝ → ℝ) (a b : ℝ), a < b → (∀ y, (a ≤ y ∧ y ≤ b) → ContinuousAt f y) → (∀ y, (a < y ∧ y < b) → DifferentiableAt ℝ f y) → ∃ c, a < c ∧ c < b ∧ (b - a) * deriv f c = f b - f a := by
lean "mean-value"   intro f a b hab hc hd
lean "mean-value"   obtain ⟨c, ⟨h1, h2⟩, hc'⟩ := exists_deriv_eq_slope f hab (fun y hy => (hc y hy).continuousWithinAt) (fun y hy => (hd y hy).differentiableWithinAt)
lean "mean-value"   refine ⟨c, h1, h2, ?_⟩
lean "mean-value"   rw [hc']; field_simp [sub_ne_zero.mpr hab.ne']
lean "mean-value" intros; casesm* _ ∧ _; beta_reduce at *
lean "mean-value" obtain ⟨c, h1, h2, h3⟩ := key _ _ _ ‹_› ‹∀ y, _ ≤ y ∧ y ≤ _ → _› ‹∀ y, _ < y ∧ y < _ → _›
lean "mean-value" exact ⟨c, by first | exact ⟨h1, h2, h3⟩ | (simp only [and_comm, and_left_comm, and_assoc]; exact ⟨h1, h2, h3⟩) | tauto⟩
