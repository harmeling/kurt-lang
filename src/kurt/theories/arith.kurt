; arithmetic
load equality

;; syntax
infix   +  60 60           ; binary plus
infix   -  60 60           ; binary minus
infix   *  70 70           ; binary times
infix   /  70 70           ; binary divide
infix   ^  75 75           ; power
prefix  -     80           ; unary minus
postfix !  82              ; factorial
infix   <  20 20           ; less than
infix   >  20 20           ; greater than
infix   <= 20 20           ; less than or equal
infix   >= 20 20           ; greater than or equal

flat +, *
sym  +, *
bool <  0, >  0, <= 0, >= 0
chain   = <= <
chain   = >= >
alias   ≤ <=
alias   ≥ >=

;; rules
use $a = $b  ⇒  $a + $c = $b + $c
use $a = $b  ⇒  $a - $c = $b - $c
use $a = $b  ⇒  $a * $c = $b * $c
use $a = $b  ⇒  $a / $c = $b / $c
use ($a + $b) * $c = $a * $c + $b * $c
use ($a - $b) * $c = $a * $c - $b * $c 

use $a + (-$a) = 0       ; inverse element
use $a - $a = 0          ; inverse element
use $a * 1 = $a          ; neutral element
use $a / 1 = $a          ; neutral element
use $a * (-1) = -$a      ; inverse element
use -(-$a) = $a          ; double negation
use $a * 0 = 0           ; absorbing element
use $a ≠ 0 ⇒ 0 / $a = 0  ; absorbing element
use $a ≠ 0 ⇒ $a / $a = 1 ; neutral element
use $a + 0 = $a          ; neutral element
use $a - 0 = $a          ; neutral element

; use $a ^ $b * $a ^ $c = $a ^ ($b + $c)  ; laws of exponents
; use ($a ^ $b) ^ $c = $a ^ ($b * $c)     ; laws of exponents
; use $a ^ 0 = 1                          ; laws of exponents
; use $a ^ 1 = $a                         ; laws of exponents

;; order rules: <
use $a < $b  ⇒  $a + $c < $b + $c
use $a < $b  ⇒  $a - $c < $b - $c
use $c > 0 ∧ $a < $b  ⇒  $a * $c < $b * $c
use $c > 0 ∧ $a < $b  ⇒  $a / $c < $b / $c
use $c < 0 ∧ $a < $b  ⇒  $a * $c > $b * $c
use $c < 0 ∧ $a < $b  ⇒  $a / $c > $b / $c

;; order rules: <=
use $a <= $b  ⇒  $a + $c <= $b + $c
use $a <= $b  ⇒  $a - $c <= $b - $c
use $c > 0 ∧ $a <= $b  ⇒  $a * $c <= $b * $c
use $c > 0 ∧ $a <= $b  ⇒  $a / $c <= $b / $c
use $c < 0 ∧ $a <= $b  ⇒  $a * $c >= $b * $c
use $c < 0 ∧ $a <= $b  ⇒  $a / $c >= $b / $c

;; order rules: >
use $a > $b  ⇒  $a + $c > $b + $c
use $a > $b  ⇒  $a - $c > $b - $c
use $c > 0 ∧ $a > $b  ⇒  $a * $c > $b * $c
use $c > 0 ∧ $a > $b  ⇒  $a / $c > $b / $c
use $c < 0 ∧ $a > $b  ⇒  $a * $c < $b * $c
use $c < 0 ∧ $a > $b  ⇒  $a / $c < $b / $c

;; order rules: >=
use $a >= $b  ⇒  $a + $c >= $b + $c
use $a >= $b  ⇒  $a - $c >= $b - $c
use $c > 0 ∧ $a >= $b  ⇒  $a * $c >= $b * $c
use $c > 0 ∧ $a >= $b  ⇒  $a / $c >= $b / $c
use $c < 0 ∧ $a >= $b  ⇒  $a * $c <= $b * $c
use $c < 0 ∧ $a >= $b  ⇒  $a / $c <= $b / $c

;; order rules: mixed
use $a < $b  ⇒  ¬($a >= $b)
use $a > $b  ⇒  ¬($a <= $b)
use $a <= $b  ⇒  ¬($a > $b)
use $a >= $b  ⇒  ¬($a < $b) 

;; transitivity
use $a < $b ∧ $b < $c  ⇒  $a < $c
use $a > $b ∧ $b > $c  ⇒  $a > $c
use $a <= $b ∧ $b <= $c  ⇒  $a <= $c
use $a >= $b ∧ $b >= $c  ⇒  $a >= $c
use $a < $b ∧ $b <= $c  ⇒  $a < $c
use $a > $b ∧ $b >= $c  ⇒  $a > $c
use $a <= $b ∧ $b < $c  ⇒  $a < $c
use $a >= $b ∧ $b > $c  ⇒  $a > $c

;; anti-symmetry
use $a <= $b ∧ $a >= $b  ⇒  $a = $b
use $a <  $b ∧ $a >  $b  ⇒  false
use $a <  $b ∧ $a >= $b  ⇒  false
use $a >  $b ∧ $a <= $b  ⇒  false

;; trichotomy
use $a < $b ∨ $a = $b ∨ $a > $b

; for automatic testing we add the following line:
;;; Proof checked.