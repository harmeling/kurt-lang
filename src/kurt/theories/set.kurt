; set theory
;
; covers: separation (`{$z ∈ $A | P($z)}`, the subset of `$A` of the elements with property P),
; extensionality, empty set, intersection, union, subset, power set, ordered pairs and tuples
; (`(a, b)`, `fst`, `snd`), Cartesian products (`A × B`), and mappings (`:`/`→`,
; `f : A → B` for "f is a function from A to B", as sets of pairs, with function extensionality) -- see
; proofs/mafi1/001-two-equal-sets.kurt for a real distributive-law proof and
; proofs/set-theory/ for more.
;
; This follows Zermelo-Fraenkel set theory, in a small version: there is no unrestricted
; comprehension `{$z | P($z)}`, which would allow Russell's paradox (`{x | x ∉ x}`), but only
; separation, which forms subsets of a given set. The sets that can't be formed that way --
; the empty set, unions, power sets, function spaces -- are given by their own axioms.
;
; mappings are modelled as opaque, applicable set objects (kurt's ordinary space-application,
; `$f $a`), not as ZF-style sets of ordered pairs -- see the comment further down, right above
; "function-space", for why.
load equality, logic

; syntax
infix    in 25 25        ; element
infix    |  10 10        ; separator for set comprehension
bindop   |               ; `{ $z ∈ $A | P $z }` binds `$z`, like `∀ $z ∈ $A ...`
infix    ⊂  18 18        ; subset
infix    ∪  30 30        ; union
infix    ∩  40 40        ; intersection
bool     in 0
bool     ⊂ 0
alias    ∈ in            ; `∈` inherits all properties of `in`
brackets { }             ; curly brackets
; `A → B` is the *set* of all mappings from A to B; `f : A → B` reads as `f ∈ (A → B)` --
; "f is a member of the set of A→B mappings" -- exactly like `∈` is already just an alias of
; `in`
infix    → 30 30         ; for mappings
alias    : in
; `calc on` decides `3 ∈ Nat` for a set that is bound to the calculator (natural.kurt's `calc Nat naturals`)
calc     in element
infix    × 45 45         ; Cartesian product

; we assume that all objects are sets

; extensionality: two sets are equal iff they have the same elements
use $a = $b  ≡  ∀ $c  ($c ∈ $a ⇔ $c ∈ $b)                      "extensionality"

; separation: the elements of `$A` with the property `%F` -- `$z` is bound by `|`, so `%F` is the
; property of *every* occurrence of `$z` (it used to be an ordinary variable, and a `sub` could
; take just some of its occurrences: `{ y ∈ Nat | y = y }` then gave `(0 + 1) = y`)
use $a ∈ { $z ∈ $A | %F }  ≡  $a ∈ $A ∧ sub $z $a %F               "separation"

; subset
def $a ⊂ $b ≡ ∀ $c  ($c ∈ $a implies $c ∈ $b)                    "subset"
use $M = $N  ≡  $M ⊂ $N  ∧  $N ⊂ $M                              "eq-def"

; the empty set, unions and power sets exist
const ∅
use not ($a ∈ ∅)                                                 "empty-set"
use $c ∈ $a ∪ $b  ≡  $c ∈ $a ∨ $c ∈ $b                           "union"
use $b ∈ Pow($a)  ≡  $b ⊂ $a                                     "power-set"

; intersection, by separation
def $a ∩ $b = { $c ∈ $a | $c ∈ $b }                              "intersection"
show $x ∈ $A ∩ $B  ≡  $x ∈ $A ∧ $x ∈ $B                         "in-intersection"
proof
    $x ∈ { $c ∈ $A | $c ∈ $B }  ≡  $x ∈ $A ∧ $x ∈ $B
    $A ∩ $B = { $c ∈ $A | $c ∈ $B }
    $x ∈ $A ∩ $B  ≡  $x ∈ $A ∧ $x ∈ $B
qed

; ordered pairs and tuples: `(a, b)`. The comma is right-associative, so the triple `(a, b, c)`
; is the pair `(a, (b, c))` -- as in set theory, where n-tuples are built from pairs. So the
; rules for pairs are also those for tuples: two triples are equal if their first components are,
; and the pairs of their other components.
use ($a, $b) = ($c, $d)  ≡  $a = $c ∧ $b = $d                      "pair-eq"
const fst, snd
arity fst 1
arity snd 1
use fst($a, $b) = $a                                              "fst"
use snd($a, $b) = $b                                              "snd"

; the Cartesian product: the pairs with components in `$A` and `$B`
use ($a, $b) ∈ $A × $B  ≡  $a ∈ $A ∧ $b ∈ $B                      "product"
use $p ∈ $A × $B  implies  $p = (fst $p, snd $p)                  "product-pairs"

; mappings, as in ZF set theory: a mapping f from A to B is a set of pairs, f ⊂ A × B, with
; exactly one pair (a, b) for each a ∈ A -- and `f a` is that b. So the mapping is its graph, and
; two mappings from A that agree on A are equal ("function-extensionality", from the
; extensionality of sets); only ∅ is a mapping from ∅. (Application `f a` is kurt's ordinary
; space-application, also written `f(a)`.)
use $f ∈ ($A → $B)  ≡  $f ⊂ $A × $B ∧ (∀ $a ∈ $A ∃ $b (($a, $b) ∈ $f)) ∧ ∀ $a ∀ $b ∀ $c (($a, $b) ∈ $f ∧ ($a, $c) ∈ $f  implies  $b = $c)   "function-space"
use $f ∈ ($A → $B) ∧ ($a, $b) ∈ $f  implies  $f $a = $b              "apply"

; the pair of a and f a is in f, and f a ∈ B
show $f ∈ ($A → $B) ∧ $a ∈ $A  implies  ($a, $f $a) ∈ $f ∧ $f $a ∈ $B     "apply-in"
proof
    assume $f ∈ ($A → $B) ∧ $a ∈ $A
        $f ∈ ($A → $B)
        $a ∈ $A
        $f ⊂ $A × $B ∧ (∀ $x ∈ $A ∃ $y (($x, $y) ∈ $f)) ∧ ∀ $x ∀ $y ∀ $z (($x, $y) ∈ $f ∧ ($x, $z) ∈ $f  implies  $y = $z)
        $f ⊂ $A × $B
        ∀ $x ∈ $A ∃ $y (($x, $y) ∈ $f)
        ∃ $y (($a, $y) ∈ $f)
        pick b with ($a, b) ∈ $f
            $f $a = b                                  ; apply
            ($a, $f $a) ∈ $f
            ∀ $c ($c ∈ $f  implies  $c ∈ $A × $B)
            ($a, b) ∈ $f  implies  ($a, b) ∈ $A × $B
            ($a, b) ∈ $A × $B
            $a ∈ $A ∧ b ∈ $B                           ; product
            b ∈ $B
            $f $a ∈ $B
            ($a, $f $a) ∈ $f ∧ $f $a ∈ $B
qed

; two mappings from A to B that agree on A are equal
show $f ∈ ($A → $B) ∧ $g ∈ ($A → $B) ∧ (∀ $a ∈ $A ($f $a = $g $a))  implies  $f = $g     "function-extensionality"
proof
    assume $f ∈ ($A → $B) ∧ $g ∈ ($A → $B) ∧ (∀ $a ∈ $A ($f $a = $g $a))
        $f ∈ ($A → $B)
        $g ∈ ($A → $B)
        ∀ $a ∈ $A ($f $a = $g $a)
        $f ⊂ $A × $B ∧ (∀ $x ∈ $A ∃ $y (($x, $y) ∈ $f)) ∧ ∀ $x ∀ $y ∀ $z (($x, $y) ∈ $f ∧ ($x, $z) ∈ $f  implies  $y = $z)
        $g ⊂ $A × $B ∧ (∀ $x ∈ $A ∃ $y (($x, $y) ∈ $g)) ∧ ∀ $x ∀ $y ∀ $z (($x, $y) ∈ $g ∧ ($x, $z) ∈ $g  implies  $y = $z)
        $f ⊂ $A × $B
        $g ⊂ $A × $B
        ∀ $c ($c ∈ $f  implies  $c ∈ $A × $B)
        ∀ $c ($c ∈ $g  implies  $c ∈ $A × $B)
        ; f ⊂ g: a pair (a, b) of f is (a, f a) = (a, g a), which is in g
        let c
            assume c ∈ $f
                c ∈ $A × $B
                c = (fst c, snd c)                     ; product-pairs
                (fst c, snd c) ∈ $f
                (fst c, snd c) ∈ $A × $B
                fst c ∈ $A ∧ snd c ∈ $B                ; product
                fst c ∈ $A
                $f (fst c) = snd c                     ; apply
                $f (fst c) = $g (fst c)
                (fst c, $g (fst c)) ∈ $g ∧ $g (fst c) ∈ $B      ; apply-in
                (fst c, $g (fst c)) ∈ $g
                snd c = $g (fst c)
                (fst c, snd c) ∈ $g
                c ∈ $g
        ∀ $c ($c ∈ $f  implies  $c ∈ $g)
        $f ⊂ $g
        ; g ⊂ f, the same way
        let c
            assume c ∈ $g
                c ∈ $A × $B
                c = (fst c, snd c)                     ; product-pairs
                (fst c, snd c) ∈ $g
                (fst c, snd c) ∈ $A × $B
                fst c ∈ $A ∧ snd c ∈ $B                ; product
                fst c ∈ $A
                $g (fst c) = snd c                     ; apply
                $f (fst c) = $g (fst c)
                (fst c, $f (fst c)) ∈ $f ∧ $f (fst c) ∈ $B      ; apply-in
                (fst c, $f (fst c)) ∈ $f
                snd c = $f (fst c)
                (fst c, snd c) ∈ $f
                c ∈ $f
        ∀ $c ($c ∈ $g  implies  $c ∈ $f)
        $g ⊂ $f
        $f ⊂ $g ∧ $g ⊂ $f
        $f = $g                                        ; eq-def
qed
