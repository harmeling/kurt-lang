; analysis
;
; covers: the absolute value `abs`, finite sums `sum i (a, b) T` (= T(a) + ... + T(b)), the
; maximum/minimum and the supremum/infimum of the values of `T` for the `v` with a condition
; (`max v ∈ A T`, `sup v > 0 T`, ...), and limits `lim v a T` of `T` for `v` going to `a`,
; also with a condition on `v` (`lim v > 0 0 T` is the limit from the right) -- defined by ε
; and δ. See proofs/analysis/ for worked examples; derivatives and integrals are in
; derivative.kurt and integral.kurt.
;
; the binders of `max`, `sup`, `lim`, ... take any condition: in a rule, the condition
; `sub $x $v %C` stands for any condition on the bound variable `$v` (see logic.kurt). The
; summand `$T` may depend on the bound variable, since the rules only use it with something
; substituted for it (`sub $v $a $T`).
;
; `max`, `sup`, `lim`, ... are functions that give a value for *every* argument -- also where
; the maximum, the supremum or the limit doesn't exist. So there are only rules that
; introduce them, from a proof that the maximum (supremum, limit) exists: a rule like
; `(lim $v $a $T) = $L ⇔ ...` would be wrong, since `lim v 0 (1 / v) = lim v 0 (1 / v)` would
; then say that this limit exists.
load propositional, equality, logic, set, number, natural
default real              ; every symbol of this file is a number, except where said otherwise
; `kurt --lean` with Mathlib: the objects are Mathlib's reals (number.kurt)

;; subtraction and halving, for ε/2 arguments: "sub-def" links `-` to `+`, and the laws after it
;; follow from it (proofs/arithmetic/helpers/subtraction.kurt, checked by
;; tests/test_subtraction_laws.py) -- stated here, since their proofs (+ is flat and symmetric)
;; would make this file slow to check, and not in number.kurt, since every rule for rewriting makes
;; the search a little slower
use $a - $b = $a + (-$b)                         "sub-def"
use ($a - $b) + $b = $a                          "sub-add-cancel"
use ($a - $b) + ($b - $c) = $a - $c              "sub-split"
use ($a + $b) - ($c + $d) = ($a - $c) + ($b - $d)    "sub-add"
use $c * $a - $c * $b = $c * ($a - $b)           "sub-mul"
use $a - $b = 0  ⇒  $a = $b                      "sub-zero"
use 2 * $a = $a + $a                             "double"
use $a / 2 + $a / 2 = $a                         "halves"
use $c >= 0 ∧ $a <= $b  ⇒  $a * $c <= $b * $c    "le-mul-nonneg"

;; absolute value
const abs
arity abs 1
tex abs \left|$1\right|
lean abs |$1|
use $a >= 0  ⇒  abs($a) = $a                "abs-nonneg"
use $a < 0  ⇒  abs($a) = -$a                "abs-neg"
use abs($a) >= 0                            "abs-ge-zero"
use abs($a) = 0  ⇔  $a = 0                  "abs-zero"
use abs($a * $b) = abs($a) * abs($b)        "abs-mul"
use abs($a - $b) = abs($b - $a)             "abs-sub-sym"
use abs($a + $b) <= abs($a) + abs($b)       "abs-triangle"

;; finite sums: `sum i (a, b) T` is T(a) + T(a+1) + ... + T(b); the empty sum, for `a > b`, is 0
const sum
arity sum _ (_, _) _      ; the variable, the range `(a, b)`, the body
binder sum 65
tex sum \sum_{$1=$2}^{$3} $4
; in Lean: `$1`, `$2` the range, `$3` the body (a function) -- for `a <= b` the sum of `T(b), T(b - 1), ...,
; T(b - k)` for the `k + 1 = ⌊b - a⌋ + 1` terms that are at least `a`, and `0` for `a > b`
lean sum (if $1 ≤ $2 then ∑ n_ ∈ Finset.range (⌊$2 - $1⌋₊ + 1), $3 ($2 - (n_ : ℝ)) else 0)
use (sum $i ($a, $a) $T) = sub $i $a $T                                                     "sum-one"
use $a <= $b + 1  ⇒  (sum $i ($a, $b + 1) $T) = (sub $i ($b + 1) $T) + (sum $i ($a, $b) $T)   "sum-last"
use $a > $b  ⇒  (sum $i ($a, $b) $T) = 0                                                    "sum-empty"

;; maximum and minimum: a value of `T` that is attained, and that no other value exceeds
const max, min
arity max 2
arity min 2
binder max 65, min 65
tex max \max_{$1} $2
tex min \min_{$1} $2
; in Lean with a condition: `$1` the condition, `$2` the body (both functions) -- the supremum of
; the values, which is the maximum where the maximum exists
lean max (sSup (Set.image $2 {x_ | $1 x_}))
lean min (sInf (Set.image $2 {x_ | $1 x_}))
use (sub $x $a %C) ∧ (∀ (sub $x $w %C) ((sub $v $w $T) <= (sub $v $a $T)))  ⇒  (max (sub $x $v %C) $T) = sub $v $a $T   "max-intro"
use (sub $x $a %C) ∧ (∀ (sub $x $w %C) ((sub $v $w $T) >= (sub $v $a $T)))  ⇒  (min (sub $x $v %C) $T) = sub $v $a $T   "min-intro"

;; argmax and argmin over a set: *some* element of `$A` where `T` is largest (smallest) -- there
;; can be several, so there is no rule `argmax ... = $a`; the rules say something only if such an
;; element `$a` exists (`argmax` is a choice of one of them). Only over a set `$v ∈ $A`: with any
;; condition (`sub $x $v %C`), the argmax term would be the value of another `sub`, inside it.
const argmax, argmin
arity argmax 2
arity argmin 2
binder argmax 65, argmin 65
tex argmax \operatorname{arg\,max}_{$1} $2
tex argmin \operatorname{arg\,min}_{$1} $2
; in Lean: a choice (Hilbert's ε) of an element where `T` is largest (smallest), if there is one
lean argmax (Classical.epsilon (fun a_ => $1 a_ ∧ ∀ w_, $1 w_ → $2 w_ ≤ $2 a_))
lean argmin (Classical.epsilon (fun a_ => $1 a_ ∧ ∀ w_, $1 w_ → $2 a_ ≤ $2 w_))
use ($a ∈ $A) ∧ (∀ ($w ∈ $A) ((sub $v $w $T) <= (sub $v $a $T)))  ⇒  (argmax $v ∈ $A $T) ∈ $A   "argmax-in"
use ($a ∈ $A) ∧ (∀ ($w ∈ $A) ((sub $v $w $T) <= (sub $v $a $T)))  ⇒  ∀ ($w ∈ $A) ((sub $v $w $T) <= (sub $v (argmax $v ∈ $A $T) $T))   "argmax-max"
use ($a ∈ $A) ∧ (∀ ($w ∈ $A) ((sub $v $w $T) >= (sub $v $a $T)))  ⇒  (argmin $v ∈ $A $T) ∈ $A   "argmin-in"
use ($a ∈ $A) ∧ (∀ ($w ∈ $A) ((sub $v $w $T) >= (sub $v $a $T)))  ⇒  ∀ ($w ∈ $A) ((sub $v $w $T) >= (sub $v (argmin $v ∈ $A $T) $T))   "argmin-min"

;; supremum and infimum: the least upper bound and the greatest lower bound of the values of
;; `T`, for a condition that holds for at least one `$a`, and values that are bounded by `$b`
const sup, inf
arity sup 2
arity inf 2
binder sup 65, inf 65
tex sup \sup_{$1} $2
tex inf \inf_{$1} $2
lean sup (sSup (Set.image $2 {x_ | $1 x_}))
lean inf (sInf (Set.image $2 {x_ | $1 x_}))
use (∀ (sub $x $w %C) ((sub $v $w $T) <= $b)) ∧ (sub $x $a %C)  ⇒  (sub $v $a $T) <= sup (sub $x $v %C) $T   "sup-upper"
use (∀ (sub $x $w %C) ((sub $v $w $T) <= $b)) ∧ (sub $x $a %C)  ⇒  (sup (sub $x $v %C) $T) <= $b           "sup-least"
use (∀ (sub $x $w %C) ((sub $v $w $T) >= $b)) ∧ (sub $x $a %C)  ⇒  (sub $v $a $T) >= inf (sub $x $v %C) $T   "inf-lower"
use (∀ (sub $x $w %C) ((sub $v $w $T) >= $b)) ∧ (sub $x $a %C)  ⇒  (inf (sub $x $v %C) $T) >= $b           "inf-greatest"

;; limits: `lim v a T` is the limit of `T` for `v` going to `a` (`v ≠ a`); with a condition,
;; `lim v > 0 0 T`, only the `v` with the condition count -- then `a` must be a point that
;; these `v` come arbitrarily close to, otherwise every number would be a limit
const lim
arity lim 3
binder lim 65
tex lim \lim_{$1 \to $2} $3
; in Lean: Mathlib's limit along the punctured neighbourhoods of the point (with a condition: of
; the points with it) -- `$1` the point, `$2` the body; with a condition `$1` the condition
lean lim (Filter.limUnder (nhdsWithin $1 {$1}ᶜ) $2)
lean lim (Filter.limUnder (nhdsWithin $2 ({$2}ᶜ ∩ {x_ | $1 x_})) $3)
use (∀ $e > 0 ∃ $d > 0 ∀ $y ((0 < abs($y - $a) ∧ abs($y - $a) < $d)  ⇒  abs((sub $v $y $T) - $L) < $e))  ⇒  (lim $v $a $T) = $L   "lim-intro"
use (∀ $d > 0 ∃ $y ((sub $x $y %C) ∧ 0 < abs($y - $a) ∧ abs($y - $a) < $d)) ∧ (∀ $e > 0 ∃ $d > 0 ∀ $y (((sub $x $y %C) ∧ 0 < abs($y - $a) ∧ abs($y - $a) < $d)  ⇒  abs((sub $v $y $T) - $L) < $e))  ⇒  (lim (sub $x $v %C) $a $T) = $L   "lim-cond-intro"

;; "T tends to L for v going to a": `tends v a L T` -- the statement that the limit exists and is
;; `L` (by ε and δ), which `lim v a T = L` can't say, since `lim` has a value for every argument.
;; The limit laws are theorems of analysis, stated here as axioms (their proofs by ε and δ are
;; long); continuity.kurt says continuity with it ("cont-tends"). For Lean they are proved, from
;; Mathlib's limits (`lean "label" ...` at the end of this file).
const tends
arity tends 4
binder tends                    ; the variable, the point and the limit (outside), then the body
prop tends 0
tex tends $4 \underset{$1 \to $2}{\longrightarrow} $3
lean tends (Filter.Tendsto $3 (nhdsWithin $1 {$1}ᶜ) (nhds $2))
use (tends $v $a $L $T)  ⇔  ∀ $e > 0 ∃ $d > 0 ∀ $y ((0 < abs($y - $a) ∧ abs($y - $a) < $d)  ⇒  abs((sub $v $y $T) - $L) < $e)   "tends-def"
use (tends $v $a $L $T)  ⇒  (lim $v $a $T) = $L                                    "tends-lim"
use (tends $v $a $L $T) ∧ (tends $v $a $M $T)  ⇒  $L = $M                          "tends-unique"
use $c = $c  ⇒  tends $v $a $c $c                                                  "tends-const"    ; (`$c` doesn't depend on `$v`)
use tends $v $a $a $v                                                              "tends-id"
use (tends $v $a $L $S) ∧ (tends $v $a $M $T)  ⇒  tends $v $a ($L + $M) ($S + $T)   "tends-add"
use (tends $v $a $L $S) ∧ (tends $v $a $M $T)  ⇒  tends $v $a ($L - $M) ($S - $T)   "tends-sub"
use (tends $v $a $L $T)  ⇒  tends $v $a ($c * $L) ($c * $T)                         "tends-scale"    ; (`$c` doesn't depend on `$v`)
use (tends $v $a $L $S) ∧ (tends $v $a $M $T)  ⇒  tends $v $a ($L * $M) ($S * $T)   "tends-mul"
use (tends $v $a $L $S) ∧ (tends $v $a $M $T) ∧ $M ≠ 0  ⇒  tends $v $a ($L / $M) ($S / $T)   "tends-div"

;; the rules as theorems of Mathlib (see number.kurt)
lean "sub-def" intros; ring
lean "sub-add-cancel" intros; ring
lean "sub-split" intros; ring
lean "sub-add" intros; ring
lean "sub-mul" intros; ring
lean "sub-zero" intros; linarith
lean "double" intros; ring
lean "halves" intros; ring
lean "le-mul-nonneg" intros; casesm* _ ∧ _; nlinarith
lean "abs-nonneg" intros; simp_all [abs_of_nonneg]
lean "abs-neg" intros; simp_all [abs_of_neg]
lean "abs-ge-zero" intros; positivity
lean "abs-zero" intros; exact abs_eq_zero
lean "abs-mul" intros; exact abs_mul _ _
lean "abs-sub-sym" intros; exact abs_sub_comm _ _
lean "abs-triangle" intros; exact abs_add_le _ _
lean "sum-one" intro a T
lean "sum-one" beta_reduce
lean "sum-one" simp
lean "sum-empty" intro a b T h
lean "sum-empty" beta_reduce
lean "sum-empty" simp [not_le.mpr h]
lean "sum-last" intro a b T h
lean "sum-last" beta_reduce
lean "sum-last" simp only [h, ↓reduceIte]
lean "sum-last" by_cases hab : a ≤ b
lean "sum-last" · simp only [hab, ↓reduceIte]
lean "sum-last"   rw [show (1 + b) - a = (b - a) + 1 by ring, Nat.floor_add_one (by linarith), Finset.sum_range_succ']
lean "sum-last"   have e : ∀ i : ℕ, T (1 + b - ((i + 1 : ℕ) : ℝ)) = T (b - (i : ℝ)) := fun i => by congr 1; push_cast; ring
lean "sum-last"   simp only [e, Nat.cast_zero, sub_zero]
lean "sum-last"   ring_nf
lean "sum-last" · simp only [hab, ↓reduceIte]
lean "sum-last"   rw [Nat.floor_eq_zero.mpr (by linarith [not_le.mp hab])]
lean "sum-last"   simp
lean "max-intro" have key : ∀ (C : ℝ → Prop) (T : ℝ → ℝ) (a : ℝ), C a → (∀ w, C w → T w ≤ T a) → sSup (T '' {x_ | C x_}) = T a := by
lean "max-intro"   intro C T a ha hmax
lean "max-intro"   exact IsGreatest.csSup_eq ⟨⟨a, ha, rfl⟩, by rintro _ ⟨w, hw, rfl⟩; exact hmax w hw⟩
lean "max-intro" intros; beta_reduce at *; apply key <;> tauto
lean "min-intro" have key : ∀ (C : ℝ → Prop) (T : ℝ → ℝ) (a : ℝ), C a → (∀ w, C w → T a ≤ T w) → sInf (T '' {x_ | C x_}) = T a := by
lean "min-intro"   intro C T a ha hmin
lean "min-intro"   exact IsLeast.csInf_eq ⟨⟨a, ha, rfl⟩, by rintro _ ⟨w, hw, rfl⟩; exact hmin w hw⟩
lean "min-intro" intros; beta_reduce at *; apply key <;> tauto
lean "argmax-in" have key : ∀ (S : Obj) (T : ℝ → ℝ) (a : ℝ), (∀ w, k_emb w ∈ S → T w ≤ T a) ∧ k_emb a ∈ S → k_emb (Classical.epsilon (fun a_ => (fun x => k_emb x ∈ S) a_ ∧ ∀ w_, (fun x => k_emb x ∈ S) w_ → T w_ ≤ T a_)) ∈ S :=
lean "argmax-in"   fun S T a h => (Classical.epsilon_spec (p := fun a_ => (fun x => k_emb x ∈ S) a_ ∧ ∀ w_, (fun x => k_emb x ∈ S) w_ → T w_ ≤ T a_) ⟨a, h.2, h.1⟩).1
lean "argmax-in" intros; apply key <;> first | assumption | exact ⟨‹_›.2, ‹_›.1⟩
lean "argmax-max" have key : ∀ (S : Obj) (T : ℝ → ℝ) (a : ℝ), (∀ w, k_emb w ∈ S → T w ≤ T a) ∧ k_emb a ∈ S → ∀ w, k_emb w ∈ S → T w ≤ T (Classical.epsilon (fun a_ => (fun x => k_emb x ∈ S) a_ ∧ ∀ w_, (fun x => k_emb x ∈ S) w_ → T w_ ≤ T a_)) :=
lean "argmax-max"   fun S T a h => (Classical.epsilon_spec (p := fun a_ => (fun x => k_emb x ∈ S) a_ ∧ ∀ w_, (fun x => k_emb x ∈ S) w_ → T w_ ≤ T a_) ⟨a, h.2, h.1⟩).2
lean "argmax-max" intros; apply key <;> first | assumption | exact ⟨‹_›.2, ‹_›.1⟩
lean "argmin-in" have key : ∀ (S : Obj) (T : ℝ → ℝ) (a : ℝ), (∀ w, k_emb w ∈ S → T a ≤ T w) ∧ k_emb a ∈ S → k_emb (Classical.epsilon (fun a_ => (fun x => k_emb x ∈ S) a_ ∧ ∀ w_, (fun x => k_emb x ∈ S) w_ → T a_ ≤ T w_)) ∈ S :=
lean "argmin-in"   fun S T a h => (Classical.epsilon_spec (p := fun a_ => (fun x => k_emb x ∈ S) a_ ∧ ∀ w_, (fun x => k_emb x ∈ S) w_ → T a_ ≤ T w_) ⟨a, h.2, h.1⟩).1
lean "argmin-in" intros; apply key <;> first | assumption | exact ⟨‹_›.2, ‹_›.1⟩
lean "argmin-min" have key : ∀ (S : Obj) (T : ℝ → ℝ) (a : ℝ), (∀ w, k_emb w ∈ S → T a ≤ T w) ∧ k_emb a ∈ S → ∀ w, k_emb w ∈ S → T (Classical.epsilon (fun a_ => (fun x => k_emb x ∈ S) a_ ∧ ∀ w_, (fun x => k_emb x ∈ S) w_ → T a_ ≤ T w_)) ≤ T w :=
lean "argmin-min"   fun S T a h => (Classical.epsilon_spec (p := fun a_ => (fun x => k_emb x ∈ S) a_ ∧ ∀ w_, (fun x => k_emb x ∈ S) w_ → T a_ ≤ T w_) ⟨a, h.2, h.1⟩).2
lean "argmin-min" intros; apply key <;> first | assumption | exact ⟨‹_›.2, ‹_›.1⟩
lean "sup-upper" have key : ∀ (C : ℝ → Prop) (T : ℝ → ℝ) (a b : ℝ), C a → (∀ w, C w → T w ≤ b) → T a ≤ sSup (T '' {x_ | C x_}) := by
lean "sup-upper"   intro C T a b ha hb
lean "sup-upper"   exact le_csSup ⟨b, by rintro _ ⟨w, hw, rfl⟩; exact hb w hw⟩ ⟨a, ha, rfl⟩
lean "sup-upper" intros; beta_reduce at *; casesm* _ ∧ _; exact key _ _ _ _ ‹_› ‹_›
lean "sup-least" have key : ∀ (C : ℝ → Prop) (T : ℝ → ℝ) (a b : ℝ), C a → (∀ w, C w → T w ≤ b) → sSup (T '' {x_ | C x_}) ≤ b := by
lean "sup-least"   intro C T a b ha hb
lean "sup-least"   exact csSup_le ⟨T a, a, ha, rfl⟩ (by rintro _ ⟨w, hw, rfl⟩; exact hb w hw)
lean "sup-least" intros; beta_reduce at *; casesm* _ ∧ _; exact key _ _ _ _ ‹_› ‹_›
lean "inf-lower" have key : ∀ (C : ℝ → Prop) (T : ℝ → ℝ) (a b : ℝ), C a → (∀ w, C w → b ≤ T w) → sInf (T '' {x_ | C x_}) ≤ T a := by
lean "inf-lower"   intro C T a b ha hb
lean "inf-lower"   exact csInf_le ⟨b, by rintro _ ⟨w, hw, rfl⟩; exact hb w hw⟩ ⟨a, ha, rfl⟩
lean "inf-lower" intros; beta_reduce at *; casesm* _ ∧ _; exact key _ _ _ _ ‹_› ‹_›
lean "inf-greatest" have key : ∀ (C : ℝ → Prop) (T : ℝ → ℝ) (a b : ℝ), C a → (∀ w, C w → b ≤ T w) → b ≤ sInf (T '' {x_ | C x_}) := by
lean "inf-greatest"   intro C T a b ha hb
lean "inf-greatest"   exact le_csInf ⟨T a, a, ha, rfl⟩ (by rintro _ ⟨w, hw, rfl⟩; exact hb w hw)
lean "inf-greatest" intros; beta_reduce at *; casesm* _ ∧ _; exact key _ _ _ _ ‹_› ‹_›
lean "tends-def" have key : ∀ (f : ℝ → ℝ) (a L : ℝ), Filter.Tendsto f (nhdsWithin a {a}ᶜ) (nhds L) ↔ ∀ e, 0 < e → ∃ d, 0 < d ∧ ∀ y, (0 < |y - a| ∧ |y - a| < d) → |f y - L| < e := by
lean "tends-def"   intro f a L
lean "tends-def"   rw [Metric.tendsto_nhdsWithin_nhds]
lean "tends-def"   simp only [Real.dist_eq, Set.mem_compl_iff, Set.mem_singleton_iff, gt_iff_lt]
lean "tends-def"   constructor
lean "tends-def"   · intro h e he; obtain ⟨d, hd, H⟩ := h e he; exact ⟨d, hd, fun y hy => H (by intro h; simp [h] at hy) hy.2⟩
lean "tends-def"   · intro h e he; obtain ⟨d, hd, H⟩ := h e he; exact ⟨d, hd, fun y hy1 hy2 => H y ⟨abs_pos.mpr (sub_ne_zero.mpr hy1), hy2⟩⟩
lean "tends-def" intros; beta_reduce; first | exact key _ _ _ | (rw [key]; simp only [and_comm, and_left_comm, and_assoc])
lean "tends-lim" intros; exact Filter.Tendsto.limUnder_eq ‹_›
lean "tends-unique" intros; casesm* _ ∧ _; exact tendsto_nhds_unique ‹_› ‹_›
lean "tends-const" intros; exact tendsto_const_nhds
lean "tends-id" intros; exact tendsto_nhdsWithin_of_tendsto_nhds Filter.tendsto_id
lean "tends-add" intros; casesm* _ ∧ _; exact Filter.Tendsto.add ‹_› ‹_›
lean "tends-sub" intros; casesm* _ ∧ _; exact Filter.Tendsto.sub ‹_› ‹_›
lean "tends-scale" intros; exact Filter.Tendsto.mul_const _ ‹_›
lean "tends-mul" intros; casesm* _ ∧ _; exact Filter.Tendsto.mul ‹_› ‹_›
lean "tends-div" intros; casesm* _ ∧ _; exact Filter.Tendsto.div ‹_› ‹_› ‹_›
lean "lim-intro" have key : ∀ (f : ℝ → ℝ) (a L : ℝ), (∀ e, 0 < e → ∃ d, 0 < d ∧ ∀ y, (0 < |y - a| ∧ |y - a| < d) → |f y - L| < e) → Filter.limUnder (nhdsWithin a {a}ᶜ) f = L := by
lean "lim-intro"   intro f a L h
lean "lim-intro"   apply Filter.Tendsto.limUnder_eq
lean "lim-intro"   rw [Metric.tendsto_nhdsWithin_nhds]
lean "lim-intro"   intro e he; obtain ⟨d, hd, H⟩ := h e he
lean "lim-intro"   exact ⟨d, hd, fun y hy1 hy2 => H y ⟨abs_pos.mpr (sub_ne_zero.mpr hy1), by rwa [Real.dist_eq] at hy2⟩⟩
lean "lim-intro" intros; beta_reduce at *; apply key; first | assumption | ((try simp only [and_comm, and_left_comm, and_assoc] at *); assumption)
lean "lim-cond-intro" have key : ∀ (C : ℝ → Prop) (f : ℝ → ℝ) (a L : ℝ), (∀ d, 0 < d → ∃ y, C y ∧ 0 < |y - a| ∧ |y - a| < d) → (∀ e, 0 < e → ∃ d, 0 < d ∧ ∀ y, (C y ∧ 0 < |y - a| ∧ |y - a| < d) → |f y - L| < e) → Filter.limUnder (nhdsWithin a ({a}ᶜ ∩ {x_ | C x_})) f = L := by
lean "lim-cond-intro"   intro C f a L hacc h
lean "lim-cond-intro"   haveI : (nhdsWithin a ({a}ᶜ ∩ {x_ | C x_})).NeBot := by
lean "lim-cond-intro"     rw [← mem_closure_iff_nhdsWithin_neBot, Metric.mem_closure_iff]
lean "lim-cond-intro"     intro d hd; obtain ⟨y, hy, h1, h2⟩ := hacc d hd
lean "lim-cond-intro"     refine ⟨y, ⟨fun h => ?_, hy⟩, by rw [dist_comm, Real.dist_eq]; exact h2⟩
lean "lim-cond-intro"     rw [Set.mem_singleton_iff] at h; subst h; simp at h1
lean "lim-cond-intro"   apply Filter.Tendsto.limUnder_eq
lean "lim-cond-intro"   rw [Metric.tendsto_nhdsWithin_nhds]
lean "lim-cond-intro"   intro e he; obtain ⟨d, hd, H⟩ := h e he
lean "lim-cond-intro"   exact ⟨d, hd, fun y hy hyd => H y ⟨hy.2, abs_pos.mpr (sub_ne_zero.mpr hy.1), by rwa [Real.dist_eq] at hyd⟩⟩
lean "lim-cond-intro" intros; beta_reduce at *; casesm* _ ∧ _; apply key <;> first | assumption | ((try simp only [and_comm, and_left_comm, and_assoc] at *); assumption)
