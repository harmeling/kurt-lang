; analysis
;
; covers: the absolute value `abs`, finite sums `sum i (a, b) T` (= T(a) + ... + T(b)), the
; maximum/minimum and the supremum/infimum of the values of `T` for the `v` with a condition
; (`max v ∈ A T`, `sup v > 0 T`, ...), and limits `lim v a T` of `T` for `v` going to `a`,
; also with a condition on `v` (`lim v > 0 0 T` is the limit from the right) -- defined by ε
; and δ. See proofs/analysis/ for worked examples; derivatives and integrals are in
; derivative.kurt and integral.kurt.
;
; the binders of `max`, `sup`, `lim`, ... take any condition: in a rule, the condition
; `sub $x $v %C` stands for any condition on the bound variable `$v` (see logic.kurt). The
; summand `$T` may depend on the bound variable, since the rules only use it with something
; substituted for it (`sub $v $a $T`).
;
; `max`, `sup`, `lim`, ... are functions that give a value for *every* argument -- also where
; the maximum, the supremum or the limit doesn't exist. So there are only rules that
; introduce them, from a proof that the maximum (supremum, limit) exists: a rule like
; `(lim $v $a $T) = $L ⇔ ...` would be wrong, since `lim v 0 (1 / v) = lim v 0 (1 / v)` would
; then say that this limit exists.
load prop, equality, logic, set, numbers, natural

;; subtraction and halving, for ε/2 arguments: "sub-def" links `-` to `+`, and the laws after it
;; follow from it (proofs/arithmetic/helpers/subtraction.kurt, checked by
;; tests/test_subtraction_laws.py) -- stated here, since their proofs (+ is flat and symmetric)
;; would make this file slow to check, and not in numbers.kurt, since every rule for rewriting makes
;; the search a little slower
use $a - $b = $a + (-$b)                         "sub-def"
use ($a - $b) + $b = $a                          "sub-add-cancel"
use ($a - $b) + ($b - $c) = $a - $c              "sub-split"
use ($a + $b) - ($c + $d) = ($a - $c) + ($b - $d)    "sub-add"
use $c * $a - $c * $b = $c * ($a - $b)           "sub-mul"
use $a - $b = 0  ⇒  $a = $b                      "sub-zero"
use 2 * $a = $a + $a                             "double"
use $a / 2 + $a / 2 = $a                         "halves"
use $c >= 0 ∧ $a <= $b  ⇒  $a * $c <= $b * $c    "le-mul-nonneg"

;; absolute value
const abs
arity abs 1
tex abs \left|$1\right|
use $a >= 0  ⇒  abs($a) = $a                "abs-nonneg"
use $a < 0  ⇒  abs($a) = -$a                "abs-neg"
use abs($a) >= 0                            "abs-ge-zero"
use abs($a) = 0  ⇔  $a = 0                  "abs-zero"
use abs($a * $b) = abs($a) * abs($b)        "abs-mul"
use abs($a - $b) = abs($b - $a)             "abs-sub-sym"
use abs($a + $b) <= abs($a) + abs($b)       "abs-triangle"

;; finite sums: `sum i (a, b) T` is T(a) + T(a+1) + ... + T(b)
const sum
arity sum _ (_, _) _      ; the variable, the range `(a, b)`, the body
bindop sum
tex sum \sum_{$1=$2}^{$3} $4
use (sum $i ($a, $a) $T) = sub $i $a $T                                       "sum-one"
use (sum $i ($a, $b + 1) $T) = (sub $i ($b + 1) $T) + (sum $i ($a, $b) $T)   "sum-last"
use (sum $i ($b + 1, $b) $T) = 0                                              "sum-empty"

;; maximum and minimum: a value of `T` that is attained, and that no other value exceeds
const max, min
arity max 2
arity min 2
bindop max, min
tex max \max_{$1} $2
tex min \min_{$1} $2
use (sub $x $a %C) ∧ (∀ (sub $x $w %C) ((sub $v $w $T) <= (sub $v $a $T)))  ⇒  (max (sub $x $v %C) $T) = sub $v $a $T   "max-intro"
use (sub $x $a %C) ∧ (∀ (sub $x $w %C) ((sub $v $w $T) >= (sub $v $a $T)))  ⇒  (min (sub $x $v %C) $T) = sub $v $a $T   "min-intro"

;; argmax and argmin over a set: *some* element of `$A` where `T` is largest (smallest) -- there
;; can be several, so there is no rule `argmax ... = $a`; the rules say something only if such an
;; element `$a` exists (`argmax` is a choice of one of them). Only over a set `$v ∈ $A`: with any
;; condition (`sub $x $v %C`), the argmax term would be the value of another `sub`, inside it.
const argmax, argmin
arity argmax 2
arity argmin 2
bindop argmax, argmin
tex argmax \operatorname{arg\,max}_{$1} $2
tex argmin \operatorname{arg\,min}_{$1} $2
use ($a ∈ $A) ∧ (∀ ($w ∈ $A) ((sub $v $w $T) <= (sub $v $a $T)))  ⇒  (argmax $v ∈ $A $T) ∈ $A   "argmax-in"
use ($a ∈ $A) ∧ (∀ ($w ∈ $A) ((sub $v $w $T) <= (sub $v $a $T)))  ⇒  ∀ ($w ∈ $A) ((sub $v $w $T) <= (sub $v (argmax $v ∈ $A $T) $T))   "argmax-max"
use ($a ∈ $A) ∧ (∀ ($w ∈ $A) ((sub $v $w $T) >= (sub $v $a $T)))  ⇒  (argmin $v ∈ $A $T) ∈ $A   "argmin-in"
use ($a ∈ $A) ∧ (∀ ($w ∈ $A) ((sub $v $w $T) >= (sub $v $a $T)))  ⇒  ∀ ($w ∈ $A) ((sub $v $w $T) >= (sub $v (argmin $v ∈ $A $T) $T))   "argmin-min"

;; supremum and infimum: the least upper bound and the greatest lower bound of the values of
;; `T`, for a condition that holds for at least one `$a`, and values that are bounded by `$b`
const sup, inf
arity sup 2
arity inf 2
bindop sup, inf
tex sup \sup_{$1} $2
tex inf \inf_{$1} $2
use (∀ (sub $x $w %C) ((sub $v $w $T) <= $b)) ∧ (sub $x $a %C)  ⇒  (sub $v $a $T) <= sup (sub $x $v %C) $T   "sup-upper"
use (∀ (sub $x $w %C) ((sub $v $w $T) <= $b)) ∧ (sub $x $a %C)  ⇒  (sup (sub $x $v %C) $T) <= $b           "sup-least"
use (∀ (sub $x $w %C) ((sub $v $w $T) >= $b)) ∧ (sub $x $a %C)  ⇒  (sub $v $a $T) >= inf (sub $x $v %C) $T   "inf-lower"
use (∀ (sub $x $w %C) ((sub $v $w $T) >= $b)) ∧ (sub $x $a %C)  ⇒  (inf (sub $x $v %C) $T) >= $b           "inf-greatest"

;; limits: `lim v a T` is the limit of `T` for `v` going to `a` (`v ≠ a`); with a condition,
;; `lim v > 0 0 T`, only the `v` with the condition count -- then `a` must be a point that
;; these `v` come arbitrarily close to, otherwise every number would be a limit
const lim
arity lim 3
bindop lim
tex lim \lim_{$1 \to $2} $3
use (∀ $e > 0 ∃ $d > 0 ∀ $y ((0 < abs($y - $a) ∧ abs($y - $a) < $d)  ⇒  abs((sub $v $y $T) - $L) < $e))  ⇒  (lim $v $a $T) = $L   "lim-intro"
use (∀ $d > 0 ∃ $y ((sub $x $y %C) ∧ 0 < abs($y - $a) ∧ abs($y - $a) < $d)) ∧ (∀ $e > 0 ∃ $d > 0 ∀ $y (((sub $x $y %C) ∧ 0 < abs($y - $a) ∧ abs($y - $a) < $d)  ⇒  abs((sub $v $y $T) - $L) < $e))  ⇒  (lim (sub $x $v %C) $a $T) = $L   "lim-cond-intro"

;; "T tends to L for v going to a": `tends v a L T` -- the statement that the limit exists and is
;; `L` (by ε and δ), which `lim v a T = L` can't say, since `lim` has a value for every argument.
;; The limit laws are theorems of analysis, stated here as axioms (their proofs by ε and δ are
;; long); continuity.kurt says continuity with it ("cont-tends").
const tends
arity tends 4
bindop tends                    ; the variable, the point and the limit (outside), then the body
bool tends 0
tex tends $4 \underset{$1 \to $2}{\longrightarrow} $3
use (tends $v $a $L $T)  ⇔  ∀ $e > 0 ∃ $d > 0 ∀ $y ((0 < abs($y - $a) ∧ abs($y - $a) < $d)  ⇒  abs((sub $v $y $T) - $L) < $e)   "tends-def"
use (tends $v $a $L $T)  ⇒  (lim $v $a $T) = $L                                    "tends-lim"
use (tends $v $a $L $T) ∧ (tends $v $a $M $T)  ⇒  $L = $M                          "tends-unique"
use $c = $c  ⇒  tends $v $a $c $c                                                  "tends-const"    ; (`$c` doesn't depend on `$v`)
use tends $v $a $a $v                                                              "tends-id"
use (tends $v $a $L $S) ∧ (tends $v $a $M $T)  ⇒  tends $v $a ($L + $M) ($S + $T)   "tends-add"
use (tends $v $a $L $S) ∧ (tends $v $a $M $T)  ⇒  tends $v $a ($L - $M) ($S - $T)   "tends-sub"
use (tends $v $a $L $T)  ⇒  tends $v $a ($c * $L) ($c * $T)                         "tends-scale"    ; (`$c` doesn't depend on `$v`)
use (tends $v $a $L $S) ∧ (tends $v $a $M $T)  ⇒  tends $v $a ($L * $M) ($S * $T)   "tends-mul"
use (tends $v $a $L $S) ∧ (tends $v $a $M $T) ∧ $M ≠ 0  ⇒  tends $v $a ($L / $M) ($S / $T)   "tends-div"
