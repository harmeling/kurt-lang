; vectorspace -- vector spaces over the field `K` of field.kurt: `vectorspace($V)` for each one
;
; `+`, `·`, `-` and `0` are used for scalars and vectors alike, as in mathematics: which axiom
; applies is decided by the memberships (`$a ∈ K`, `$x ∈ $V`). That is sound -- there is a model
; for each real one, in which the zero scalar and the zero vector are the same object (all the
; operations agree on it: `0 + 0 = 0`, `- 0 = 0`, `λ · 0 = 0`, `0 · 0 = 0`).
;
; The axioms hold for every vector space `$V` over `K` (`vectorspace($V)`), so that there can be
; several, e.g. for a linear map from `V` to `W`. The zero vector `0` and the inverse `- x` are
; given by names, as the slides do after proving uniqueness (below).
;
; The axioms are the (V1)-(V8) of the course "Mathematik für Informatik 1" (mafi1, lectures
; 04 and 05): vector-plus-associative (V1),
; vector-plus-commutative (V2), vector-plus-zero (V3), vector-plus-minus (V4),
; vector-times-associative (V5), vector-one-times (V6), vector-distributive (V7),
; vector-distributive-scalars (V8). proofs/mafi1/ uses this theory.
load propositional, equality, logic, set, field
arity vectorspace 1

; the definition (mafi1 04, 05: (V1)-(V8), and the closure under `+`, `·`, `-` with the zero
; vector), in three parts: `vectorspace($V)` is exactly these properties -- `def`s, so each rule
; below is a theorem proved from them, none an axiom (the axiom audit, dev/todo.md 11; before
; 2026-10-20 the rules were `use`s). (Three parts of four, not one conjunction of twelve: with `+`
; and `·` flat and symmetric, unfolding twelve at once is slow.)
arity vectorclosed 1
arity vectoradditive 1
arity vectorscalar 1
def vectorclosed($V)  ⇔
     0 ∈ $V ∧
     (∀ $u ∈ $V (∀ $w ∈ $V ($u + $w ∈ $V))) ∧
     (∀ $p ∈ K (∀ $u ∈ $V ($p · $u ∈ $V))) ∧
     (∀ $u ∈ $V (- $u ∈ $V))   "vectorclosed"      ; closed: the zero vector, `+`, `·` and `-`
def vectoradditive($V)  ⇔  (∀ $u ∈ $V (∀ $w ∈ $V (∀ $t ∈ $V (($u + $w) + $t = $u + ($w + $t))))) ∧ (∀ $u ∈ $V (∀ $w ∈ $V ($u + $w = $w + $u))) ∧ (∀ $u ∈ $V ($u + 0 = $u)) ∧ (∀ $u ∈ $V ($u + (- $u) = 0))   "vectoradditive"      ; the laws of `+`, (V1)-(V4)
def vectorscalar($V)  ⇔  (∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V ($p · ($q · $u) = ($p · $q) · $u)))) ∧ (∀ $u ∈ $V (1 · $u = $u)) ∧ (∀ $p ∈ K (∀ $u ∈ $V (∀ $w ∈ $V ($p · ($u + $w) = $p · $u + $p · $w)))) ∧ (∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V (($p + $q) · $u = $p · $u + $q · $u))))   "vectorscalar"      ; the laws of `·`, (V5)-(V8)
def vectorspace($V)  ⇔  vectorclosed($V) ∧ vectoradditive($V) ∧ vectorscalar($V)   "vectorspace"

show vectorspace($V)  ⇒  0 ∈ $V   "zero-vector-in"
proof
    assume vectorspace($V)
        vectorclosed($V) ∧ vectoradditive($V) ∧ vectorscalar($V)
        vectorclosed($V)
        0 ∈ $V ∧ (∀ $u ∈ $V (∀ $w ∈ $V ($u + $w ∈ $V))) ∧ (∀ $p ∈ K (∀ $u ∈ $V ($p · $u ∈ $V))) ∧ (∀ $u ∈ $V (- $u ∈ $V))
        0 ∈ $V
qed

show vectorspace($V) ∧ $x ∈ $V ∧ $y ∈ $V  ⇒  $x + $y ∈ $V   "vector-plus-closed"
proof
    assume vectorspace($V) ∧ $x ∈ $V ∧ $y ∈ $V
        vectorspace($V)
        vectorclosed($V) ∧ vectoradditive($V) ∧ vectorscalar($V)
        vectorclosed($V)
        0 ∈ $V ∧ (∀ $u ∈ $V (∀ $w ∈ $V ($u + $w ∈ $V))) ∧ (∀ $p ∈ K (∀ $u ∈ $V ($p · $u ∈ $V))) ∧ (∀ $u ∈ $V (- $u ∈ $V))
        ∀ $u ∈ $V (∀ $w ∈ $V ($u + $w ∈ $V))
        $x ∈ $V
        ∀ $w ∈ $V ($x + $w ∈ $V)
        $y ∈ $V
        $x + $y ∈ $V
qed

show vectorspace($V) ∧ $a ∈ K ∧ $x ∈ $V  ⇒  $a · $x ∈ $V   "vector-times-closed"
proof
    assume vectorspace($V) ∧ $a ∈ K ∧ $x ∈ $V
        vectorspace($V)
        vectorclosed($V) ∧ vectoradditive($V) ∧ vectorscalar($V)
        vectorclosed($V)
        0 ∈ $V ∧ (∀ $u ∈ $V (∀ $w ∈ $V ($u + $w ∈ $V))) ∧ (∀ $p ∈ K (∀ $u ∈ $V ($p · $u ∈ $V))) ∧ (∀ $u ∈ $V (- $u ∈ $V))
        ∀ $p ∈ K (∀ $u ∈ $V ($p · $u ∈ $V))
        $a ∈ K
        ∀ $u ∈ $V ($a · $u ∈ $V)
        $x ∈ $V
        $a · $x ∈ $V
qed

show vectorspace($V) ∧ $x ∈ $V  ⇒  - $x ∈ $V   "vector-minus-closed"
proof
    assume vectorspace($V) ∧ $x ∈ $V
        vectorspace($V)
        vectorclosed($V) ∧ vectoradditive($V) ∧ vectorscalar($V)
        vectorclosed($V)
        0 ∈ $V ∧ (∀ $u ∈ $V (∀ $w ∈ $V ($u + $w ∈ $V))) ∧ (∀ $p ∈ K (∀ $u ∈ $V ($p · $u ∈ $V))) ∧ (∀ $u ∈ $V (- $u ∈ $V))
        ∀ $u ∈ $V (- $u ∈ $V)
        $x ∈ $V
        - $x ∈ $V
qed

show vectorspace($V) ∧ $x ∈ $V ∧ $y ∈ $V ∧ $z ∈ $V  ⇒  ($x + $y) + $z = $x + ($y + $z)   "vector-plus-associative"
proof
    assume vectorspace($V) ∧ $x ∈ $V ∧ $y ∈ $V ∧ $z ∈ $V
        vectorspace($V)
        vectorclosed($V) ∧ vectoradditive($V) ∧ vectorscalar($V)
        vectoradditive($V)
        (∀ $u ∈ $V (∀ $w ∈ $V (∀ $t ∈ $V (($u + $w) + $t = $u + ($w + $t))))) ∧ (∀ $u ∈ $V (∀ $w ∈ $V ($u + $w = $w + $u))) ∧ (∀ $u ∈ $V ($u + 0 = $u)) ∧ (∀ $u ∈ $V ($u + (- $u) = 0))
        ∀ $u ∈ $V (∀ $w ∈ $V (∀ $t ∈ $V (($u + $w) + $t = $u + ($w + $t))))
        $x ∈ $V
        ∀ $w ∈ $V (∀ $t ∈ $V (($x + $w) + $t = $x + ($w + $t)))
        $y ∈ $V
        ∀ $t ∈ $V (($x + $y) + $t = $x + ($y + $t))
        $z ∈ $V
        ($x + $y) + $z = $x + ($y + $z)
qed

show vectorspace($V) ∧ $x ∈ $V ∧ $y ∈ $V  ⇒  $x + $y = $y + $x   "vector-plus-commutative"
proof
    assume vectorspace($V) ∧ $x ∈ $V ∧ $y ∈ $V
        vectorspace($V)
        vectorclosed($V) ∧ vectoradditive($V) ∧ vectorscalar($V)
        vectoradditive($V)
        (∀ $u ∈ $V (∀ $w ∈ $V (∀ $t ∈ $V (($u + $w) + $t = $u + ($w + $t))))) ∧ (∀ $u ∈ $V (∀ $w ∈ $V ($u + $w = $w + $u))) ∧ (∀ $u ∈ $V ($u + 0 = $u)) ∧ (∀ $u ∈ $V ($u + (- $u) = 0))
        ∀ $u ∈ $V (∀ $w ∈ $V ($u + $w = $w + $u))
        $x ∈ $V
        ∀ $w ∈ $V ($x + $w = $w + $x)
        $y ∈ $V
        $x + $y = $y + $x
qed

show vectorspace($V) ∧ $x ∈ $V  ⇒  $x + 0 = $x   "vector-plus-zero"
proof
    assume vectorspace($V) ∧ $x ∈ $V
        vectorspace($V)
        vectorclosed($V) ∧ vectoradditive($V) ∧ vectorscalar($V)
        vectoradditive($V)
        (∀ $u ∈ $V (∀ $w ∈ $V (∀ $t ∈ $V (($u + $w) + $t = $u + ($w + $t))))) ∧ (∀ $u ∈ $V (∀ $w ∈ $V ($u + $w = $w + $u))) ∧ (∀ $u ∈ $V ($u + 0 = $u)) ∧ (∀ $u ∈ $V ($u + (- $u) = 0))
        ∀ $u ∈ $V ($u + 0 = $u)
        $x ∈ $V
        $x + 0 = $x
qed

show vectorspace($V) ∧ $x ∈ $V  ⇒  $x + (- $x) = 0   "vector-plus-minus"
proof
    assume vectorspace($V) ∧ $x ∈ $V
        vectorspace($V)
        vectorclosed($V) ∧ vectoradditive($V) ∧ vectorscalar($V)
        vectoradditive($V)
        (∀ $u ∈ $V (∀ $w ∈ $V (∀ $t ∈ $V (($u + $w) + $t = $u + ($w + $t))))) ∧ (∀ $u ∈ $V (∀ $w ∈ $V ($u + $w = $w + $u))) ∧ (∀ $u ∈ $V ($u + 0 = $u)) ∧ (∀ $u ∈ $V ($u + (- $u) = 0))
        ∀ $u ∈ $V ($u + (- $u) = 0)
        $x ∈ $V
        $x + (- $x) = 0
qed

show vectorspace($V) ∧ $a ∈ K ∧ $b ∈ K ∧ $x ∈ $V  ⇒  $a · ($b · $x) = ($a · $b) · $x   "vector-times-associative"
proof
    assume vectorspace($V) ∧ $a ∈ K ∧ $b ∈ K ∧ $x ∈ $V
        vectorspace($V)
        vectorclosed($V) ∧ vectoradditive($V) ∧ vectorscalar($V)
        vectorscalar($V)
        (∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V ($p · ($q · $u) = ($p · $q) · $u)))) ∧ (∀ $u ∈ $V (1 · $u = $u)) ∧ (∀ $p ∈ K (∀ $u ∈ $V (∀ $w ∈ $V ($p · ($u + $w) = $p · $u + $p · $w)))) ∧ (∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V (($p + $q) · $u = $p · $u + $q · $u))))
        ∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V ($p · ($q · $u) = ($p · $q) · $u)))
        $a ∈ K
        ∀ $q ∈ K (∀ $u ∈ $V ($a · ($q · $u) = ($a · $q) · $u))
        $b ∈ K
        ∀ $u ∈ $V ($a · ($b · $u) = ($a · $b) · $u)
        $x ∈ $V
        $a · ($b · $x) = ($a · $b) · $x
qed

show vectorspace($V) ∧ $x ∈ $V  ⇒  1 · $x = $x   "vector-one-times"
proof
    assume vectorspace($V) ∧ $x ∈ $V
        vectorspace($V)
        vectorclosed($V) ∧ vectoradditive($V) ∧ vectorscalar($V)
        vectorscalar($V)
        (∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V ($p · ($q · $u) = ($p · $q) · $u)))) ∧ (∀ $u ∈ $V (1 · $u = $u)) ∧ (∀ $p ∈ K (∀ $u ∈ $V (∀ $w ∈ $V ($p · ($u + $w) = $p · $u + $p · $w)))) ∧ (∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V (($p + $q) · $u = $p · $u + $q · $u))))
        ∀ $u ∈ $V (1 · $u = $u)
        $x ∈ $V
        1 · $x = $x
qed

show vectorspace($V) ∧ $a ∈ K ∧ $x ∈ $V ∧ $y ∈ $V  ⇒  $a · ($x + $y) = $a · $x + $a · $y   "vector-distributive"
proof
    assume vectorspace($V) ∧ $a ∈ K ∧ $x ∈ $V ∧ $y ∈ $V
        vectorspace($V)
        vectorclosed($V) ∧ vectoradditive($V) ∧ vectorscalar($V)
        vectorscalar($V)
        (∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V ($p · ($q · $u) = ($p · $q) · $u)))) ∧ (∀ $u ∈ $V (1 · $u = $u)) ∧ (∀ $p ∈ K (∀ $u ∈ $V (∀ $w ∈ $V ($p · ($u + $w) = $p · $u + $p · $w)))) ∧ (∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V (($p + $q) · $u = $p · $u + $q · $u))))
        ∀ $p ∈ K (∀ $u ∈ $V (∀ $w ∈ $V ($p · ($u + $w) = $p · $u + $p · $w)))
        $a ∈ K
        ∀ $u ∈ $V (∀ $w ∈ $V ($a · ($u + $w) = $a · $u + $a · $w))
        $x ∈ $V
        ∀ $w ∈ $V ($a · ($x + $w) = $a · $x + $a · $w)
        $y ∈ $V
        $a · ($x + $y) = $a · $x + $a · $y
qed

show vectorspace($V) ∧ $a ∈ K ∧ $b ∈ K ∧ $x ∈ $V  ⇒  ($a + $b) · $x = $a · $x + $b · $x   "vector-distributive-scalars"
proof
    assume vectorspace($V) ∧ $a ∈ K ∧ $b ∈ K ∧ $x ∈ $V
        vectorspace($V)
        vectorclosed($V) ∧ vectoradditive($V) ∧ vectorscalar($V)
        vectorscalar($V)
        (∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V ($p · ($q · $u) = ($p · $q) · $u)))) ∧ (∀ $u ∈ $V (1 · $u = $u)) ∧ (∀ $p ∈ K (∀ $u ∈ $V (∀ $w ∈ $V ($p · ($u + $w) = $p · $u + $p · $w)))) ∧ (∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V (($p + $q) · $u = $p · $u + $q · $u))))
        ∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V (($p + $q) · $u = $p · $u + $q · $u)))
        $a ∈ K
        ∀ $q ∈ K (∀ $u ∈ $V (($a + $q) · $u = $a · $u + $q · $u))
        $b ∈ K
        ∀ $u ∈ $V (($a + $b) · $u = $a · $u + $b · $u)
        $x ∈ $V
        ($a + $b) · $x = $a · $x + $b · $x
qed

; lecture 04: the zero vector is unique
show vectorspace($V) ∧ $o ∈ $V ∧ (∀ $x ∈ $V ($x + $o = $x))  ⇒  $o = 0                 "zero-vector-unique"
proof
    assume vectorspace($V) ∧ $o ∈ $V ∧ (∀ $x ∈ $V ($x + $o = $x))
        vectorspace($V)
        $o ∈ $V
        ∀ $x ∈ $V ($x + $o = $x)
        0 ∈ $V                                          ; zero-vector-in
        0 + $o = 0                                      ; (vector-plus-zero) for 0'  with x = 0
        $o = $o + 0
           = 0
qed

; lecture 04: the inverse is unique
show vectorspace($V) ∧ $x ∈ $V ∧ $a ∈ $V ∧ $b ∈ $V ∧ $x + $a = 0 ∧ $x + $b = 0  ⇒  $a = $b   "vector-minus-unique"
proof
    assume vectorspace($V) ∧ $x ∈ $V ∧ $a ∈ $V ∧ $b ∈ $V ∧ $x + $a = 0 ∧ $x + $b = 0
        vectorspace($V)
        $x ∈ $V
        $a ∈ $V
        $b ∈ $V
        $x + $a = 0
        $x + $b = 0
        0 ∈ $V                                          ; zero-vector-in
        $a = $a + 0
           = $a + ($x + $b)                             ; hypothesis on b
           = ($a + $x) + $b                             ; vector-plus-associative
           = ($x + $a) + $b                             ; vector-plus-commutative
           = 0 + $b                                     ; hypothesis on a
           = $b + 0                                     ; vector-plus-commutative
           = $b                                         ; vector-plus-zero
qed

; lecture 06 (in the proof that 0 ∈ U): 0 x = 0
show vectorspace($V) ∧ $x ∈ $V  ⇒  0 · $x = 0                                          "zero-times-vector"
proof
    assume vectorspace($V) ∧ $x ∈ $V
        vectorspace($V)
        $x ∈ $V
        0 · $x ∈ $V
        - (0 · $x) ∈ $V
        0 · $x + 0 · $x ∈ $V
        0 = 0 · $x + (- (0 · $x))                       ; vector-plus-minus
          = (0 + 0) · $x + (- (0 · $x))                 ; 0 = 0 + 0 in K
          = (0 · $x + 0 · $x) + (- (0 · $x))            ; vector-distributive-scalars
          = 0 · $x + (0 · $x + (- (0 · $x)))            ; vector-plus-associative
          = 0 · $x + 0                                  ; vector-plus-minus
          = 0 · $x                                      ; vector-plus-zero
qed

; lecture 06 (in the proof that -x ∈ U): (-1) x = -x
show vectorspace($V) ∧ $x ∈ $V  ⇒  (- 1) · $x = - $x                                   "minus-one-times-vector"
proof
    assume vectorspace($V) ∧ $x ∈ $V
        vectorspace($V)
        $x ∈ $V
        - 1 ∈ K
        (- 1) · $x ∈ $V
        - $x ∈ $V
        0 = 0 · $x
          = (1 + (- 1)) · $x                            ; 0 = 1 + (-1) in K
          = 1 · $x + (- 1) · $x                         ; vector-distributive-scalars
          = $x + (- 1) · $x                             ; vector-one-times
        $x + (- $x) = 0                                 ; vector-plus-minus
        (- 1) · $x = - $x                               ; vector-minus-unique
qed

; (-λ) x = -(λ x)
show vectorspace($V) ∧ $a ∈ K ∧ $x ∈ $V  ⇒  (- $a) · $x = - ($a · $x)   "minus-times-vector"
proof
    assume vectorspace($V) ∧ $a ∈ K ∧ $x ∈ $V
        vectorspace($V)
        $a ∈ K
        $x ∈ $V
        - 1 ∈ K
        $a · $x ∈ $V
        (- 1) · $a = - $a                               ; minus-one-times
        (- $a) · $x = ((- 1) · $a) · $x
                    = - ($a · $x)
qed

; regrouping a sum of four: (x + y) + (z + u) = (x + z) + (y + u), from (vector-plus-associative) and (vector-plus-commutative)
show vectorspace($V) ∧ $x ∈ $V ∧ $y ∈ $V ∧ $z ∈ $V ∧ $u ∈ $V  ⇒  ($x + $y) + ($z + $u) = ($x + $z) + ($y + $u)   "vector-shuffle"
proof
    assume vectorspace($V) ∧ $x ∈ $V ∧ $y ∈ $V ∧ $z ∈ $V ∧ $u ∈ $V
        vectorspace($V)
        $x ∈ $V
        $y ∈ $V
        $z ∈ $V
        $u ∈ $V
        $x + $y ∈ $V
        $z + $u ∈ $V
        $y + $z ∈ $V
        $z + $y ∈ $V
        $y + $u ∈ $V
        ($x + $y) + ($z + $u) = $x + ($y + ($z + $u))
qed

; in a vector space, x - y = 0 gives x = y (mafi1 10, 2026-10-12)
show vectorspace($V) ∧ $x ∈ $V ∧ $y ∈ $V ∧ $x + (- $y) = 0  ⇒  $x = $y   "vector-minus-zero"
proof
    assume vectorspace($V) ∧ $x ∈ $V ∧ $y ∈ $V ∧ $x + (- $y) = 0
        - $y ∈ $V
        (- $y) + $x = $x + (- $y)                       ; vector-plus-commutative
        (- $y) + $x = 0
        $y + (- $y) = 0                                 ; vector-plus-minus
        (- $y) + $y = $y + (- $y)                       ; vector-plus-commutative
        (- $y) + $y = 0
        $x = $y                                         ; vector-minus-unique, with -y as the vector
qed

; the definition the other way: a set with the zero vector, closed under `+`, `·` and `-`, in which
; (V1)-(V8) hold, is a vector space (mafi1 06: a subspace is one) -- by the three definitions
show (0 ∈ $V ∧ (∀ $u ∈ $V (∀ $w ∈ $V ($u + $w ∈ $V))) ∧ (∀ $p ∈ K (∀ $u ∈ $V ($p · $u ∈ $V))) ∧ (∀ $u ∈ $V (- $u ∈ $V))) ∧ ((∀ $u ∈ $V (∀ $w ∈ $V (∀ $t ∈ $V (($u + $w) + $t = $u + ($w + $t))))) ∧ (∀ $u ∈ $V (∀ $w ∈ $V ($u + $w = $w + $u))) ∧ (∀ $u ∈ $V ($u + 0 = $u)) ∧ (∀ $u ∈ $V ($u + (- $u) = 0))) ∧ ((∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V ($p · ($q · $u) = ($p · $q) · $u)))) ∧ (∀ $u ∈ $V (1 · $u = $u)) ∧ (∀ $p ∈ K (∀ $u ∈ $V (∀ $w ∈ $V ($p · ($u + $w) = $p · $u + $p · $w)))) ∧ (∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V (($p + $q) · $u = $p · $u + $q · $u)))))  ⇒  vectorspace($V)   "vectorspace-intro"
proof
    assume (0 ∈ $V ∧ (∀ $u ∈ $V (∀ $w ∈ $V ($u + $w ∈ $V))) ∧ (∀ $p ∈ K (∀ $u ∈ $V ($p · $u ∈ $V))) ∧ (∀ $u ∈ $V (- $u ∈ $V))) ∧ ((∀ $u ∈ $V (∀ $w ∈ $V (∀ $t ∈ $V (($u + $w) + $t = $u + ($w + $t))))) ∧ (∀ $u ∈ $V (∀ $w ∈ $V ($u + $w = $w + $u))) ∧ (∀ $u ∈ $V ($u + 0 = $u)) ∧ (∀ $u ∈ $V ($u + (- $u) = 0))) ∧ ((∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V ($p · ($q · $u) = ($p · $q) · $u)))) ∧ (∀ $u ∈ $V (1 · $u = $u)) ∧ (∀ $p ∈ K (∀ $u ∈ $V (∀ $w ∈ $V ($p · ($u + $w) = $p · $u + $p · $w)))) ∧ (∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V (($p + $q) · $u = $p · $u + $q · $u)))))
        0 ∈ $V
        ∀ $u ∈ $V (∀ $w ∈ $V ($u + $w ∈ $V))
        ∀ $p ∈ K (∀ $u ∈ $V ($p · $u ∈ $V))
        ∀ $u ∈ $V (- $u ∈ $V)
        ∀ $u ∈ $V (∀ $w ∈ $V (∀ $t ∈ $V (($u + $w) + $t = $u + ($w + $t))))
        ∀ $u ∈ $V (∀ $w ∈ $V ($u + $w = $w + $u))
        ∀ $u ∈ $V ($u + 0 = $u)
        ∀ $u ∈ $V ($u + (- $u) = 0)
        ∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V ($p · ($q · $u) = ($p · $q) · $u)))
        ∀ $u ∈ $V (1 · $u = $u)
        ∀ $p ∈ K (∀ $u ∈ $V (∀ $w ∈ $V ($p · ($u + $w) = $p · $u + $p · $w)))
        ∀ $p ∈ K (∀ $q ∈ K (∀ $u ∈ $V (($p + $q) · $u = $p · $u + $q · $u)))
        vectorclosed($V)
        vectoradditive($V)
        vectorscalar($V)
        vectorspace($V)
qed
