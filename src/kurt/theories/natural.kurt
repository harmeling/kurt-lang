; natural numbers
;
; covers: `Nat` membership (0 is a natural number, and the successor of any natural number is
; a natural number) and the induction principle (a property true at 0 and preserved by
; successor is true of every natural number) -- see proofs/natural-numbers/induction.kurt for
; a worked example: with the base case and the step as two facts, "induction" applies in one step.
;
; also: `0 <= n`, so `n + 1 ≠ 0` and every n ≠ 0 has a predecessor; no natural number between
; n and n + 1; the well-ordering principle (from induction); how `Nat` sits in the other sets of
; number.kurt (`Nat ⊂ Real`, an integer is a natural number or the negative of one, a positive
; integer is a natural number, a rational is a fraction of an integer and a natural number, a
; positive one of two natural numbers, cancelling a common factor). Even and odd numbers, `∣` and
; `coprime` are in divisibility.kurt, the sets `{a, ..., c}` and the intervals in interval.kurt.
;
; arithmetic and the sets `Real`, `Int`, `Rat` come from number.kurt: natural numbers are real
; numbers, so all of its laws (and `calc`) apply to them as well.
load propositional, equality
load set
load number
load logic
default real              ; every symbol of this file is a number, except where said otherwise:

;; inference rules
set Nat                  ; the natural numbers are a set (of numbers)
const Nat
builtin Nat naturals                   ; `calc on` proves `3 ∈ Nat`
tex Nat \mathbb{N}
; `kurt --lean` with Mathlib: the numbers are Mathlib's reals (number.kurt), embedded into the sets
; (set.kurt), and `Nat` is the set of the natural numbers among them -- a definition (the set of
; the embedded reals that are natural numbers), and what `x ∈ Nat` means a theorem, `k_mem_Nat`; the
; rules below are theorems then (each `lean "label" ...`)
lean Nat member $1 ∈ Set.range (fun n : ℕ => (n : ℝ))

use Nat ⊂ Real  "nat-sub-real"
alias ℕ Nat

use 0 in Nat  "nat-zero"
use $n in Nat  implies  $n+1 in Nat  "nat-succ"
; sums and products of natural numbers are natural numbers (by induction from a recursive
; definition of `+` and `*`; number.kurt states their laws instead)
use $a in Nat ∧ $b in Nat  implies  $a + $b in Nat  "nat-add"
use $a in Nat ∧ $b in Nat  implies  $a * $b in Nat  "nat-mul"
; natural numbers aren't negative
use $n ∈ Nat  ⇒  0 <= $n  "nat-nonneg"

; A(0)  and  forall n (A(n) -> A(n+1))   implies   forall n A(n)
use ((sub $x 0 %A) ∧ (∀ $n ∈ Nat  (sub $x $n %A  ⇒  sub $x ($n+1) %A)))   ⇒ ∀ $n in Nat  (sub $x $n %A)   "induction"

show 1 ∈ Nat     "nat-one"
proof
    0 + 1 ∈ Nat
    calc on
    1 ∈ Nat
    calc off
qed

show 2 ∈ Nat     "nat-two"
proof
    1 + 1 ∈ Nat
    calc on
    2 ∈ Nat
    calc off
qed

; 0 is no successor (Peano)
show $n ∈ Nat  ⇒  $n + 1 ≠ 0     "nat-succ-ne-zero"
proof
    assume $n ∈ Nat
        0 <= $n
        0 + 1 <= $n + 1
        calc on
        1 <= $n + 1
        0 < 1
        calc off
        0 < $n + 1
        0 ≠ $n + 1
qed

; a natural number other than 0 is positive
show $n ∈ Nat ∧ $n ≠ 0  ⇒  0 < $n     "nat-pos"
proof
    assume $n ∈ Nat ∧ $n ≠ 0
        $n ∈ Nat
        $n ≠ 0
        0 <= $n
        0 < $n ∨ 0 = $n ∨ 0 > $n                       ; trichotomy
        case 0 < $n
            0 < $n
        case 0 = $n ∨ 0 > $n
            case 0 = $n
                ¬($n = 0)
                $n = 0 ∧ ¬($n = 0)
                ⊥
                0 < $n
            case 0 > $n
                0 > $n ∧ 0 <= $n
                ⊥                                      ; gt-le-contra
                0 < $n
            0 < $n
        0 < $n
qed

; every natural number is 0 or a successor
show ∀ $n ∈ Nat ($n = 0 ∨ ∃ $m ($m ∈ Nat ∧ $n = $m + 1))     "nat-zero-or-succ"
proof
    0 = 0
    0 = 0 ∨ ∃ $m ($m ∈ Nat ∧ 0 = $m + 1)
    let n ∈ Nat
        assume n = 0 ∨ ∃ $m ($m ∈ Nat ∧ n = $m + 1)
            n + 1 = n + 1
            n ∈ Nat ∧ n + 1 = n + 1
            ∃ $m ($m ∈ Nat ∧ n + 1 = $m + 1)
            n + 1 = 0 ∨ ∃ $m ($m ∈ Nat ∧ n + 1 = $m + 1)
    ∀ $n ∈ Nat ($n = 0 ∨ ∃ $m ($m ∈ Nat ∧ $n = $m + 1)  ⇒  $n + 1 = 0 ∨ ∃ $m ($m ∈ Nat ∧ $n + 1 = $m + 1))
    (0 = 0 ∨ ∃ $m ($m ∈ Nat ∧ 0 = $m + 1)) ∧ ∀ $n ∈ Nat ($n = 0 ∨ ∃ $m ($m ∈ Nat ∧ $n = $m + 1)  ⇒  $n + 1 = 0 ∨ ∃ $m ($m ∈ Nat ∧ $n + 1 = $m + 1))
    ∀ $n ∈ Nat ($n = 0 ∨ ∃ $m ($m ∈ Nat ∧ $n = $m + 1))
qed

; the predecessor
show $n ∈ Nat ∧ $n ≠ 0  ⇒  ∃ $m ($m ∈ Nat ∧ $n = $m + 1)     "nat-pred"
proof
    assume $n ∈ Nat ∧ $n ≠ 0
        $n ∈ Nat
        $n ≠ 0
        $n = 0 ∨ ∃ $m ($m ∈ Nat ∧ $n = $m + 1)
        case $n = 0
            ¬($n = 0)
            $n = 0 ∧ ¬($n = 0)
            ⊥
            ∃ $m ($m ∈ Nat ∧ $n = $m + 1)
        case ∃ $m ($m ∈ Nat ∧ $n = $m + 1)
            ∃ $m ($m ∈ Nat ∧ $n = $m + 1)
        ∃ $m ($m ∈ Nat ∧ $n = $m + 1)
qed

; no natural number between n and n + 1
show ∀ $n ∈ Nat ∀ $k ∈ Nat ($k <= $n ∨ $n + 1 <= $k)     "nat-discrete"
proof
    ; n = 0
    let k ∈ Nat
        k = 0 ∨ ∃ $m ($m ∈ Nat ∧ k = $m + 1)
        case k = 0
            0 <= 0
            k <= 0
            k <= 0 ∨ 0 + 1 <= k
        case ∃ $m ($m ∈ Nat ∧ k = $m + 1)
            pick m with m ∈ Nat ∧ k = m + 1
                m ∈ Nat
                k = m + 1
                0 <= m
                0 + 1 <= m + 1
                0 + 1 <= k
                k <= 0 ∨ 0 + 1 <= k
        k <= 0 ∨ 0 + 1 <= k
    ∀ $k ∈ Nat ($k <= 0 ∨ 0 + 1 <= $k)
    ; n → n + 1
    let n ∈ Nat
        assume ∀ $k ∈ Nat ($k <= n ∨ n + 1 <= $k)
            let k ∈ Nat
                k = 0 ∨ ∃ $m ($m ∈ Nat ∧ k = $m + 1)
                case k = 0
                    n + 1 ∈ Nat
                    0 <= n + 1
                    k <= n + 1
                    k <= n + 1 ∨ n + 1 + 1 <= k
                case ∃ $m ($m ∈ Nat ∧ k = $m + 1)
                    pick m with m ∈ Nat ∧ k = m + 1
                        m ∈ Nat
                        k = m + 1
                        m <= n ∨ n + 1 <= m
                        case m <= n
                            m + 1 <= n + 1
                            k <= n + 1
                            k <= n + 1 ∨ n + 1 + 1 <= k
                        case n + 1 <= m
                            n + 1 + 1 <= m + 1
                            n + 1 + 1 <= k
                            k <= n + 1 ∨ n + 1 + 1 <= k
                        k <= n + 1 ∨ n + 1 + 1 <= k
                k <= n + 1 ∨ n + 1 + 1 <= k
            ∀ $k ∈ Nat ($k <= n + 1 ∨ n + 1 + 1 <= $k)
    ∀ $n ∈ Nat (∀ $k ∈ Nat ($k <= $n ∨ $n + 1 <= $k)  ⇒  ∀ $k ∈ Nat ($k <= $n + 1 ∨ $n + 1 + 1 <= $k))
    (∀ $k ∈ Nat ($k <= 0 ∨ 0 + 1 <= $k)) ∧ ∀ $n ∈ Nat (∀ $k ∈ Nat ($k <= $n ∨ $n + 1 <= $k)  ⇒  ∀ $k ∈ Nat ($k <= $n + 1 ∨ $n + 1 + 1 <= $k))
    ∀ $n ∈ Nat ∀ $k ∈ Nat ($k <= $n ∨ $n + 1 <= $k)
qed

; every nonempty set of natural numbers has a least element
show $S ⊂ Nat ∧ (∃ $x ($x ∈ $S))  ⇒  ∃ $m ($m ∈ $S ∧ ∀ $y ∈ $S ($m <= $y))     "well-ordering"
proof
    assume $S ⊂ Nat ∧ (∃ $x ($x ∈ $S))
        $S ⊂ Nat
        ∃ $x ($x ∈ $S)
        ∀ $c ($c ∈ $S  implies  $c ∈ Nat)
        assume ¬(∃ $m ($m ∈ $S ∧ ∀ $y ∈ $S ($m <= $y)))
            ; then no k <= n is in S, by induction on n
            ; n = 0: only k = 0, which would be the least element
            let k ∈ Nat
                assume k <= 0
                    0 <= k
                    k >= 0
                    k = 0
                    assume k ∈ $S
                        0 ∈ $S
                        let y ∈ $S
                            y ∈ $S  implies  y ∈ Nat
                            y ∈ Nat
                            0 <= y
                        ∀ $y ∈ $S (0 <= $y)
                        0 ∈ $S ∧ ∀ $y ∈ $S (0 <= $y)
                        ∃ $m ($m ∈ $S ∧ ∀ $y ∈ $S ($m <= $y))
                        (∃ $m ($m ∈ $S ∧ ∀ $y ∈ $S ($m <= $y))) ∧ ¬(∃ $m ($m ∈ $S ∧ ∀ $y ∈ $S ($m <= $y)))
                        ⊥
                    ¬(k ∈ $S)
            ∀ $k ∈ Nat ($k <= 0  ⇒  ¬($k ∈ $S))
            ; n → n + 1
            let n ∈ Nat
                assume ∀ $k ∈ Nat ($k <= n  ⇒  ¬($k ∈ $S))
                    ; n + 1 isn't in S: it would be the least element
                    assume n + 1 ∈ $S
                        let y ∈ $S
                            y ∈ $S  implies  y ∈ Nat
                            y ∈ Nat
                            ∀ $k ∈ Nat ($k <= n ∨ n + 1 <= $k)       ; nat-discrete
                            y <= n ∨ n + 1 <= y
                            case y <= n
                                y <= n  ⇒  ¬(y ∈ $S)
                                ¬(y ∈ $S)
                                y ∈ $S ∧ ¬(y ∈ $S)
                                ⊥
                                n + 1 <= y
                            case n + 1 <= y
                                n + 1 <= y
                            n + 1 <= y
                        ∀ $y ∈ $S (n + 1 <= $y)
                        n + 1 ∈ $S ∧ ∀ $y ∈ $S (n + 1 <= $y)
                        ∃ $m ($m ∈ $S ∧ ∀ $y ∈ $S ($m <= $y))
                        (∃ $m ($m ∈ $S ∧ ∀ $y ∈ $S ($m <= $y))) ∧ ¬(∃ $m ($m ∈ $S ∧ ∀ $y ∈ $S ($m <= $y)))
                        ⊥
                    ¬(n + 1 ∈ $S)
                    let k ∈ Nat
                        assume k <= n + 1
                            ∀ $j ∈ Nat ($j <= n ∨ n + 1 <= $j)       ; nat-discrete
                            k <= n ∨ n + 1 <= k
                            case k <= n
                                k <= n  ⇒  ¬(k ∈ $S)
                                ¬(k ∈ $S)
                            case n + 1 <= k
                                k >= n + 1
                                k = n + 1
                                ¬(k ∈ $S)
                            ¬(k ∈ $S)
                    ∀ $k ∈ Nat ($k <= n + 1  ⇒  ¬($k ∈ $S))
            ∀ $n ∈ Nat (∀ $k ∈ Nat ($k <= $n  ⇒  ¬($k ∈ $S))  ⇒  ∀ $k ∈ Nat ($k <= $n + 1  ⇒  ¬($k ∈ $S)))
            (∀ $k ∈ Nat ($k <= 0  ⇒  ¬($k ∈ $S))) ∧ ∀ $n ∈ Nat (∀ $k ∈ Nat ($k <= $n  ⇒  ¬($k ∈ $S))  ⇒  ∀ $k ∈ Nat ($k <= $n + 1  ⇒  ¬($k ∈ $S)))
            ∀ $n ∈ Nat ∀ $k ∈ Nat ($k <= $n  ⇒  ¬($k ∈ $S))
            ; but S has an element x, and x <= x
            pick x with x ∈ $S
                x ∈ $S  implies  x ∈ Nat
                x ∈ Nat
                ∀ $k ∈ Nat ($k <= x  ⇒  ¬($k ∈ $S))
                x <= x
                x <= x  ⇒  ¬(x ∈ $S)
                ¬(x ∈ $S)
                x ∈ $S ∧ ¬(x ∈ $S)
                ⊥
        ¬¬(∃ $m ($m ∈ $S ∧ ∀ $y ∈ $S ($m <= $y)))
        ∃ $m ($m ∈ $S ∧ ∀ $y ∈ $S ($m <= $y))
qed

; a natural number other than 0 and 1 is at least 2
show $d ∈ Nat ∧ $d ≠ 0 ∧ $d ≠ 1  ⇒  2 <= $d     "nat-ge-two"
proof
    assume $d ∈ Nat ∧ $d ≠ 0 ∧ $d ≠ 1
        $d ∈ Nat
        $d ≠ 0
        $d ≠ 1
        0 <= $d
        $d >= 0
        ∀ $k ∈ Nat ($k <= 0 ∨ 0 + 1 <= $k)              ; nat-discrete
        $d <= 0 ∨ 0 + 1 <= $d
        case $d <= 0
            $d = 0                                     ; le-ge-antisym
            ¬($d = 0)
            $d = 0 ∧ ¬($d = 0)
            ⊥
            1 <= $d
        case 0 + 1 <= $d
            calc on
            1 <= $d
            calc off
        1 <= $d
        $d >= 1
        1 ∈ Nat
        ∀ $k ∈ Nat ($k <= 1 ∨ 1 + 1 <= $k)              ; nat-discrete
        $d <= 1 ∨ 1 + 1 <= $d
        case $d <= 1
            $d = 1                                     ; le-ge-antisym
            ¬($d = 1)
            $d = 1 ∧ ¬($d = 1)
            ⊥
            1 + 1 <= $d
        case 1 + 1 <= $d
            1 + 1 <= $d
        1 + 1 <= $d
        calc on
        2 <= $d
        calc off
qed

; multiplying by a number of at least 2 makes a positive number larger
show $b ∈ Nat ∧ $b ≠ 0 ∧ 2 <= $d  ⇒  $b < $d * $b     "nat-lt-mul"
proof
    assume $b ∈ Nat ∧ $b ≠ 0 ∧ 2 <= $d
        $b ∈ Nat
        $b ≠ 0
        2 <= $d
        0 < $b                                         ; nat-pos
        $b > 0                                         ; lt-gt
        2 * $b <= $d * $b                              ; le-mul-pos
        0 + $b < $b + $b                               ; lt-add
        0 + $b = $b                                    ; add-identity
        (1 + 1) * $b = 1 * $b + 1 * $b                 ; distrib-add
        1 * $b = $b                                    ; mul-identity
        $b + $b = 1 * $b + 1 * $b
                = (1 + 1) * $b
        calc on
        $b + $b = 2 * $b
        calc off
        $b < $b + $b
        $b < 2 * $b
        $b < $d * $b
qed


; ---- integers and rationals (the sets `Int` and `Rat` are in number.kurt)
;
; `Nat` in `Int`, the integers are the natural numbers and their negatives (and nothing else);
; an integer ≥ 1 is a natural number

use $n ∈ Nat  ⇒  $n ∈ Int                         "int-nat"

use $n ∈ Nat  ⇒  -$n ∈ Int                        "int-neg-nat"

use $z ∈ Int  ⇒  $z ∈ Nat ∨ -$z ∈ Nat             "int-cases"      ; nothing else

show 0 ∈ Int     "int-zero"
proof
    0 ∈ Nat
    0 ∈ Int
qed

show 1 ∈ Int     "int-one"
proof
    1 ∈ Nat
    1 ∈ Int
qed

show $z ∈ Int  ⇒  -$z ∈ Int     "int-neg"
proof
    assume $z ∈ Int
        $z ∈ Nat ∨ -$z ∈ Nat
        case $z ∈ Nat
            -$z ∈ Int                                  ; int-neg-nat
        case -$z ∈ Nat
            -$z ∈ Int                                  ; int-nat
        -$z ∈ Int
qed

; a positive integer is a natural number
show $z ∈ Int ∧ $z > 0  ⇒  $z ∈ Nat     "int-pos-nat"
proof
    assume $z ∈ Int ∧ $z > 0
        $z ∈ Int
        $z > 0
        $z ∈ Nat ∨ -$z ∈ Nat
        case $z ∈ Nat
            $z ∈ Nat
        case -$z ∈ Nat
            0 <= -$z                                   ; nat-nonneg
            -$z >= 0                                   ; le-ge
            -$z + $z >= 0 + $z                         ; ge-add
            -$z + $z = 0                               ; add-inverse
            0 + $z = $z                                ; add-identity
            0 >= 0 + $z
            0 >= $z
            $z <= 0                                    ; le-ge
            $z > 0 ∧ $z <= 0
            ⊥                                          ; gt-le-contra
            $z ∈ Nat
        $z ∈ Nat
qed

; ---- the rationals: the fractions m / n of an integer m and a natural number n ≠ 0, and a positive one with natural m, n

; A defining axiom, not `def`: `Rat` is an existing calculator-bound carrier, and this
; characterizes membership in it rather than introducing one fresh predicate abbreviation.
use $q ∈ Rat  ⇔  ∃ $m ∃ $n ($m ∈ Int ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $q = $m / $n)     "rat-def"

show $z ∈ Int  ⇒  $z ∈ Rat     "rat-int"
proof
    assume $z ∈ Int
        1 ∈ Nat
        calc on
        1 ≠ 0
        calc off
        $z = $z / 1                                    ; div-identity
        $z ∈ Int ∧ 1 ∈ Nat ∧ 1 ≠ 0 ∧ $z = $z / 1
        ∃ $n ($z ∈ Int ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $z = $z / $n)
        ∃ $m ∃ $n ($m ∈ Int ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $z = $m / $n)
        $z ∈ Rat
qed

; a positive rational is a fraction of natural numbers
show $q ∈ Rat ∧ $q > 0  ⇒  ∃ $m ∃ $n ($m ∈ Nat ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $q = $m / $n)     "rat-pos"
proof
    assume $q ∈ Rat ∧ $q > 0
        $q ∈ Rat
        $q > 0
        ∃ $m ∃ $n ($m ∈ Int ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $q = $m / $n)
        pick m with ∃ $n (m ∈ Int ∧ $n ∈ Nat ∧ $n ≠ 0 ∧ $q = m / $n)
            pick n with m ∈ Int ∧ n ∈ Nat ∧ n ≠ 0 ∧ $q = m / n
                m ∈ Int
                n ∈ Nat
                n ≠ 0
                $q = m / n
                0 < n                                  ; nat-pos
                n > 0                                  ; lt-gt
                ; m = q n > 0
                (m / n) * n = m                        ; div-mul
                $q * n = (m / n) * n
                       = m
                $q * n > 0                             ; mul-pos
                m > 0
                m ∈ Nat                                ; int-pos-nat
                m ∈ Nat ∧ n ∈ Nat ∧ n ≠ 0 ∧ $q = m / n
                ∃ $j (m ∈ Nat ∧ $j ∈ Nat ∧ $j ≠ 0 ∧ $q = m / $j)
                ∃ $i ∃ $j ($i ∈ Nat ∧ $j ∈ Nat ∧ $j ≠ 0 ∧ $q = $i / $j)
qed

; cancelling a common factor
show $d ≠ 0 ∧ $b ≠ 0  ⇒  ($d * $a) / ($d * $b) = $a / $b     "frac-cancel"
proof
    assume $d ≠ 0 ∧ $b ≠ 0
        $d ≠ 0
        $b ≠ 0
        ($d / $d) * ($a / $b) = ($d * $a) / ($d * $b)    ; div-mul-div
        $d / $d = 1                                    ; div-self
        1 * ($a / $b) = $a / $b                        ; mul-identity
        ($d * $a) / ($d * $b) = ($d / $d) * ($a / $b)
                              = 1 * ($a / $b)
                              = $a / $b
qed


;; the rules as theorems of Mathlib (see number.kurt): `Nat` by its axiom `k_mem_Nat` (`lean Nat
;; member ...` above: `x ∈ Nat` iff `x` is `↑n` for an `n : ℕ`)
lean "nat-sub-real" simp only [subset]; intro z hz; obtain ⟨x, rfl, _⟩ := k_numset_elem _ z hz; exact (k_mem_Real _).mpr rfl
lean "nat-zero" exact (k_mem_Nat _).mpr ⟨0, by simp⟩
lean "nat-succ" intro x hx; obtain ⟨n, rfl⟩ := (k_mem_Nat x).mp hx; exact (k_mem_Nat _).mpr ⟨n + 1, by push_cast; ring⟩
lean "nat-add" intro a b h; obtain ⟨⟨m, rfl⟩, ⟨n, rfl⟩⟩ := And.intro ((k_mem_Nat _).mp h.1) ((k_mem_Nat _).mp h.2); exact (k_mem_Nat _).mpr ⟨m + n, by push_cast; ring⟩
lean "nat-mul" intro a b h; obtain ⟨⟨m, rfl⟩, ⟨n, rfl⟩⟩ := And.intro ((k_mem_Nat _).mp h.1) ((k_mem_Nat _).mp h.2); exact (k_mem_Nat _).mpr ⟨m * n, by push_cast; ring⟩
lean "nat-nonneg" intro x hx; obtain ⟨n, rfl⟩ := (k_mem_Nat x).mp hx; positivity
lean "induction" intro P h x hx
lean "induction" beta_reduce at h ⊢
lean "induction" have base : P 0 := by first | exact h.1 | exact h.2
lean "induction" have step : ∀ y, k_emb y ∈ Nat → P y → P (y + 1) := by
lean "induction"   intro y hy py
lean "induction"   first | exact h.1 y hy py | exact h.2 y hy py | (rw [add_comm]; first | exact h.1 y hy py | exact h.2 y hy py)
lean "induction" have all : ∀ n : ℕ, P n := by
lean "induction"   intro n
lean "induction"   induction n with
lean "induction"   | zero => simpa using base
lean "induction"   | succ m ih => simpa using step m ((k_mem_Nat _).mpr ⟨m, rfl⟩) ih
lean "induction" obtain ⟨n, rfl⟩ := (k_mem_Nat x).mp hx
lean "induction" exact all n

;; the theorems Kurt proves above, as theorems of Mathlib too: a proof that loads this file cites them,
;; and its export proves them in Lean then, instead of taking them as axioms (this file's own export
;; translates the proofs above) -- those about `⊂`, `even`, `odd`, `∣`, `coprime` too: the export
;; makes the `def`s of the symbols in what a proof cites Lean `def`s (`coprime($a, $b)`, a `def`
;; over a pair, is `coprime a b`, a function of two arguments), so the proofs below unfold them
lean "nat-one" exact (k_mem_Nat _).mpr ⟨1, by simp⟩
lean "nat-two" exact (k_mem_Nat _).mpr ⟨2, by norm_num⟩
lean "nat-succ-ne-zero" intro x hx; obtain ⟨n, rfl⟩ := (k_mem_Nat x).mp hx; beta_reduce
lean "nat-succ-ne-zero" intro h; have : (0 : ℝ) ≤ n := n.cast_nonneg; linarith
lean "nat-pos" intros; casesm* _ ∧ _
lean "nat-pos" obtain ⟨n, rfl⟩ := (k_mem_Nat _).mp ‹k_emb _ ∈ Nat›; beta_reduce at *
lean "nat-pos" have : n ≠ 0 := by rintro rfl; simp_all
lean "nat-pos" exact_mod_cast Nat.pos_of_ne_zero this
lean "nat-zero-or-succ" intro x hx; obtain ⟨n, rfl⟩ := (k_mem_Nat x).mp hx; beta_reduce
lean "nat-zero-or-succ" rcases n with _ | m
lean "nat-zero-or-succ" · simp
lean "nat-zero-or-succ" · first | refine Or.inr ⟨(m : ℝ), ?_, ?_⟩ | refine Or.inl ⟨(m : ℝ), ?_, ?_⟩
lean "nat-zero-or-succ"   all_goals first | exact (k_mem_Nat _).mpr ⟨m, rfl⟩ | (push_cast; ring)
lean "nat-pred" intros; casesm* _ ∧ _
lean "nat-pred" obtain ⟨n, rfl⟩ := (k_mem_Nat _).mp ‹k_emb _ ∈ Nat›; beta_reduce at *
lean "nat-pred" rcases n with _ | m
lean "nat-pred" · simp at *
lean "nat-pred" · refine ⟨(m : ℝ), ?_, ?_⟩
lean "nat-pred"   all_goals first | exact (k_mem_Nat _).mpr ⟨m, rfl⟩ | (push_cast; ring)
lean "nat-discrete" intro x hx y hy
lean "nat-discrete" obtain ⟨n, rfl⟩ := (k_mem_Nat x).mp hx; obtain ⟨k, rfl⟩ := (k_mem_Nat y).mp hy; beta_reduce
lean "nat-discrete" have : (k : ℝ) ≤ n ∨ (n : ℝ) + 1 ≤ k := by
lean "nat-discrete"   rcases le_or_gt k n with h | h
lean "nat-discrete"   · left; exact_mod_cast h
lean "nat-discrete"   · right; exact_mod_cast h
lean "nat-discrete" rcases this with h | h <;> first | (left; linarith) | (right; linarith)
lean "nat-ge-two" intros; casesm* _ ∧ _
lean "nat-ge-two" obtain ⟨n, rfl⟩ := (k_mem_Nat _).mp ‹k_emb _ ∈ Nat›; beta_reduce at *
lean "nat-ge-two" have h0 : n ≠ 0 := by rintro rfl; simp_all
lean "nat-ge-two" have h1 : n ≠ 1 := by rintro rfl; simp_all
lean "nat-ge-two" have : 2 ≤ n := by omega
lean "nat-ge-two" exact_mod_cast this
lean "nat-lt-mul" intros; casesm* _ ∧ _
lean "nat-lt-mul" obtain ⟨n, rfl⟩ := (k_mem_Nat _).mp ‹k_emb _ ∈ Nat›; beta_reduce at *
lean "nat-lt-mul" have h0 : n ≠ 0 := by rintro rfl; simp_all
lean "nat-lt-mul" have : (0 : ℝ) < n := by exact_mod_cast Nat.pos_of_ne_zero h0
lean "nat-lt-mul" nlinarith
lean "well-ordering" intro S h; casesm* _ ∧ _
lean "well-ordering" obtain ⟨x, hx⟩ : ∃ x, k_emb x ∈ S := by assumption
lean "well-ordering" have hsub : subset S Nat := by assumption
lean "well-ordering" simp only [subset] at hsub
lean "well-ordering" obtain ⟨n0, rfl⟩ := (k_mem_Nat x).mp (hsub (k_emb x) hx)
lean "well-ordering" have ex : ∃ n : ℕ, k_emb (n : ℝ) ∈ S := ⟨n0, hx⟩
lean "well-ordering" classical
lean "well-ordering" refine ⟨(Nat.find ex : ℝ), ?_⟩
lean "well-ordering" constructor <;> first
lean "well-ordering"   | exact Nat.find_spec ex
lean "well-ordering"   | (intro y hy; obtain ⟨m, rfl⟩ := (k_mem_Nat y).mp (hsub (k_emb y) hy); beta_reduce at hy ⊢; exact_mod_cast Nat.find_min' ex hy)

;; the rules about the integers and rationals as theorems of Mathlib (`Int`, `Rat` by `k_mem_Int`, `k_mem_Rat`)
lean "int-nat" intro x hx; obtain ⟨n, rfl⟩ := (k_mem_Nat x).mp hx; exact (k_mem_Int _).mpr ⟨n, by simp⟩
lean "int-neg-nat" intro x hx; obtain ⟨n, rfl⟩ := (k_mem_Nat x).mp hx; exact (k_mem_Int _).mpr ⟨-n, by simp⟩
lean "int-cases" intro z hz
lean "int-cases" obtain ⟨m, rfl⟩ := (k_mem_Int z).mp hz
lean "int-cases" obtain ⟨n, rfl | rfl⟩ := Int.eq_nat_or_neg m
lean "int-cases" all_goals first | (left; refine (k_mem_Nat _).mpr ⟨n, ?_⟩; simp; done) | (right; refine (k_mem_Nat _).mpr ⟨n, ?_⟩; simp; done)
lean "int-zero" exact (k_mem_Int _).mpr ⟨0, by simp⟩
lean "int-one" exact (k_mem_Int _).mpr ⟨1, by simp⟩
lean "int-neg" intro z hz; obtain ⟨m, rfl⟩ := (k_mem_Int z).mp hz; exact (k_mem_Int _).mpr ⟨-m, by simp⟩
lean "int-pos-nat" intros; casesm* _ ∧ _
lean "int-pos-nat" obtain ⟨m, rfl⟩ := (k_mem_Int _).mp ‹k_emb _ ∈ Int›; beta_reduce at *
lean "int-pos-nat" have : 0 < m := by exact_mod_cast (‹_› : (0 : ℝ) < m)
lean "int-pos-nat" exact (k_mem_Nat _).mpr ⟨m.toNat, by beta_reduce; exact_mod_cast Int.toNat_of_nonneg this.le⟩
lean "rat-def" intro q; rw [k_mem_Rat]; constructor
lean "rat-def" · rintro ⟨r, rfl⟩
lean "rat-def"   refine ⟨r.num, r.den, ?_⟩
lean "rat-def"   refine ⟨?_, ?_, ?_, ?_⟩ <;> first | exact (k_mem_Int _).mpr ⟨r.num, rfl⟩ | exact (k_mem_Nat _).mpr ⟨r.den, rfl⟩ | exact Rat.cast_def r | (simp [r.den_nz]; done)
lean "rat-def" · rintro ⟨m, n, h⟩
lean "rat-def"   casesm* _ ∧ _
lean "rat-def"   obtain ⟨i, rfl⟩ := (k_mem_Int m).mp ‹_›
lean "rat-def"   obtain ⟨j, rfl⟩ := (k_mem_Nat n).mp ‹_›
lean "rat-def"   subst_vars
lean "rat-def"   exact ⟨(i : ℚ) / (j : ℚ), by push_cast; ring⟩
lean "rat-int" intro z hz; obtain ⟨m, rfl⟩ := (k_mem_Int z).mp hz; exact (k_mem_Rat _).mpr ⟨m, by simp⟩
lean "rat-pos" intros; casesm* _ ∧ _
lean "rat-pos" obtain ⟨r, rfl⟩ := (k_mem_Rat _).mp ‹k_emb _ ∈ Rat›; beta_reduce at *
lean "rat-pos" have hr : 0 < r := by exact_mod_cast (‹_› : (0 : ℝ) < r)
lean "rat-pos" have hnum : 0 ≤ r.num := (Rat.num_pos.mpr hr).le
lean "rat-pos" refine ⟨(r.num.toNat : ℝ), (r.den : ℝ), ?_⟩
lean "rat-pos" refine ⟨?_, ?_, ?_, ?_⟩
lean "rat-pos" all_goals first
lean "rat-pos"   | exact (k_mem_Nat _).mpr ⟨_, rfl⟩
lean "rat-pos"   | (simp [r.den_nz]; done)
lean "rat-pos"   | (rw [show ((r.num.toNat : ℕ) : ℝ) = ((r.num.toNat : ℤ) : ℝ) from (Int.cast_natCast _).symm, Int.toNat_of_nonneg hnum]; exact Rat.cast_def r)
lean "frac-cancel" intros; casesm* _ ∧ _
lean "frac-cancel" field_simp
