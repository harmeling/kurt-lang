; numbers -- the laws of numbers (N, Z, Q, R: an ordered field), formerly arith.kurt
;
; Its laws hold for everything written with its operators (`$a * $b = $b * $a` for any `$a`, `$b`):
; for vectors or matrices, use a structure with its own operators instead (a field, a vector
; space) -- a symbol is declared by one file only, so the two can't be loaded together.
;
; covers: +, -, *, /, ^ (with real algebraic identities: distributivity, inverses, identities,
; the exponent laws), <, >, <=, >= (with transitivity, antisymmetry, trichotomy), and
; factorial (recursively defined via "factorial-step", not just the base case) -- see
; proofs/arithmetic/ for worked examples of all of this.
;
; `calc on` computes what you type, the results of substitutions, and a part of a rule as soon as
; its variables have values (`($n - 1)!` with `$n := 3` matches `2!`, see
; proofs/arithmetic/factorial-with-calc.kurt) -- but it doesn't solve: `$b / 3` doesn't match
; `0` while `$b` is unknown.
load propositional, equality
load objects               ; the sorts: `real`, and `real ⊂ set`
default real                ; every symbol of this file is a number, every position a number's

;; syntax
infix   +  60 60           ; binary plus
infix   -  60 60           ; binary minus
infix   *  70 70           ; binary times
infix   /  70 70           ; binary divide
infix   ^  75 74           ; power, right associative: `2 ^ 3 ^ 2` is `2 ^ (3 ^ 2)`
prefix  -     72           ; unary minus, weaker than `^`: `- 2 ^ 2` is `- (2 ^ 2)`
postfix !  82              ; factorial
infix   <  20 20           ; less than
infix   >  20 20           ; greater than
infix   <= 20 20           ; less than or equal
infix   >= 20 20           ; greater than or equal

flat +, *
sym  +, *
prop <  0, <= 0
chain   = <= <
alias   ≤ <=
alias   ≥ >=
; `a > b` is read as `b < a`, and `a >= b` as `b <= a`: one term, nothing to switch
inline  $a > $b   iff  $b < $a
inline  $a >= $b  iff  $b <= $a
chain   = >= >

; `calc on` computes these with numbers, exactly (see doc/kurt-ref.md, `calc`)
builtin + add, - subtract, - negate, * multiply, / divide, ^ power
builtin = eq, < lt, <= le

; how `kurt --latex` writes them
tex / \frac{$1}{$2}
tex ^ {$1}^{$2}

; how `kurt --lean` writes them with Mathlib (doc/kurt-ref.md, `--lean`): the numbers are Mathlib's
; reals -- for every theory of numbers (natural.kurt, integer.kurt, rational.kurt: `Nat`, `Int`,
; `Rat` are sets of them, as here) --, embedded into the sets of Mathlib, the objects (`lean Obj
; ZFSet`, objects.kurt: every number is a set), a number `2` is `(2 : ℝ)`, `^` the real power
; (`Real.rpow`), and `n!` is `Γ(n + 1)` (`Real.Gamma`: `0! = 1` and `n! = n (n - 1)!` for every
; `n > 0`, as the rules below say, and `n!` the factorial for a natural number). With `ℝ`, `x / 0 =
; 0` (Mathlib's convention); no rule below says otherwise. Each rule is a theorem of Mathlib: its
; proof is the `lean "label" ...` after it (a tactic; only output, Kurt doesn't read it), and
; `kurt --lean` writes the rule as a `theorem` with it, which Lean checks.
lean real ℝ                 ; a number is a real (and a set: `k_emb x`, where a set is required)
lean + $1 + $2
lean - $1 - $2
lean - -$1
lean * $1 * $2
lean / $1 / $2
lean ^ $1 ^ $2
lean < $1 < $2
lean <= $1 ≤ $2
lean ! Real.Gamma ($1 + 1)

;; rules
use $a = $b  ⇒  $a + $c = $b + $c   "add-eq"
use $a = $b  ⇒  $a - $c = $b - $c   "sub-eq"
use $a = $b  ⇒  $a * $c = $b * $c   "mul-eq"
use $a = $b  ⇒  $a / $c = $b / $c   "div-eq"
use ($a + $b) * $c = $a * $c + $b * $c   "distrib-add"
use ($a - $b) * $c = $a * $c - $b * $c   "distrib-sub"
use ($a + $b) - $c = $a - ($c - $b)      "add-sub"

use $a + (-$a) = 0       "add-inverse"
use $a - $a = 0          "sub-inverse"
use $a * 1 = $a          "mul-identity"
use $a / 1 = $a          "div-identity"
use $a * (-1) = -$a      "mul-neg-one"
use -(-$a) = $a          "double-negation"
use $a * 0 = 0           "mul-zero"
use $a ≠ 0 ⇒ 0 / $a = 0  "zero-div"
use $a ≠ 0 ⇒ $a / $a = 1 "div-self"
use $c ≠ 0 ⇒ ($a * $c) / $c = $a             "mul-div"
use $c ≠ 0 ⇒ ($a / $c) * $c = $a             "div-mul"
use $c ≠ 0 ⇒ $a / $c + $b / $c = ($a + $b) / $c  "div-add"
use $c ≠ 0 ∧ $d ≠ 0 ⇒ ($a / $c) * ($b / $d) = ($a * $b) / ($c * $d)  "div-mul-div"
use $a ≠ 0 ∧ $b ≠ 0 ⇒ $a * $b ≠ 0             "mul-ne-zero"
use $a + 0 = $a          "add-identity"
use $a - 0 = $a          "sub-identity"

; `$a ^ 0 = 1` unconditionally would be wrong: 0^0 is conventionally left undefined, so it's
; guarded by `$a ≠ 0` below instead of being a blanket axiom.
use $a ^ 1 = $a                          "pow-identity"
use $a ≠ 0  ⇒  $a ^ 0 = 1                "pow-zero"
; the other laws only for a positive base: `((-1) ^ 2) ^ (1 / 2)` is `1`, but `(-1) ^ 1` is `-1`,
; and `0 ^ 1 * 0 ^ (-1)` would be `0 ^ 0`
use $a > 0  ⇒  $a ^ $b * $a ^ $c = $a ^ ($b + $c)   "pow-add"
use $a > 0  ⇒  ($a ^ $b) ^ $c = $a ^ ($b * $c)      "pow-mul"

;; order rules: <
use $a < $b  ⇒  $a + $c < $b + $c   "lt-add"
use $a < $b  ⇒  $a - $c < $b - $c   "lt-sub"
use $c > 0 ∧ $a < $b  ⇒  $a * $c < $b * $c   "lt-mul-pos"
use $c > 0 ∧ $a < $b  ⇒  $a / $c < $b / $c   "lt-div-pos"
use $c < 0 ∧ $a < $b  ⇒  $a * $c > $b * $c   "lt-mul-neg"
use $c < 0 ∧ $a < $b  ⇒  $a / $c > $b / $c   "lt-div-neg"

;; order rules: <=
use $a <= $b  ⇒  $a + $c <= $b + $c   "le-add"
use $a <= $b  ⇒  $a - $c <= $b - $c   "le-sub"
use $c > 0 ∧ $a <= $b  ⇒  $a * $c <= $b * $c   "le-mul-pos"
use $c > 0 ∧ $a <= $b  ⇒  $a / $c <= $b / $c   "le-div-pos"
use $c < 0 ∧ $a <= $b  ⇒  $a * $c >= $b * $c   "le-mul-neg"
use $c < 0 ∧ $a <= $b  ⇒  $a / $c >= $b / $c   "le-div-neg"

;; order rules: >
use $a > $b  ⇒  $a + $c > $b + $c   "gt-add"
use $a > $b  ⇒  $a - $c > $b - $c   "gt-sub"
use $c > 0 ∧ $a > $b  ⇒  $a * $c > $b * $c   "gt-mul-pos"
use $c > 0 ∧ $a > $b  ⇒  $a / $c > $b / $c   "gt-div-pos"
use $c < 0 ∧ $a > $b  ⇒  $a * $c < $b * $c   "gt-mul-neg"
use $c < 0 ∧ $a > $b  ⇒  $a / $c < $b / $c   "gt-div-neg"

;; order rules: >=
use $a >= $b  ⇒  $a + $c >= $b + $c   "ge-add"
use $a >= $b  ⇒  $a - $c >= $b - $c   "ge-sub"
use $c > 0 ∧ $a >= $b  ⇒  $a * $c >= $b * $c   "ge-mul-pos"
use $c > 0 ∧ $a >= $b  ⇒  $a / $c >= $b / $c   "ge-div-pos"
use $c < 0 ∧ $a >= $b  ⇒  $a * $c <= $b * $c   "ge-mul-neg"
use $c < 0 ∧ $a >= $b  ⇒  $a / $c <= $b / $c   "ge-div-neg"

;; order rules: adding inequalities, powers
use $a < $b ∧ $c < $d  ⇒  $a + $c < $b + $d            "lt-add-lt"
use $a > $b ∧ $c > $d  ⇒  $a + $c > $b + $d            "gt-add-gt"
use $a > 0 ∧ $b > 0  ⇒  $a * $b > 0                   "mul-pos"
use $a > 0 ∧ $b > 0  ⇒  $a / $b > 0                   "div-pos"
use $a > 0  ⇒  $a ^ $b > 0                             "pow-pos"
use $a > 0 ∧ $a < $b ∧ $c > 0  ⇒  $a ^ $c < $b ^ $c    "pow-lt"
use $b > 0 ∧ $a > $b ∧ $c > 0  ⇒  $a ^ $c > $b ^ $c    "pow-gt"

;; order rules: mixed
use $a < $b  ⇒  ¬($a >= $b)   "lt-not-ge"
use $a > $b  ⇒  ¬($a <= $b)   "gt-not-le"
use $a <= $b  ⇒  ¬($a > $b)   "le-not-gt"
use $a >= $b  ⇒  ¬($a < $b)   "ge-not-lt"

;; transitivity: genuinely automatic now, not hand-written -- `chain = <= <` and
;; `chain = >= >` above make kurt itself generate every combined-transitivity fact
;; ("chain-trans-I-J", by the positions of the two relations in the chain, one per ordered pair) as a
;; real, directly-usable axiom. See `generate_chain_transitivity` in kurt.py and
;; doc/kurt-soundness.md for how and why.

;; the relations among each other
use $a <= $b  ⇔  $b >= $a            "le-ge"
use $a < $b  ⇔  $b > $a              "lt-gt"
use $a < $b  ⇒  $a <= $b             "lt-le"
use $a <= $a                         "le-refl"
use $a < $b  ⇒  $a ≠ $b              "lt-ne"

;; anti-symmetry
use $a <= $b ∧ $a >= $b  ⇒  $a = $b   "le-ge-antisym"
use $a > $b  ⇒  $a ≠ $b                "gt-ne"
use $a - $b >= 0  ⇒  $a >= $b          "sub-ge-zero"
use $a <  $b ∧ $a >  $b  ⇒  false   "lt-gt-contra"
use $a <  $b ∧ $a >= $b  ⇒  false   "lt-ge-contra"
use $a >  $b ∧ $a <= $b  ⇒  false   "gt-le-contra"

;; trichotomy
use $a < $b ∨ $a = $b ∨ $a > $b   "trichotomy"

;; factorial
use 0! = 1                              "factorial-base"
use $n > 0  ⇒  $n! = $n * ($n - 1)!     "factorial-step"

;; the rules as theorems of Mathlib: `lean "label" TACTIC` is a proof in Lean of the rule "label"
;; (in `ℝ`, see `lean real ℝ` above) -- `kurt --lean` writes the rule as a `theorem` with it, and
;; Lean checks it; Kurt itself doesn't read the tactic (doc/kurt-ref.md, `--lean`). The tactics don't
;; name the variables (`intros`): Kurt orders the arguments of `+` and `*` its own way.
lean "add-eq" intros; subst_vars; rfl
lean "sub-eq" intros; subst_vars; rfl
lean "mul-eq" intros; subst_vars; rfl
lean "div-eq" intros; subst_vars; rfl
lean "distrib-add" intros; ring
lean "distrib-sub" intros; ring
lean "add-sub" intros; ring
lean "add-inverse" intros; ring
lean "sub-inverse" intros; ring
lean "mul-identity" intros; ring
lean "div-identity" intros; ring
lean "mul-neg-one" intros; ring
lean "double-negation" intros; ring
lean "mul-zero" intros; ring
lean "zero-div" intros; simp
lean "div-self" intros; field_simp
lean "mul-div" intros; field_simp
lean "div-mul" intros; field_simp
lean "div-add" intros; ring
lean "div-mul-div" intros; ring
lean "mul-ne-zero" intros; simp_all
lean "add-identity" intros; ring
lean "sub-identity" intros; ring
lean "pow-identity" intros; simp
lean "pow-zero" intros; simp
lean "pow-add" intros; rw [← Real.rpow_add ‹_›]
lean "pow-mul" intros; rw [← Real.rpow_mul (le_of_lt ‹_›)]
lean "lt-add" intros; linarith
lean "lt-sub" intros; linarith
lean "lt-mul-pos" intros; casesm* _ ∧ _; nlinarith
lean "lt-div-pos" intros; casesm* _ ∧ _; gcongr
lean "lt-mul-neg" intros; casesm* _ ∧ _; nlinarith
lean "lt-div-neg" intros; casesm* _ ∧ _; exact (div_lt_div_right_of_neg ‹_›).mpr ‹_›
lean "le-add" intros; linarith
lean "le-sub" intros; linarith
lean "le-mul-pos" intros; casesm* _ ∧ _; nlinarith
lean "le-div-pos" intros; casesm* _ ∧ _; gcongr
lean "le-mul-neg" intros; casesm* _ ∧ _; nlinarith
lean "le-div-neg" intros; casesm* _ ∧ _; exact (div_le_div_right_of_neg ‹_›).mpr ‹_›
lean "gt-add" intros; linarith
lean "gt-sub" intros; linarith
lean "gt-mul-pos" intros; casesm* _ ∧ _; nlinarith
lean "gt-div-pos" intros; casesm* _ ∧ _; gcongr
lean "gt-mul-neg" intros; casesm* _ ∧ _; nlinarith
lean "gt-div-neg" intros; casesm* _ ∧ _; exact (div_lt_div_right_of_neg ‹_›).mpr ‹_›
lean "ge-add" intros; linarith
lean "ge-sub" intros; linarith
lean "ge-mul-pos" intros; casesm* _ ∧ _; nlinarith
lean "ge-div-pos" intros; casesm* _ ∧ _; gcongr
lean "ge-mul-neg" intros; casesm* _ ∧ _; nlinarith
lean "ge-div-neg" intros; casesm* _ ∧ _; exact (div_le_div_right_of_neg ‹_›).mpr ‹_›
lean "lt-add-lt" intros; casesm* _ ∧ _; linarith
lean "gt-add-gt" intros; casesm* _ ∧ _; linarith
lean "mul-pos" intros; casesm* _ ∧ _; positivity
lean "div-pos" intros; casesm* _ ∧ _; positivity
lean "pow-pos" intros; apply Real.rpow_pos_of_pos; assumption
lean "pow-lt" intros; casesm* _ ∧ _; gcongr
lean "pow-gt" intros; casesm* _ ∧ _; gcongr
lean "lt-not-ge" intros; linarith
lean "gt-not-le" intros; linarith
lean "le-not-gt" intros; linarith
lean "ge-not-lt" intros; linarith
lean "le-ge" intros; exact Iff.rfl
lean "lt-gt" intros; exact Iff.rfl
lean "lt-le" intros; linarith
lean "le-refl" intros; exact le_refl _
lean "lt-ne" intros; linarith
lean "le-ge-antisym" intros; casesm* _ ∧ _; linarith
lean "gt-ne" intros; linarith
lean "sub-ge-zero" intros; linarith
lean "lt-gt-contra" intros; casesm* _ ∧ _; linarith
lean "lt-ge-contra" intros; casesm* _ ∧ _; linarith
lean "gt-le-contra" intros; casesm* _ ∧ _; linarith
lean "trichotomy" intro a b; rcases lt_trichotomy a b with h | h | h <;> tauto
lean "factorial-base" norm_num
lean "factorial-step" intro n h; rw [sub_add_cancel, Real.Gamma_add_one h.ne']
