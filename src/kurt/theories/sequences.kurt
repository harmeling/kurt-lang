; sequences and series
;
; covers: the limit of a sequence, `converges n L T` ("T, a term in the natural number n, tends to
; L for n going to ∞": from some N on, |T(n) - L| < ε, for every ε > 0), its value `seqlim n T`,
; the limit laws, the Archimedean property, and series: `series i a T` is the value of
; T(a) + T(a+1) + ..., the limit of the partial sums `sum i (a, n) T`; the geometric series.
;
; As with `lim` and `tends` (analysis.kurt), `seqlim` and `series` have a value for every argument,
; also where there is no limit: only `converges` says that it exists. The limit laws and the
; geometric series are theorems of analysis, stated here as axioms (their proofs by ε and N are
; long); proofs/analysis/sequences-and-series.kurt proves 1/n → 0 from the definition. For Lean
; they are proved, from Mathlib (`lean "label" ...` at the end of this file).
load propositional, equality, logic, set, numbers, natural, analysis
default real              ; every symbol of this file is a number, except where said otherwise

const converges, seqlim, series
arity converges 3, seqlim 2, series 3
bindop converges, seqlim, series      ; the variable, then (outside) the limit or the start, then the body
prop converges 0
tex converges $3 \underset{$1 \to \infty}{\longrightarrow} $2
tex seqlim \lim_{$1 \to \infty} $2
tex series \sum_{$1=$2}^{\infty} $3
; in Lean with Mathlib (`kurt --lean`): the sequence of the values at the natural numbers `0, 1,
; 2, ...` and its limit (Mathlib's `Tendsto` and `limUnder` along `atTop`); `series` is the limit of
; the partial sums `sum i (a, n) T` (analysis.kurt's `lean sum`), as "series-def" says
lean converges (Filter.Tendsto (fun k_ : ℕ => $2 (k_ : ℝ)) Filter.atTop (nhds $1))
lean seqlim (Filter.limUnder Filter.atTop (fun k_ : ℕ => $1 (k_ : ℝ)))
lean series (Filter.limUnder Filter.atTop (fun k_ : ℕ => (∑ n_ ∈ Finset.Ico (0 : ℤ) (⌈(k_ : ℝ) - $1⌉ + 1), $2 ((k_ : ℝ) - n_) - ∑ n_ ∈ Finset.Ico (⌈(k_ : ℝ) - $1⌉ + 1) 0, $2 ((k_ : ℝ) - n_))))

;; the limit of a sequence, by ε and N
use (converges $n $L $T)  ⇔  ∀ $e > 0 ∃ $N ∀ $m ∈ Nat ($m > $N  ⇒  abs((sub $n $m $T) - $L) < $e)   "converges-def"
use (converges $n $L $T)  ⇒  (seqlim $n $T) = $L                                    "converges-seqlim"
use (converges $n $L $T) ∧ (converges $n $M $T)  ⇒  $L = $M                         "converges-unique"
use $c = $c  ⇒  converges $n $c $c                                                  "converges-const"   ; (`$c` doesn't depend on `$n`)
use (converges $n $L $S) ∧ (converges $n $M $T)  ⇒  converges $n ($L + $M) ($S + $T)   "converges-add"
use (converges $n $L $S) ∧ (converges $n $M $T)  ⇒  converges $n ($L - $M) ($S - $T)   "converges-sub"
use (converges $n $L $T)  ⇒  converges $n ($c * $L) ($c * $T)                       "converges-scale"   ; (`$c` doesn't depend on `$n`)
use (converges $n $L $S) ∧ (converges $n $M $T)  ⇒  converges $n ($L * $M) ($S * $T)   "converges-mul"
use (converges $n $L $S) ∧ (converges $n $M $T) ∧ $M ≠ 0  ⇒  converges $n ($L / $M) ($S / $T)   "converges-div"

;; the Archimedean property: the natural numbers are unbounded
use ∃ $n ∈ Nat ($n > $x)                                                          "archimedes"

;; series: the value of T(a) + T(a+1) + ..., the limit of the partial sums
use (series $i $a $T) = seqlim $n (sum $i ($a, $n) $T)                              "series-def"
; (from "series-def" and "converges-seqlim" -- stated, not proved: in a proved theorem `$T` couldn't
; depend on the variable `$i` of the sum, doc/kurt-soundness.md §8.31)
use (converges $n $L (sum $i ($a, $n) $T))  ⇒  (series $i $a $T) = $L               "series-intro"
; the geometric series, for |q| < 1
; (the first summand is `$q ^ 0`: not for `$q = 0`, whose `0 ^ 0` numbers.kurt leaves open)
use (abs($q) < 1 ∧ $q ≠ 0)  ⇒  converges $n (1 / (1 - $q)) (sum $i (0, $n) ($q ^ $i))   "geometric"

;; the rules as theorems of Mathlib (see numbers.kurt): `lean "label" TACTIC` is a proof in Lean
lean "converges-def" have key : ∀ (f : ℝ → ℝ) (L : ℝ), Filter.Tendsto (fun k_ : ℕ => f (k_ : ℝ)) Filter.atTop (nhds L) ↔ ∀ e, 0 < e → ∃ N : ℝ, ∀ m, k_emb m ∈ Nat → N < m → |f m - L| < e := by
lean "converges-def"   intro f L
lean "converges-def"   rw [Metric.tendsto_atTop]
lean "converges-def"   simp only [Real.dist_eq, gt_iff_lt]
lean "converges-def"   constructor
lean "converges-def"   · intro h e he; obtain ⟨N, H⟩ := h e he
lean "converges-def"     refine ⟨(N : ℝ) - 1, fun m hm hNm => ?_⟩
lean "converges-def"     obtain ⟨k, rfl⟩ := (k_mem_Nat m).mp hm
lean "converges-def"     have : N < k + 1 := by exact_mod_cast (show (N : ℝ) < k + 1 by simp only [] at hNm; linarith)
lean "converges-def"     exact H k (by omega)
lean "converges-def"   · intro h e he; obtain ⟨N, H⟩ := h e he
lean "converges-def"     obtain ⟨K, hK⟩ := exists_nat_gt N
lean "converges-def"     exact ⟨K, fun k hk => H k ((k_mem_Nat _).mpr ⟨k, rfl⟩) (lt_of_lt_of_le hK (by exact_mod_cast hk))⟩
lean "converges-def" intros; beta_reduce
lean "converges-def" first | exact key _ _ | (rw [key]; simp only [and_comm, and_left_comm, and_assoc])
lean "converges-seqlim" intros; exact Filter.Tendsto.limUnder_eq ‹_›
lean "converges-unique" intros; casesm* _ ∧ _; exact tendsto_nhds_unique ‹_› ‹_›
lean "converges-const" intros; exact tendsto_const_nhds
lean "converges-add" intros; casesm* _ ∧ _; exact Filter.Tendsto.add ‹_› ‹_›
lean "converges-sub" intros; casesm* _ ∧ _; exact Filter.Tendsto.sub ‹_› ‹_›
lean "converges-scale" intros; exact Filter.Tendsto.mul_const _ ‹_›
lean "converges-mul" intros; casesm* _ ∧ _; exact Filter.Tendsto.mul ‹_› ‹_›
lean "converges-div" intros; casesm* _ ∧ _; exact Filter.Tendsto.div ‹_› ‹_› ‹_›
lean "archimedes" intro x; obtain ⟨n, hn⟩ := exists_nat_gt x
lean "archimedes" exact ⟨n, (k_mem_Nat _).mpr ⟨n, rfl⟩, hn⟩
lean "series-def" intros; rfl
lean "series-intro" intros; exact Filter.Tendsto.limUnder_eq ‹_›
lean "geometric" intro q h
lean "geometric" have h1 : |q| < 1 := by first | exact h.1 | exact h.2
lean "geometric" beta_reduce
lean "geometric" have e : ∀ (q : ℝ) (n : ℕ), (∑ n_ ∈ Finset.Ico (0 : ℤ) (⌈(n : ℝ) - 0⌉ + 1), q ^ ((n : ℝ) - n_) - ∑ n_ ∈ Finset.Ico (⌈(n : ℝ) - 0⌉ + 1) 0, q ^ ((n : ℝ) - n_)) = ∑ i ∈ Finset.range (n + 1), q ^ i := by
lean "geometric"   intro q n
lean "geometric"   rw [show (n : ℝ) - 0 = ((n : ℤ) : ℝ) by simp, Int.ceil_intCast, Finset.Ico_eq_empty_of_le (by omega : (0 : ℤ) ≤ (n : ℤ) + 1), Finset.sum_empty, sub_zero, Int.Ico_eq_finset_map, Finset.sum_map]
lean "geometric"   simp only [Function.Embedding.trans_apply, Nat.castEmbedding_apply, addLeftEmbedding_apply, zero_add, show ((n : ℤ) + 1 - 0).toNat = n + 1 by omega]
lean "geometric"   rw [← Finset.sum_range_reflect]
lean "geometric"   apply Finset.sum_congr rfl
lean "geometric"   intro i hi
lean "geometric"   rw [Finset.mem_range] at hi
lean "geometric"   rw [show n + 1 - 1 - i = n - i by omega, Int.cast_natCast, Nat.cast_sub (by omega : i ≤ n), sub_sub_cancel, Real.rpow_natCast]
lean "geometric" simp only [e]
lean "geometric" have h := ((hasSum_geometric_of_abs_lt_one h1).tendsto_sum_nat).comp (Filter.tendsto_add_atTop_nat 1)
lean "geometric" rw [one_div]; exact h
