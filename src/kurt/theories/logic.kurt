; first order logic
;
; covers: forall-elim (instantiate a universal at a specific value) and exists-intro
; (introduce an existential from a witness). forall-intro and exists-elim are *not* axioms
; here -- they're the effect of closing a `let`/`pick` block (see kurt.py's `eval_done`).
; Also unique existence, `∃! x P(x)` (`existsunique`), defined from `∃`, `∀` and `=`.

;; syntax
load propositional      ; syntax and rules for propositional logic
load equality  ; `=`, for unique existence
; the quantifiers: binders with a boolean body, and the roles the engine gives them -- `let`
; closes with the universal ("forall-intro"), `pick` opens from the existential ("exists-elim"),
; and the outer `∀`s of facts are left out (their variables stand for anything); the other two
; rules are the axioms below. Without `load logic`, a file has no quantifiers (a deep object
; language may use the words and the glyphs for something else).
arity   forall 2, exists 2
bindop  forall, exists          ; with a condition, `∀ x > 0 ...` binds the first symbol of the
                                ; condition that is new or a variable (decided when it is read)
prop    forall 0 2, exists 0 2  ; the body is boolean, and so is the whole
builtin forall universal, exists existential
alias   ∀ forall
alias   ∃ exists
arity  existsunique 2     ; unique existence: `existsunique x P(x)`, `∃! x P(x)`
bindop existsunique       ; binds its variable, also with a condition: `∃! x ∈ M P(x)`
prop   existsunique 0 2   ; the body is boolean, and so is the whole
alias  ∃! existsunique

;; inference rules
;use %A                                  implies  forall $x %A      "forall-intro"
use forall $$x %A                        implies  sub $$x $a %A      "forall-elim"
use sub $$x $a %A                        implies  exists $$x %A      "exists-intro"
;use (exists $x %B) and (%B implies %A)  implies  %A                "exists-elim"

; quantifiers with a condition, `∀ $x > 0 P $x` and `∃ $x > 0 P $x`: in a rule, the condition
; `sub $x $v %C` stands for any condition on the bound variable `$v` (`%C` is the condition
; with the hole `$x` for `$v`, e.g. `$x > 0`)
use (forall (sub $$x $$v %C) %P) and (sub $$x $a %C)  implies  sub $$v $a %P    "forall-cond-elim"
use (sub $$x $a %C) and (sub $$v $a %P)  implies  exists (sub $$x $$v %C) %P    "exists-cond-intro"
; Defining axioms, not `def`: these characterize conditioned forms of the existing built-in
; binders; they do not introduce one fresh predicate or function symbol.
use (forall (sub $$x $$v %C) %P)  iff  forall $$w ((sub $$x $$w %C) implies (sub $$v $$w %P))  "forall-cond-def"
use (exists (sub $$x $$v %C) %P)  iff  exists $$w ((sub $$x $$w %C) and (sub $$v $$w %P))      "exists-cond-def"

; rewriting under a binder: an equivalence that holds for every x may replace one formula by the
; other inside `∀ x` and `∃ x` (`iff-subst` can't, since its `sub` doesn't capture `x`). Axioms,
; since a proof for any `%A` that depends on `$x` would need `sub` in its lines.
use (forall $$x (%A iff %B))  implies  ((forall $$x %A) iff (forall $$x %B))   "forall-iff"
use (forall $$x (%A iff %B))  implies  ((exists $$x %A) iff (exists $$x %B))   "exists-iff"

;; unique existence
; The meaning of `∃!` is its definition: there is an x with P(x), and every y with P(y) is that x.
; With a condition, `∃! x ∈ M P(x)` is `∃! x (x ∈ M and P(x))`, as for `∃`.
use (existsunique $$x %A)  iff  exists $$x (%A and (forall $$y ((sub $$x $$y %A) implies ($$y = $$x))))  "existsunique-def"
use (existsunique (sub $$x $$v %C) %P)  iff  existsunique $$w ((sub $$x $$w %C) and (sub $$v $$w %P))     "existsunique-cond-def"
; Three rules that follow from the definition, for one step instead of several. Axioms, since a
; proof for any `%A` that depends on `$x` would need `sub` in its lines (as for "forall-iff");
; proofs/natural-deduction/existsunique.kurt derives each of them from "existsunique-def" alone, for a
; predicate `P`:
; - intro: `P(a)` and every y with `P(y)` is a: `∃! x P(x)` (the definition, with exists-intro)
; - exists: `∃! x P(x)` gives `∃ x P(x)` (pick the witness of the definition)
; - unique: `∃! x P(x)`, `P(a)` and `P(b)` give `a = b` (both are the witness)
use (sub $$x $a %A) and (forall $$y ((sub $$x $$y %A) implies ($$y = $a)))  implies  existsunique $$x %A  "existsunique-intro"
use (existsunique $$x %A)  implies  exists $$x %A                                                     "existsunique-exists"
use (existsunique $$x %A) and (sub $$x $a %A) and (sub $$x $b %A)  implies  $a = $b                    "existsunique-unique"


;; better looking
; use %A                     ⇒  ∀ $x %A       "forall-intro"
; use ∀ $x %A                ⇒  sub $x $a %A  "forall-elim"
; use sub $x $a %A           ⇒  ∃ $x %A       "exists-intro"      ; contraposition of "forall-elim"
; use (∃ $x %B) ∧ (%B ⇒ %A)  ⇒  %A            "exists-elim"

;; requirements
; - for "forall-intro":
;   - no requirements!  `$x` can appear in `%A` or not
; - for "forall-elim" and "exists-intro":
;   - `$a` doesn't contain free variables that are bound in `%A`
;   - already sufficient would be if those free variables in `$a` are not bound in `%A` only at the locations of `$x`
;   - can anything bad really happen, if we rename all variables (free and bound) beforehand?
;     - probably not, since we rename all vars in `%A` before `$a` is instantiated
; - for "exists-elim":
;   - `%A` must not contain `$x`
;   - since we first completely rename *all* variables this works:
;       (exists $%1 %B) and (%B implies %A)  implies  %A
;     where (for readability) we didn't replace `%A` and `%B`.  
;   - case 1: we first match `%B` using `exist $%1 %B`, then `%B` will contain `$%1`, next
;     we match `%B implies %A` where we can assign `$%1` appropriately, since it appears free
;   - case 2: we match `%B` using `%B implies %A`, then we use that `%B` to match against
;     `exists $%1 %B`

;; `kurt --lean`: `∃!` as what "existsunique-def" says (`$1` the body, a function; with a
;; condition, `$1` the condition and `$2` the body), so that its rules are theorems of Lean's logic
lean existsunique (∃ x_, $1 x_ ∧ ∀ y_, $1 y_ → y_ = x_)
lean existsunique (∃ x_, ($1 x_ ∧ $2 x_) ∧ ∀ y_, ($1 y_ ∧ $2 y_) → y_ = x_)

;; the rules as theorems of Lean's logic (`kurt --lean`, see propositional.kurt): `∀`, `∃` are Lean's,
;; `sub $x $a %A` is `(fun x => A x) a`, and `∃!` is what "existsunique-def" says (`lean
;; existsunique` above) -- so "existsunique-def" is true by its reading, the other rules by `grind`
lean "forall-elim" grind
lean "exists-intro" grind
lean "forall-cond-elim" grind
lean "exists-cond-intro" grind
lean "forall-cond-def" grind
lean "exists-cond-def" grind
lean "forall-iff" grind
lean "exists-iff" grind
lean "existsunique-def" grind
lean "existsunique-cond-def" grind
lean "existsunique-intro" grind
lean "existsunique-exists" grind
lean "existsunique-unique" grind
