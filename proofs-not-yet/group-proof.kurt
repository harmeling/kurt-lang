; let's proof that the Integers form a group

load natural
load group

let $a ∈ Int, $b ∈ Int
    $a + $b ∈ Int
closed(Int, (+))

let $a ∈ Int, $b ∈ Int, $c ∈ Int
    ($a + $b) + $c = $a + ($b + $c)
associative(Int, (+))

let $a ∈ Int
    0 + $a = $a
identity(Int, (+), 0)

let $v ∈ Int
    ((- $v) ∈ Int ∧ (((- $v) + $v) = 0))
inverse(Int, (+), 0, (-))

group(Int, (+), 0, (-))
; NOT YET (todo 35): group.kurt's `closed` binds `a`, `b` over any object, but `+` of the integers
; takes numbers: a structure over a particular sort needs the carrier's sort to be a parameter
