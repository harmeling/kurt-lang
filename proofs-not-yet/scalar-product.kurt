; scalar-product.kurt
load arithmetic   ; for theorems about real numbers
brackets < >

; bilinearity 
var a, b, c, λ
use <a+b,c> = <a,c> + <b,c>   "linearity in 1st arg"
use <a,b+c> = <a,b> + <a,c>   "linearity in 2st arg"
use <λ*a,b> = λ*<a,b>         "linearity in 1st arg"
use <a,λ*b> = λ*<a,b>         "linearity in 2st arg"
use <a,b> = <b,a>             "symmetry"
use a≠0 ⇒ <a,a> > 0           "positive-definiteness"

; Cauchy-Schwarz inequality
show <a,b> * <a,b> ≤ <a,a> * <b,b>   "Cauchy-Schwarz inequality"
proof
    assume a≠0
    def λ = <a,b> / <a,a>
    <a - λ*b, a - λ*b> ≥ 0
    <a,a> - 2*λ*<a,b> + λ*λ*<b,b> ≥ 0
    <a,a> - 2*(<a,b>*<a,b>/<a,a>) + <a,b>*<a,b>/(<a,a>*<a,a>)*<b,b> ≥ 0
    <a,a>*<a,a> - 2*<a,b>*<a,b> + <a,b>*<a,b>*<b,b>/<a,a> ≥ 0
    <a,a>*<a,a>*<a,a> - 2*<a,b>*<a,b>*<a,a> + <a,b>*<a,b>*<b,b> ≥ 0
    (<a,a>*<b,b> - <a,b>*<a,b>) ≥ 0
    <a,a>*<b,b> ≥ <a,b>*<a,b>
    thus <a,b>*<a,b> ≤ <a,a>*<b,b>
    thus <a,b>*<a,b> ≤ <a,a>*<b,b>   ; closes block and removes assumption a≠0
qed
;;; Proof checked.