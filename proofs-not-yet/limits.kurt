; limits

load forall
load arithmetics

; this is no special result, just a nested formula
show ∀ε>0 ∃δ>0 ∀x |x-2| < δ  ⇒  |(3x+1)-7| < ε
proof
    fix ε>0           ; opens a block with local constant ε
        def δ=ε/3      ; opens a block with local constant δ
        δ > 0
        fix |x-2| < δ     ; opens a block with local constant x
            |x-2| < ε/3
            3 * |x-2| < ε
            |(3*x+1)-7| = |3*x - 6| 
                = 3 * |x - 2|
                < ε
        thus ∀x |x-2| < δ ⇒ |(3*x+1)-7| < ε           ; closes block and removes constant x
        ∃δ>0 ∀x |x-2| < δ ⇒ |(3*x+1)-7| < ε      ; closes block and removes constant δ
    thus ∀ε>0 ∃δ ∀x |x-2| < δ ⇒ |(3*x+1)-7| < ε   ; closes block and removes constant ε
qed
;;; Proof checked.

assume  impl-intro
fix, let  forall-intro
pick       exists-elim


exists F(x)   G(x) 
exists x (F(x) ∧ G(x))
forall F(x)  G(x) 

show forall x (F(x) ⇒ G(x))
proof
   fix x ∈ R
       assume F(x)
           G(x)
       thus F(x) ⇒ G(x)
    thus forall x (F(x) ⇒ G(x))
qed