{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Python: Prompt for Args",
        "type": "python",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal",
        "args": [
          "${input:commandLineArgs}"
        ]
      }
    ],
    "inputs": [
      {
        "id": "commandLineArgs",
        "type": "promptString",
        "description": "Enter command-line arguments"
      }
    ]
  }