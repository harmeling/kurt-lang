; 48-groups.kurt

; group.kurt defines what a group is, `group(G, (∘), e, inv)`: a set `G`, an
; operation `∘` on it, the identity `e`, and the inverse `inv`. In group.kurt,
; `∘` is an *operator variable* -- declared with `var ∘` and `infix ∘` -- so
; its rules and theorems hold for every operation. To pass an operator as an
; argument, put it into parentheses: `(∘)`, `(+)`, `(-)`.

load group, arith

; the numbers `R` with `+`, `0` and `-` are a group (here simply assumed):
const R, x, y
use group(R, (+), 0, (-))
use x ∈ R
use y ∈ R
x + y ∈ R               ; by group-closed, with `∘` := `+`
x + 0 = x               ; by group-right-identity
-(-x) = x               ; by inverse-inverse, a theorem of group.kurt

; the same theorems for an abstract group, with group.kurt's `∘`:
const G, e, inv, a, b
arity inv 1
use group(G, (∘), e, inv)
use a ∈ G
use b ∈ G
inv (inv a) = a
b ∘ inv b = e           ; by group-right-inverse

; nothing says that `∘` is commutative, so this is not a consequence:
expect "ProofError"
    a ∘ b = b ∘ a
