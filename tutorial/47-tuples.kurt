; 47-tuples.kurt

; set.kurt has ordered pairs `(a, b)`: two pairs are equal exactly when their
; parts are ("pair-eq"), and `fst`, `snd` give the parts back.

load set
const a, b, c, d

use (a, b) = (c, d)
a = c ∧ b = d            ; by pair-eq
b = d
fst(a, b) = a            ; `fst(a, b)` is `fst` applied to the pair
snd(a, b) = b

; The comma is right-associative, so a triple is a pair whose second part is
; a pair: `(a, b, c)` is `(a, (b, c))`. Comparing triples takes two steps:

const u, v, w
use (a, b, c) = (u, v, w)
a = u ∧ (b, c) = (v, w)
(b, c) = (v, w)
b = v ∧ c = w
c = w

; `A × B` is the set of the pairs with the first part in `A` and the second
; in `B` ("product"), and every element of `A × B` is such a pair
; ("product-pairs"):

const A, B, p
use a ∈ A
use b ∈ B
(a, b) ∈ A × B
use p ∈ A × B
p = (fst p, snd p)

; For a function of two arguments, `f(a, b)` is the same as `f a b`, as
; usual in mathematics:

arity f 2
use f a b = c
f(a, b) = c
