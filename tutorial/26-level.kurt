; 26-level.kurt

; `level` prints how deeply nested the current block is, as a plain number --
; the numeric version of `mode` (23-mode.kurt): 0 is the outermost level, and
; every open `proof`/`assume`/`let`/`pick`/`sandbox` block adds one.

; A running *file* already starts at level 1, not 0 -- see 23-mode.kurt for
; why:
level

bool A, B
use A implies B

show A implies B "demo"
proof
    level          ; one more than above
    assume A
        level      ; one more again
        use B
qed

level              ; back down to where we started
