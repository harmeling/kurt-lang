; minimal syntax (never loaded manually)

false                   ; never load this theory, it is already built-in

;;; hardcoded in `kurt.py`
;brackets "(" ")"       ; for grouping during parsing
;infix ","   5  5       ; for lists
;infix "="  20 20       ; equality, left associative
;sym "="                ; equality is symmetric
;infix " "  22 22       ; space, flat
;infix "//"  3 3        ; substitution of variables