; natural numbers

;; syntax
const 0, 1
infix + 10 10

;; inference rules
use Nat = {0, 1, 2, ...}

; alternatively
use 0 in Nat
use $n in Nat  implies  $n+1 in Nat

; induction
;use ($A // $x=0) and (forall $n in Nat  (($A // $x=$n) implies ($A // $x=$n+1))) implies forall $n in Nat  (A//$x=$n)  "induction"

; A(0)  and  forall n (A(n) -> A(n+1))   implies   forall n A(n)
use ((sub $x 0 %A) ∧ (∀ $n ∈ Nat  (sub $x $n %A  ⇒  sub $x ($n+1) %A)))   ⇒ ∀ $n in Nat  (sub $x $n %A)   "induction"