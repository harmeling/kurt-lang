; set theory
load equality

; syntax
infix    in 55 55        ; element
infix    |  30 30        ; separator for set comprehension
bool     in 0
alias    ∈ in            ; `∈` inherits all properties of `in`
brackets { }             ; curly brackets
brackets [ ]             ; squared brackets

; we assume that all objects are sets

; Zermelo-Fraenkel axioms
use $a = $b  ⇒  ∀ $c  ($c ∈ $a ⇔ $c ∈ $b)  "extensionality" ; two sets are equal iff they have the same elements
use ∀ $c  ($c ∈ $a ⇔ $c ∈ $b)  ⇒  $a = $b   "extensionality"

use ∃ $b ∀ $a ¬ ($a ∈ $b)                    "empty-set"      ; there exists a set with no elements

; there exists a set that contains 
use ∀ $a ∀ $b ∃ $c ∀ $d ($d ∈ $c ⇔ ($a ∈ $d ∨ $b ∈ $d))      ; pair set {a, b}

; for automatic testing we add the following line:
;;; Proof checked.