; first order logic

;; syntax
load "propositional"  ; syntax and rules for propositional logic
arity  forall 2       ; universal quantification
arity  exists 2       ; existential quantification
bindop forall, exists
bool   forall 0 2     ; position 1 is special for binding operators and must be boolean or just a variable
bool   exists 0 2     ; position 1 is special for binding operators and must be boolean or just a variable

;; inference rules
; use $x = $x                                                    ; equal-intro, hard-coded in `kurt.py`
use $A and $x = $y implies ($A // $x=$y)                         ; equal-elim

use $A implies forall $x $A                                      ; forall-intro
use forall $x $A implies ($A // $x=$t)                           ; forall_elim

use $A implies exists $x ($A // $t=$x)                           ; exists_intro
use (exists $x $A) and (($A // $x=$c) implies $B) implies $B     ; exists_elim
