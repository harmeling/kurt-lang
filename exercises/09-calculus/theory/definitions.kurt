; CALCULUS BY THE DEFINITIONS
;
; Exercise 2 uses only the definitions of continuity and of the derivative (those of
; continuity.kurt, written out here, with analysis.kurt and numbers.kurt) -- not the rules of
; differentiation of theory/calculus.kurt, and not continuity.kurt's "cont-tends" with the limit
; rules of analysis.kurt, so that a proof goes through ε and δ. Functions are written as terms in
; a variable, which the operators bind:
;
;     cont x a T              T (a term in x) is continuous in x at the point a
;     diff x a T              T is differentiable in x at a
;     deriv x a T             the derivative of T in x at a, d/dx T at x = a (a number)
;     abs(t)                  the absolute value |t|
;
; T(a) stands for T with a in place of the variable (`sub x a T`).
;
;     "cont-def"      cont x a T ⇔ ∀ e > 0 ∃ d > 0 ∀ y (abs(y - a) < d ⇒ abs(T(y) - T(a)) < e)
;     "diff-def"      diff x a T ⇔ ∃ L ∀ e > 0 ∃ d > 0 ∀ h ((0 < abs(h) ∧ abs(h) < d)
;                                                        ⇒ abs((T(a + h) - T(a)) / h - L) < e)
;     "deriv-intro"   (∀ e > 0 ∃ d > 0 ∀ h ((0 < abs(h) ∧ abs(h) < d)
;                                ⇒ abs((T(a + h) - T(a)) / h - L) < e))  ⇒  deriv x a T = L
;
; and the algebra of analysis.kurt and numbers.kurt ("add-sub", "distrib-sub", "abs-mul", ...).
;
; This file is the scene of exercise 2: it loads it with `load theory/definitions`. Don't change it.
load analysis
const cont, diff, deriv
arity cont 3, diff 3, deriv 3
bindop cont, diff, deriv        ; the variable, then the point (outside of the scope), then the body
bool cont 0, diff 0
tex cont \operatorname{cont}_{$1=$2} $3
tex diff \operatorname{diff}_{$1=$2} $3
tex deriv \left.\frac{d}{d$1} $3\right|_{$1=$2}
use (cont $v $a $T)  ⇔  ∀ $e > 0 ∃ $d > 0 ∀ $y (abs($y - $a) < $d  ⇒  abs((sub $v $y $T) - (sub $v $a $T)) < $e)   "cont-def"
use (diff $v $a $T)  ⇔  ∃ $L ∀ $e > 0 ∃ $d > 0 ∀ $h ((0 < abs($h) ∧ abs($h) < $d)  ⇒  abs(((sub $v ($a + $h) $T) - (sub $v $a $T)) / $h - $L) < $e)   "diff-def"
use (∀ $e > 0 ∃ $d > 0 ∀ $h ((0 < abs($h) ∧ abs($h) < $d)  ⇒  abs(((sub $v ($a + $h) $T) - (sub $v $a $T)) / $h - $L) < $e))  ⇒  (deriv $v $a $T) = $L   "deriv-intro"
