; MAPS BETWEEN SETS
;
; The scene of the exercises on maps (functions): with set.kurt, a map f from A to B is written
; `f : A → B` (it is a set of pairs, as in set theory), and `f x` (or `f(x)`) is its value at x.
;
;     f : A → B               f is a map from A to B
;     f x                     the value of f at x (also `f(x)`)
;     g ∘ f                   the composition "g after f": first f, then g
;     injective(f, A)         f is injective on A: different elements have different values
;     surjective(f, A, B)     f is surjective from A onto B: every element of B is a value
;     bijective(f, A, B)      both
;
; From set.kurt: `x ∈ A`, `A ⊂ B`, `A ∩ B`, `A ∪ B`, `∅`, and the set `{x ∈ A | P(x)}` of the
; elements x of A with the property P(x). The image of S under f is the set
; `{y ∈ B | ∃ x ∈ S (f x = y)}`, the preimage of T is the set `{x ∈ A | f x ∈ T}`.
;
; The rules (with set.kurt, and with it prop.kurt, logic.kurt and equality.kurt):
;
;     "map"           f : A → B ∧ x ∈ A ⇒ f x ∈ B                     (proven below)
;     "injective"     injective(f, A) ⇔ ∀ x ∈ A ∀ y ∈ A (f x = f y ⇒ x = y)
;     "surjective"    surjective(f, A, B) ⇔ ∀ y ∈ B ∃ x ∈ A (f x = y)
;     "bijective"     bijective(f, A, B) ⇔ injective(f, A) ∧ surjective(f, A, B)
;     "comp"          f : A → B ∧ x ∈ A ⇒ (g ∘ f) x = g (f x)
;     "comp-map"      f : A → B ∧ g : B → C ⇒ g ∘ f : A → C
;
; and from set.kurt (the ones you will need most):
;
;     "extensionality"    A = B ⇔ ∀ c (c ∈ A ⇔ c ∈ B)
;     "subset"            A ⊂ B ⇔ ∀ c (c ∈ A ⇒ c ∈ B)
;     "separation"        a ∈ {x ∈ A | P(x)} ⇔ a ∈ A ∧ P(a)
;     "union"             c ∈ A ∪ B ⇔ c ∈ A ∨ c ∈ B
;     "in-intersection"   c ∈ A ∩ B ⇔ c ∈ A ∧ c ∈ B
;
; This file is the scene of the exercises: they load it with `load theory/maps`. Don't change it.
load set

infix ∘ 60 60           ; stronger than ∈, ∪, ∩: `g ∘ f : A → C` is `(g ∘ f) : (A → C)`
const ∘
arity injective 2, surjective 3, bijective 3
bool injective 0, surjective 0, bijective 0

; a map takes the elements of A to elements of B
show $f : $A → $B ∧ $x ∈ $A ⇒ $f $x ∈ $B                                       "map"
proof
    assume $f : $A → $B ∧ $x ∈ $A
        ($x, $f $x) ∈ $f ∧ $f $x ∈ $B                   ; apply-in (set.kurt)
        $f $x ∈ $B
qed

def injective($f, $A) ⇔ ∀ $x ∈ $A ∀ $y ∈ $A ($f $x = $f $y ⇒ $x = $y)          "injective"
def surjective($f, $A, $B) ⇔ ∀ $y ∈ $B ∃ $x ∈ $A ($f $x = $y)                  "surjective"
def bijective($f, $A, $B) ⇔ injective($f, $A) ∧ surjective($f, $A, $B)         "bijective"

; g ∘ f is the map from A to C that takes x to g (f x)
use $f : $A → $B ∧ $x ∈ $A ⇒ ($g ∘ $f) $x = $g ($f $x)                        "comp"
use $f : $A → $B ∧ $g : $B → $C ⇒ $g ∘ $f : $A → $C                            "comp-map"
