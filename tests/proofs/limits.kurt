; limits

load "forall"
load "arithmetics"
var ε, δ, x
show ∀ε>0 ∃δ>0 ∀x |x-2| < δ  ⇒  |(3x+1)-7| < ε
proof
    let ε>0
    def δ=ε/3
    let |x-2| < δ
    |x-2| < ε/3
    3 * |x-2| < ε
    |(3*x+1)-7| = |3*x - 6| 
        = 3 * |x - 2|
        < ε
    ∀x |x-2| < δ ⇒ |(3*x+1)-7| < ε
    ∃δ>0 ∀x |x-2| < δ ⇒ |(3*x+1)-7| < ε
    ∀ε>0 ∃δ ∀x |x-2| < δ ⇒ |(3*x+1)-7| < ε
qed

; more verbose proof
show ∀ε (ε>0 ⇒ ∃δ (δ>0 ∧ ∀x (|x-2|<δ ⇒ |(3x+1)-7|<ε)))
proof
    var ε
    assume ε>0
        const δ
        use δ=ε/3
        ε/3 > 0
        δ > 0
        var x
        |(3*x+1)-7| = |3*x - 6| = 3*|x - 2|
        assume |x-2| < δ
            |x-2| < ε/3
            3*|x-2| < ε
            |(3*x+1)-7| < ε
        |x-2|<δ ⇒ |(3*x+1)-7| < ε
        ∀x |x-2|<δ ⇒ |(3*x+1)-7| < ε
        ∃δ (δ>0 ∧ ∀x |x-2|<δ ⇒ |(3*x+1)-7| < ε)
    ε>0 ⇒ ∃δ (δ>0 ∧ ∀x |x-2|<δ ⇒ |(3*x+1)-7| < ε)
    ∀ε (ε>0 ⇒ ∃δ (δ>0 ∧ ∀x |x-2|<δ ⇒ |(3*x+1)-7| < ε))
qed
