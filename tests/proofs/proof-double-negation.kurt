load "propositional"
bool p

; what to show
show p or not p
proof
    show not (not (p or not p))
    proof
        assume not (p or not p)
        show p implies false
        proof
            assume p
            p or not p                                     ; by 12, "or-intro"
            contradiction                                  ; by 13, 5, "bottom-intro"
        qed
        not p                                              ; by 11, "not-intro"
        p or not p                                         ; by 15, "or-intro"
        contradiction                                      ; by 16, 5, "bottom-intro"
    qed
    p or not p                                             ; by 10, "not-not-elim"
qed
