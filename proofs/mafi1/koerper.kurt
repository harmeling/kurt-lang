; Körper -- fields (lecture "Mathematik für Informatik 1" (mafi1), deck 07-koerper, axioms (K1)-(K9))
;
; As on the slides, every axiom holds "for all λ ∈ K", so each one has its membership conditions:
; the scalars are the elements of `K`, nothing else.  A step that uses an axiom on a subterm
; needs the memberships as lines; the instance itself Kurt derives (shown as a step `17a`).
;
; The existential axioms are given by names, as the slides do after proving uniqueness:
; `0` and `1` (K3, K7), `- λ` (K4) and `inv λ` (K8).  `·` is `\cdot`.
load set
infix + 60 60
infix · 70 70
prefix - 72
const K, inv

use 0 ∈ K                                                           "K-zero"
use 1 ∈ K                                                           "K-one"
use $a ∈ K ∧ $b ∈ K  ⇒  $a + $b ∈ K                                 "K-plus"
use $a ∈ K ∧ $b ∈ K  ⇒  $a · $b ∈ K                                 "K-times"
use $a ∈ K  ⇒  - $a ∈ K                                             "K-minus"
use $a ∈ K ∧ $a ≠ 0  ⇒  inv $a ∈ K                                  "K-inv"

use $a ∈ K ∧ $b ∈ K ∧ $c ∈ K  ⇒  ($a + $b) + $c = $a + ($b + $c)    "K1"
use $a ∈ K ∧ $b ∈ K  ⇒  $a + $b = $b + $a                           "K2"
use $a ∈ K  ⇒  $a + 0 = $a                                          "K3"
use $a ∈ K  ⇒  $a + (- $a) = 0                                      "K4"
use $a ∈ K ∧ $b ∈ K ∧ $c ∈ K  ⇒  ($a · $b) · $c = $a · ($b · $c)    "K5"
use $a ∈ K ∧ $b ∈ K  ⇒  $a · $b = $b · $a                           "K6"
use 0 ≠ 1                                                           "K7a"
use $a ∈ K  ⇒  1 · $a = $a                                          "K7"
use $a ∈ K ∧ $a ≠ 0  ⇒  (inv $a) · $a = 1                           "K8"
use $a ∈ K ∧ $b ∈ K ∧ $c ∈ K  ⇒  $a · ($b + $c) = $a · $b + $a · $c   "K9"

; (K9) is distributivity from the left only; the slides also use it from the right, which
; needs (K6) as well
show $a ∈ K ∧ $b ∈ K ∧ $c ∈ K  ⇒  ($a + $b) · $c = $a · $c + $b · $c   "K9-right"
proof
    assume $a ∈ K ∧ $b ∈ K ∧ $c ∈ K
        $a ∈ K
        $b ∈ K
        $c ∈ K
        $a + $b ∈ K
        ($a + $b) · $c = $c · ($a + $b)                       ; K6
                    = $c · $a + $c · $b
                    = $a · $c + $c · $b
                    = $a · $c + $b · $c
qed

; Satz 2.25
show 0 = 0 + 0                                                      "zero-plus-zero"
proof
    0 + 0 = 0                                           ; K3
qed

; Satz 2.26
show $l ∈ K  ⇒  0 = 0 · $l                                          "zero-times"
proof
    assume $l ∈ K
        0 · $l ∈ K
        - (0 · $l) ∈ K
        0 · $l + 0 · $l ∈ K
        0 = 0 · $l + (- (0 · $l))
          = (0 + 0) · $l + (- (0 · $l))                   ; Satz 2.25
          = (0 · $l + 0 · $l) + (- (0 · $l))
          = 0 · $l + (0 · $l + (- (0 · $l)))
          = 0 · $l + 0
          = 0 · $l
qed

; λ 0 = 0 (from zero-times and K6)
show $a ∈ K  ⇒  $a · 0 = 0                                           "times-zero"
proof
    assume $a ∈ K
        0 = 0 · $a                                      ; zero-times
        $a · 0 = 0 · $a                                 ; K6
        $a · 0 = 0
qed

; Satz 2.24 (1): the zero is unique
show $z ∈ K ∧ (∀ $x ∈ K ($x + $z = $x))  ⇒  $z = 0                 "zero-unique"
proof
    assume $z ∈ K ∧ (∀ $x ∈ K ($x + $z = $x))
        $z ∈ K
        ∀ $x ∈ K ($x + $z = $x)
        0 + $z = 0                                      ; the property of $z for x = 0
        $z = $z + 0
           = 0 + $z
           = 0
qed

; Satz 2.24 (2): the one is unique
show $e ∈ K ∧ (∀ $x ∈ K ($e · $x = $x))  ⇒  $e = 1                 "one-unique"
proof
    assume $e ∈ K ∧ (∀ $x ∈ K ($e · $x = $x))
        $e ∈ K
        ∀ $x ∈ K ($e · $x = $x)
        $e · 1 = 1                                      ; the property of $e for x = 1
        $e = 1 · $e
           = $e · 1
           = 1
qed

; Satz 2.24 (3): the additive inverse is unique (as for vectors, deck 04)
show $l ∈ K ∧ $a ∈ K ∧ $b ∈ K ∧ $l + $a = 0 ∧ $l + $b = 0  ⇒  $a = $b   "minus-unique"
proof
    assume $l ∈ K ∧ $a ∈ K ∧ $b ∈ K ∧ $l + $a = 0 ∧ $l + $b = 0
        $l ∈ K
        $a ∈ K
        $b ∈ K
        $l + $a = 0
        $l + $b = 0
        $a = $a + 0
           = $a + ($l + $b)
           = ($a + $l) + $b
           = ($l + $a) + $b
           = 0 + $b
           = $b + 0
           = $b
qed

; Satz 2.24 (4): the multiplicative inverse is unique
show $l ∈ K ∧ $a ∈ K ∧ $b ∈ K ∧ $a · $l = 1 ∧ $b · $l = 1  ⇒  $a = $b   "inv-unique"
proof
    assume $l ∈ K ∧ $a ∈ K ∧ $b ∈ K ∧ $a · $l = 1 ∧ $b · $l = 1
        $l ∈ K
        $a ∈ K
        $b ∈ K
        $a · $l = 1
        $b · $l = 1
        $a = 1 · $a
           = ($b · $l) · $a
           = $b · ($l · $a)
           = $b · ($a · $l)
           = $b · 1
           = 1 · $b
           = $b
qed

; Satz 2.24 (5): (-1) λ = - λ
show $l ∈ K  ⇒  (- 1) · $l = - $l                                   "minus-one-times"
proof
    assume $l ∈ K
        - 1 ∈ K
        (- 1) · $l ∈ K
        - $l ∈ K
        1 + (- 1) ∈ K
        1 · $l = $l                                     ; K7
        $l + (- 1) · $l = 1 · $l + (- 1) · $l
                        = (1 + (- 1)) · $l
                        = 0 · $l
                        = 0
        $l + (- $l) = 0                                 ; K4
        (- 1) · $l = - $l                               ; minus-unique
qed

; Satz 2.24 (6): (-1)(-1) = 1
show (- 1) · (- 1) = 1                                              "minus-one-squared"
proof
    - 1 ∈ K
    - (- 1) ∈ K
    (- 1) · (- 1) = - (- 1)                             ; minus-one-times
    (- 1) + (- (- 1)) = 0                               ; K4
    (- 1) + 1 = 1 + (- 1)                               ; K2
    1 + (- 1) = 0                                       ; K4
    (- 1) + 1 = 0
    (- (- 1)) = 1                                       ; minus-unique
    (- 1) · (- 1) = 1
qed

; Satz 2.24 (7): a field has no zero divisors, λ μ = 0 ⇔ λ = 0 ∨ μ = 0
show $l ∈ K ∧ $m ∈ K ∧ $l · $m = 0  ⇒  $l = 0 ∨ $m = 0              "no-zero-divisors"
proof
    assume $l ∈ K ∧ $m ∈ K ∧ $l · $m = 0
        $l ∈ K
        $m ∈ K
        $l · $m = 0
        case $l = 0
            $l = 0 ∨ $m = 0
        case ¬($l = 0)
            ; as on the slide: from λ ≠ 0 we show μ = 0
            $l ≠ 0
            inv $l ∈ K                                  ; K-inv
            $m = 1 · $m
               = ((inv $l) · $l) · $m
               = (inv $l) · ($l · $m)
               = (inv $l) · 0
               = 0 · (inv $l)
               = 0
            $l = 0 ∨ $m = 0
        $l = 0 ∨ $m = 0
qed

; the other direction, which the slides don't prove
show $l ∈ K ∧ $m ∈ K ∧ ($l = 0 ∨ $m = 0)  ⇒  $l · $m = 0             "zero-divisor-free-back"
proof
    assume $l ∈ K ∧ $m ∈ K ∧ ($l = 0 ∨ $m = 0)
        $l ∈ K
        $m ∈ K
        $l = 0 ∨ $m = 0
        case $l = 0
            $l · $m = 0 · $m
                    = 0
        case $m = 0
            $l · $m = $l · 0
                    = 0 · $l
                    = 0
        $l · $m = 0
qed

; λ - μ = 0 only for λ = μ
show $l ∈ K ∧ $m ∈ K ∧ $l + (- $m) = 0  ⇒  $l = $m                   "minus-zero"
proof
    assume $l ∈ K ∧ $m ∈ K ∧ $l + (- $m) = 0
        $l ∈ K
        $m ∈ K
        $l + (- $m) = 0
        - $m ∈ K
        (- $m) + $l = $l + (- $m)                       ; K2
        (- $m) + $l = 0
        (- $m) + $m = $m + (- $m)                       ; K2
        $m + (- $m) = 0                                 ; K4
        (- $m) + $m = 0
        $l = $m                                         ; minus-unique, with -μ
qed

; x² = 1 only for x = 1 and x = -1, since x² - 1 = (x + 1)(x - 1) (used in deck 25)
show $x ∈ K ∧ $x · $x = 1  ⇒  $x = 1 ∨ $x = - 1                       "square-one"
proof
    assume $x ∈ K ∧ $x · $x = 1
        $x ∈ K
        $x · $x = 1
        - 1 ∈ K
        - $x ∈ K
        $x + 1 ∈ K
        $x + (- 1) ∈ K
        $x · $x ∈ K
        ($x + 1) · $x ∈ K
        ($x + 1) · (- 1) ∈ K
        (- $x) + (- 1) ∈ K
        ; (x + 1)(x - 1) = x x - 1 = 0
        ($x + 1) · ($x + (- 1)) = ($x + 1) · $x + ($x + 1) · (- 1)   ; K9
                                = ($x · $x + 1 · $x) + ($x + 1) · (- 1)
                                = ($x · $x + $x) + ($x + 1) · (- 1)
                                = ($x · $x + $x) + ($x · (- 1) + 1 · (- 1))
                                = ($x · $x + $x) + ((- 1) · $x + 1 · (- 1))
                                = ($x · $x + $x) + ((- $x) + 1 · (- 1))
                                = ($x · $x + $x) + ((- $x) + (- 1))
                                = $x · $x + ($x + ((- $x) + (- 1)))
                                = $x · $x + (($x + (- $x)) + (- 1))
                                = $x · $x + (0 + (- 1))
                                = $x · $x + ((- 1) + 0)
                                = $x · $x + (- 1)
                                = 1 + (- 1)
                                = 0
        $x + 1 = 0 ∨ $x + (- 1) = 0                     ; no-zero-divisors
        case $x + 1 = 0
            1 + $x = $x + 1                             ; K2
            1 + $x = 0
            $x = - 1                                    ; minus-unique, with 1
            $x = 1 ∨ $x = - 1
        case $x + (- 1) = 0
            $x = 1                                      ; minus-zero
            $x = 1 ∨ $x = - 1
        $x = 1 ∨ $x = - 1
qed
