;; gauss.kurt
; proof of Gauss' summation formula

load arith

; axioms about summations
const sum
arity sum 3
bindop sum
var a, b, i, g
use a > b ⇒ (sum i (a, b) g(i)) = 0                      "S1"
use sum i (a, b  ) g(i) = g(a)   + (sum i (a+1, b) g(i)) "S2"
use sum i (a, b+1) g(i) = g(b+1) + (sum i (a, b) g(i))   "S3"

; induction
var F, k, n
use F(0) ∧ (∀ k (F(k) ⇒ F(k+1))) ⇒ F(n)         "induction"

; define the statement
var x
def gauss(n) ≡ sum x (0, n) x = n * (n+1) / 2

show gauss(n)
proof
    show gauss(0)
    proof
        (sum x (0, 0) x) = 0 + (sum x (0+1, 0) x)           ; by S2
                         = 0 + 0                          ; by S1
                         = 0                              ; by arith
                         = 0 * (0+1) / 2                  ; by arith
    qed
    show gauss(i) ⇒ gauss(i+1)
    proof
        let i with gauss(i)
            (sum x (0, i+1) x) = i + 1 + (sum x (0, i) x) ; by S3
                = i + 1 + i * (i+1) / 2                   ; by assumption
                = 2*(i+1)/2 + i * (i+1) / 2               ; by arith
                = (2*(i+1) + i * (i+1)) / 2               ; by arith
                = (2+i) * (i+1) / 2                       ; by arith
                = (i+1) * ((i+1)+1) / 2                   ; by arith
            gauss(i+1)                                    ; by definition
    qed
    gauss(0)  ∧  (gauss(i) ⇒ gauss(i+1))
    gauss(n)                                              ; by induction
qed
;;; Proof checked.