; the inverse matrix (course "Mathematik für Informatik 1" (mafi1), lecture 15)
load matrices

; the inverse is unique (lecture 12, Theorem 5.12, 3.): B A = E gives B = A⁻¹
show $A ∈ GL ∧ $B ∈ Mat ∧ $B · $A = E  ⇒  $B = inv $A                 "inv-unique-left"
proof
    assume $A ∈ GL ∧ $B ∈ Mat ∧ $B · $A = E
        $A ∈ GL
        $B ∈ Mat
        $B · $A = E
        $A ∈ Mat
        inv $A ∈ Mat
        $B = $B · E
           = $B · ($A · (inv $A))                       ; inv-right
           = ($B · $A) · (inv $A)                       ; M1
           = E · (inv $A)
           = inv $A
qed

; and A B = E gives B = A⁻¹
show $A ∈ GL ∧ $B ∈ Mat ∧ $A · $B = E  ⇒  $B = inv $A                 "inv-unique-right"
proof
    assume $A ∈ GL ∧ $B ∈ Mat ∧ $A · $B = E
        $A ∈ GL
        $B ∈ Mat
        $A · $B = E
        $A ∈ Mat
        inv $A ∈ Mat
        inv $A = (inv $A) · E
               = (inv $A) · ($A · $B)
               = ((inv $A) · $A) · $B                   ; M1
               = E · $B                                 ; inv-left
               = $B
qed

; Lemma 5.36: A B = C stays true if the same row operations U (U = U_k ⋯ U_1) turn A into
; A' = U A and C into C' = U C
show $A ∈ Mat ∧ $B ∈ Mat ∧ $U ∈ Mat ∧ $A · $B = $C  ⇒  ($U · $A) · $B = $U · $C   "same-row-operations"
proof
    assume $A ∈ Mat ∧ $B ∈ Mat ∧ $U ∈ Mat ∧ $A · $B = $C
        $A ∈ Mat
        $B ∈ Mat
        $U ∈ Mat
        $A · $B = $C
        ($U · $A) · $B = $U · ($A · $B)                 ; M1
                       = $U · $C
qed

; Algorithm 5.37 (Gauss-Jordan): if the row operations U turn A into E, then A⁻¹ = U E
show $A ∈ GL ∧ $U ∈ Mat ∧ $U · $A = E  ⇒  inv $A = $U · E             "gauss-jordan"
proof
    assume $A ∈ GL ∧ $U ∈ Mat ∧ $U · $A = E
        $A ∈ GL
        $U ∈ Mat
        $U · $A = E
        $A ∈ Mat
        inv $A ∈ Mat
        inv $A = E · (inv $A)
               = ($U · $A) · (inv $A)
               = $U · ($A · (inv $A))                   ; M1
               = $U · E                                 ; inv-right
qed

; Theorem 5.39: the inverse of a symmetric matrix is symmetric
show $A ∈ GL ∧ T($A) = $A  ⇒  inv $A = T(inv $A)                     "symmetric-inverse"
proof
    assume $A ∈ GL ∧ T($A) = $A
        $A ∈ GL
        T($A) = $A
        $A ∈ Mat
        inv $A ∈ Mat
        T(inv $A) ∈ Mat
        E = T(E)                                        ; T-E
          = T((inv $A) · $A)                            ; inv-left
          = T($A) · T(inv $A)                           ; T-times
          = $A · T(inv $A)
        ; the inverse is unique
        T(inv $A) = inv $A                              ; inv-unique-right
qed

; (Aᵀ)⁻¹ = (A⁻¹)ᵀ: Aᵀ has the inverse (A⁻¹)ᵀ, since Aᵀ (A⁻¹)ᵀ = (A⁻¹ A)ᵀ = E ("one-sided-inverse")
show $A ∈ GL  ⇒  T($A) ∈ GL ∧ inv T($A) = T(inv $A)                    "transpose-inverse"
proof
    assume $A ∈ GL
        $A ∈ Mat
        inv $A ∈ Mat
        T($A) ∈ Mat
        T(inv $A) ∈ Mat
        T($A) · T(inv $A) = T((inv $A) · $A)            ; T-times
                          = T(E)                        ; inv-left
                          = E                           ; T-E
        T($A) ∈ GL                                      ; one-sided-inverse
        T(inv $A) = inv T($A)                           ; inv-unique-right
        T($A) ∈ GL ∧ inv T($A) = T(inv $A)
qed
