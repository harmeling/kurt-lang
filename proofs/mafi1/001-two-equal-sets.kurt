;;; two-equal sets
load set
var A, B, C, M, N

show A ∩ (B ∪ C) = (A ∩ B) ∪ (A ∩ C)   "set-distribution"
proof
    show A ∩ (B ∪ C) ⊂ (A ∩ B) ∪ (A ∩ C)
    proof
        let x
            assume x ∈ A ∩ (B ∪ C)
                x ∈ A  ∧  x ∈ B ∪ C
                x ∈ A
                x ∈ B ∪ C
                case x ∈ B
                    x ∈ A  ∧  x ∈ B
                    x ∈ A ∩ B
                    x ∈ (A ∩ B) ∪ (A ∩ C)
                case x ∈ C
                    x ∈ A  ∧  x ∈ C
                    x ∈ A ∩ C
                    x ∈ (A ∩ B) ∪ (A ∩ C)
                x ∈ (A ∩ B) ∪ (A ∩ C)
    qed
    show (A ∩ B) ∪ (A ∩ C) ⊂ A ∩ (B ∪ C)
    proof
        let x
            assume x ∈ (A ∩ B) ∪ (A ∩ C)
                assume x ∈ A ∩ B
                    x ∈ A  ∧  x ∈ B
                    x ∈ A
                    x ∈ B ∪ C
                    x ∈ A ∩ (B ∪ C)
                assume x ∈ A ∩ C
                    x ∈ A  ∧  x ∈ C
                    x ∈ A
                    x ∈ B ∪ C
                    x ∈ A ∩ (B ∪ C)
    qed
qed
;;; Proof checked.