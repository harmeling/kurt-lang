; subspaces (course "Mathematik für Informatik 1" (mafi1), lecture 06)
load vectorspace
const V
use vectorspace(V)                                                  "V-vectorspace"
arity subspace 1

; two facts about ∅, for (U1) (they belong to set.kurt)
show $U ≠ ∅  ⇒  ∃ $x ($x ∈ $U)                                       "nonempty-element"
proof
    assume $U ≠ ∅
        assume not ∃ $x ($x ∈ $U)
            let c
                assume c ∈ $U
                    ∃ $x ($x ∈ $U)
                    false
                    c ∈ ∅
            $U ⊂ ∅
            let c
                assume c ∈ ∅
                    false
                    c ∈ $U
            ∅ ⊂ $U
            $U = ∅
            not ($U = ∅)
            false
        ∃ $x ($x ∈ $U)
qed

show $x ∈ $U  ⇒  $U ≠ ∅                                              "element-nonempty"
proof
    assume $x ∈ $U
        assume $U = ∅
            $x ∈ ∅
            false
        not ($U = ∅)
        $U ≠ ∅
qed

; Definition: U ⊂ V is a subspace of V if (U1), (U2) and (U3) hold
def subspace($U)  ⇔  $U ⊂ V ∧ $U ≠ ∅ ∧ (∀ $x ∈ $U ∀ $y ∈ $U ($x + $y ∈ $U)) ∧ (∀ $a ∈ K ∀ $x ∈ $U ($a · $x ∈ $U))   "subspace"

; the parts of the definition, for use in the proofs below
show subspace($U) ∧ $x ∈ $U  ⇒  $x ∈ V                              "U-in-V"
proof
    assume subspace($U) ∧ $x ∈ $U
        subspace($U)
        $U ⊂ V ∧ $U ≠ ∅ ∧ (∀ $y ∈ $U ∀ $z ∈ $U ($y + $z ∈ $U)) ∧ (∀ $a ∈ K ∀ $y ∈ $U ($a · $y ∈ $U))
        $U ⊂ V
        ∀ $c ($c ∈ $U  implies  $c ∈ V)
        $x ∈ $U
        $x ∈ V
qed

show subspace($U) ∧ $x ∈ $U ∧ $y ∈ $U  ⇒  $x + $y ∈ $U               "U2"
proof
    assume subspace($U) ∧ $x ∈ $U ∧ $y ∈ $U
        subspace($U)
        $U ⊂ V ∧ $U ≠ ∅ ∧ (∀ $v ∈ $U ∀ $w ∈ $U ($v + $w ∈ $U)) ∧ (∀ $a ∈ K ∀ $v ∈ $U ($a · $v ∈ $U))
        ∀ $v ∈ $U ∀ $w ∈ $U ($v + $w ∈ $U)
        $x ∈ $U
        ∀ $w ∈ $U ($x + $w ∈ $U)
        $y ∈ $U
        $x + $y ∈ $U
qed

show subspace($U) ∧ $a ∈ K ∧ $x ∈ $U  ⇒  $a · $x ∈ $U                "U3"
proof
    assume subspace($U) ∧ $a ∈ K ∧ $x ∈ $U
        subspace($U)
        $U ⊂ V ∧ $U ≠ ∅ ∧ (∀ $v ∈ $U ∀ $w ∈ $U ($v + $w ∈ $U)) ∧ (∀ $b ∈ K ∀ $v ∈ $U ($b · $v ∈ $U))
        ∀ $b ∈ K ∀ $v ∈ $U ($b · $v ∈ $U)
        $a ∈ K
        ∀ $v ∈ $U ($a · $v ∈ $U)
        $x ∈ $U
        $a · $x ∈ $U
qed

; Lemma: 0 ∈ U
show subspace($U)  ⇒  0 ∈ $U                                         "U-zero"
proof
    assume subspace($U)
        $U ⊂ V ∧ $U ≠ ∅ ∧ (∀ $v ∈ $U ∀ $w ∈ $U ($v + $w ∈ $U)) ∧ (∀ $a ∈ K ∀ $v ∈ $U ($a · $v ∈ $U))
        $U ≠ ∅                                          ; (U1)
        ∃ $x ($x ∈ $U)
        pick x with x ∈ $U
            x ∈ V
            0 · x = 0                                   ; computed on the slide: zero-times-vector
            0 · x ∈ $U                                  ; (U3)
            0 ∈ $U
qed

; Lemma: ∀ x ∈ U : -x ∈ U
show subspace($U) ∧ $x ∈ $U  ⇒  - $x ∈ $U                            "U-minus"
proof
    assume subspace($U) ∧ $x ∈ $U
        subspace($U)
        $x ∈ $U
        $x ∈ V
        - 1 ∈ K
        (- 1) · $x = - $x                               ; computed on the slide: minus-one-times-vector
        (- 1) · $x ∈ $U                                 ; (U3)
        - $x ∈ $U
qed

; Theorem: a subspace is a vector space -- (V3) and (V4) hold in U by the two lemmas, and all
; other axioms hold for all elements of V and so for those of U, e.g. (V1)
show subspace($U)  ⇒  (∃ $o ∈ $U ∀ $x ∈ $U ($x + $o = $x)) ∧ (∀ $x ∈ $U ∃ $y ∈ $U ($x + $y = 0)) ∧ (∀ $x ∈ $U ∀ $y ∈ $U ∀ $z ∈ $U (($x + $y) + $z = $x + ($y + $z)))   "subspace-vectorspace"
proof
    assume subspace($U)
        ; (V3)
        0 ∈ $U                                          ; first lemma
        let x ∈ $U
            x ∈ V
            x + 0 = x
        ∃ $o ∈ $U ∀ $x ∈ $U ($x + $o = $x)
        ; (V4)
        let x ∈ $U
            x ∈ V
            x + (- x) = 0
            - x ∈ $U                                    ; second lemma
            ∃ $y ∈ $U (x + $y = 0)
        ; (V1)
        let x ∈ $U
            let y ∈ $U
                let z ∈ $U
                    x ∈ V
                    y ∈ V
                    z ∈ V
                    (x + y) + z = x + (y + z)
        (∃ $o ∈ $U ∀ $x ∈ $U ($x + $o = $x)) ∧ (∀ $x ∈ $U ∃ $y ∈ $U ($x + $y = 0)) ∧ (∀ $x ∈ $U ∀ $y ∈ $U ∀ $z ∈ $U (($x + $y) + $z = $x + ($y + $z)))
qed

; exercise ("Beweis?"): the intersection of two subspaces is a subspace
show subspace($U) ∧ subspace($W)  ⇒  subspace($U ∩ $W)               "intersection-subspace"
proof
    assume subspace($U) ∧ subspace($W)
        subspace($U)
        subspace($W)
        ; U ∩ W ⊂ V
        let c
            assume c ∈ $U ∩ $W
                c ∈ $U ∧ c ∈ $W
                c ∈ $U
                c ∈ V
        $U ∩ $W ⊂ V
        ; (U1): 0 is in both
        0 ∈ $U
        0 ∈ $W
        0 ∈ $U ∩ $W
        $U ∩ $W ≠ ∅
        ; (U2)
        let x ∈ $U ∩ $W
            let y ∈ $U ∩ $W
                x ∈ $U ∧ x ∈ $W
                y ∈ $U ∧ y ∈ $W
                x ∈ $U
                x ∈ $W
                y ∈ $U
                y ∈ $W
                x + y ∈ $U
                x + y ∈ $W
                x + y ∈ $U ∩ $W
        ; (U3)
        let a ∈ K
            let x ∈ $U ∩ $W
                x ∈ $U ∧ x ∈ $W
                x ∈ $U
                x ∈ $W
                a · x ∈ $U
                a · x ∈ $W
                a · x ∈ $U ∩ $W
        subspace($U ∩ $W)
qed
