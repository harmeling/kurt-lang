; tautologies -- the tautologies that the course "Mathematik für Informatik 1" (mafi1) takes as
; given, checked "by truth tables" (lecture 03, "Andere nützliche Formeln"; lecture 11a,
; "Beispiele für Tautologien", "Immer wahr und immer falsch"); Kurt has no truth tables,
; so they are proven here by natural deduction.  ¬¬A ≡ A ("Doppelte Negation") is
; "not-not" of prop.kurt, the two with quantifiers are in 03-formulas.kurt.
; 11a-proofs.kurt then derives the other laws from them, as the slides do.
load logic

; De Morgansche Gesetze
show ¬(%A ∧ %B)  ⇔  ¬%A ∨ ¬%B                                        "de-morgan-and"
proof
    assume ¬(%A ∧ %B)
        assume %A
            assume %B
                %A ∧ %B
                ⊥
            ¬%B
            ¬%A ∨ ¬%B
        assume ¬%A
            ¬%A ∨ ¬%B
        %A ∨ ¬%A                                        ; excluded-middle
        ¬%A ∨ ¬%B
    assume ¬%A ∨ ¬%B
        assume ¬%A
            assume %A ∧ %B
                %A
                ⊥
            ¬(%A ∧ %B)
        assume ¬%B
            assume %A ∧ %B
                %B
                ⊥
            ¬(%A ∧ %B)
        ¬(%A ∧ %B)
qed

show ¬(%A ∨ %B)  ⇔  ¬%A ∧ ¬%B                                        "de-morgan-or"
proof
    assume ¬(%A ∨ %B)
        assume %A
            %A ∨ %B
            ⊥
        ¬%A
        assume %B
            %A ∨ %B
            ⊥
        ¬%B
        ¬%A ∧ ¬%B
    assume ¬%A ∧ ¬%B
        ¬%A
        ¬%B
        assume %A ∨ %B
            assume %A
                ⊥
            assume %B
                ⊥
            ⊥
        ¬(%A ∨ %B)
qed

; Distributivgesetze
show %A ∨ (%B ∧ %C)  ⇔  (%A ∨ %B) ∧ (%A ∨ %C)                        "distrib-or"
proof
    assume %A ∨ (%B ∧ %C)
        assume %A
            %A ∨ %B
            %A ∨ %C
            (%A ∨ %B) ∧ (%A ∨ %C)
        assume %B ∧ %C
            %B
            %C
            %A ∨ %B
            %A ∨ %C
            (%A ∨ %B) ∧ (%A ∨ %C)
        (%A ∨ %B) ∧ (%A ∨ %C)
    assume (%A ∨ %B) ∧ (%A ∨ %C)
        %A ∨ %B
        %A ∨ %C
        assume %A
            %A ∨ (%B ∧ %C)
        assume %B
            assume %C
                %A ∨ (%B ∧ %C)
            %A ∨ (%B ∧ %C)
        %A ∨ (%B ∧ %C)
qed

show %A ∧ (%B ∨ %C)  ⇔  (%A ∧ %B) ∨ (%A ∧ %C)                        "distrib-and"
proof
    assume %A ∧ (%B ∨ %C)
        %A
        %B ∨ %C
        assume %B
            (%A ∧ %B) ∨ (%A ∧ %C)
        assume %C
            (%A ∧ %B) ∨ (%A ∧ %C)
        (%A ∧ %B) ∨ (%A ∧ %C)
    assume (%A ∧ %B) ∨ (%A ∧ %C)
        assume %A ∧ %B
            %B
            %A ∧ (%B ∨ %C)
        assume %A ∧ %C
            %C
            %A ∧ (%B ∨ %C)
        %A ∧ (%B ∨ %C)
qed

; the implication as a disjunction
show (%A ⇒ %B)  ⇔  ¬%A ∨ %B                                          "impl-or"
proof
    assume %A ⇒ %B
        assume %A
            %B
            ¬%A ∨ %B
        assume ¬%A
            ¬%A ∨ %B
        %A ∨ ¬%A                                        ; excluded-middle
        ¬%A ∨ %B
    assume ¬%A ∨ %B
        assume %A
            assume ¬%A
                ⊥
                %B
            assume %B
                %B
            %B
        %A ⇒ %B
qed

show ¬(%A ⇒ %B)  ⇔  %A ∧ ¬%B                                         "not-impl"
proof
    assume ¬(%A ⇒ %B)
        assume ¬%A
            assume %A
                ⊥
                %B
            %A ⇒ %B
            ⊥
        %A
        assume %B
            assume %A
                %B
            %A ⇒ %B
            ⊥
        ¬%B
        %A ∧ ¬%B
    assume %A ∧ ¬%B
        %A
        ¬%B
        assume %A ⇒ %B
            %B
            ⊥
        ¬(%A ⇒ %B)
qed

; true and false (lecture 11a)
show ¬⊤  ⇔  ⊥                                                         "not-top"
proof
    assume ¬⊤
        ⊤
        ⊥
    assume ⊥
        ¬⊤
qed

show ¬⊥  ⇔  ⊤                                                         "not-bottom"
proof
    assume ¬⊥
        ⊤
    assume ⊤
        assume ⊥
            ⊥
        ¬⊥
qed

show %A ∧ ⊤  ⇔  %A                                                    "and-top"
proof
    assume %A ∧ ⊤
        %A
    assume %A
        %A ∧ ⊤
qed

show %A ∨ ⊤  ⇔  ⊤                                                     "or-top"
proof
    assume %A ∨ ⊤
        ⊤
    assume ⊤
        %A ∨ ⊤
qed

show %A ∧ ⊥  ⇔  ⊥                                                     "and-bottom"
proof
    assume %A ∧ ⊥
        ⊥
    assume ⊥
        %A ∧ ⊥
qed

show %A ∨ ⊥  ⇔  %A                                                    "or-bottom"
proof
    assume %A ∨ ⊥
        assume %A
            %A
        assume ⊥
            %A
        %A
    assume %A
        %A ∨ ⊥
qed
