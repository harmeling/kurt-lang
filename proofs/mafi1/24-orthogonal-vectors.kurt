; orthogonal vectors, the orthogonal complement (course "Mathematik für Informatik 1" (mafi1), lecture 24); orthogonality and Pythagoras are in scalar-product.kurt
load scalar-product
arity Perp 1

; Definition: M^⊥ := { v ∈ V | ∀ u ∈ M : v ⊥ u }, the orthogonal complement of M ⊂ V
; (with v ⊥ u written out as ⟨v, u⟩ = 0)
def Perp($M) = { $v ∈ V | ∀ $u ∈ $M (⟨$v, $u⟩ = 0) }                 "Perp"

; v ∈ M^⊥ written out, for the proofs below
show $v ∈ Perp($M)  ⇔  $v ∈ V ∧ ∀ $u ∈ $M (⟨$v, $u⟩ = 0)              "Perp-elem"
proof
    assume $v ∈ Perp($M)
        $v ∈ { $z ∈ V | ∀ $u ∈ $M (⟨$z, $u⟩ = 0) }     ; Perp
        $v ∈ V ∧ ∀ $u ∈ $M (⟨$v, $u⟩ = 0)              ; separation
    assume $v ∈ V ∧ ∀ $u ∈ $M (⟨$v, $u⟩ = 0)
        $v ∈ { $z ∈ V | ∀ $u ∈ $M (⟨$z, $u⟩ = 0) }     ; separation
        $v ∈ Perp($M)                                   ; Perp
qed

; Satz: M^⊥ is a subspace of V
show $M ⊂ V  ⇒  subspace(Perp($M))                                   "Perp-subspace"
proof
    assume $M ⊂ V
        ∀ $c ($c ∈ $M  implies  $c ∈ V)
        ; M^⊥ ⊂ V, which the slide takes from the definition
        let c
            assume c ∈ Perp($M)
                c ∈ V ∧ ∀ $u ∈ $M (⟨c, $u⟩ = 0)
                c ∈ V
        Perp($M) ⊂ V
        ; (U1): ⟨0, u⟩ = 0, so 0 ⊥ M and M^⊥ ≠ ∅
        let u ∈ $M
            u ∈ V
            ⟨0, u⟩ = 0                                  ; S-zero-left
        0 ∈ V ∧ ∀ $u ∈ $M (⟨0, $u⟩ = 0)
        0 ∈ Perp($M)
        Perp($M) ≠ ∅
        ; (U2): let x, y ∈ M^⊥ and u ∈ M (the slide does (U2) and (U3) together)
        let x ∈ Perp($M)
            let y ∈ Perp($M)
                x ∈ V ∧ ∀ $u ∈ $M (⟨x, $u⟩ = 0)
                y ∈ V ∧ ∀ $u ∈ $M (⟨y, $u⟩ = 0)
                x ∈ V
                y ∈ V
                ∀ $u ∈ $M (⟨x, $u⟩ = 0)
                ∀ $u ∈ $M (⟨y, $u⟩ = 0)
                let u ∈ $M
                    u ∈ V
                    ⟨x, u⟩ = 0
                    ⟨y, u⟩ = 0
                    ⟨x + y, u⟩ = ⟨x, u⟩ + ⟨y, u⟩        ; (S1)
                               = 0 + ⟨y, u⟩
                               = 0 + 0
                               = 0
                x + y ∈ V ∧ ∀ $u ∈ $M (⟨x + y, $u⟩ = 0)
                x + y ∈ Perp($M)
        ; (U3): let λ ∈ K, x ∈ M^⊥ and u ∈ M
        let λ ∈ K
            let x ∈ Perp($M)
                x ∈ V ∧ ∀ $u ∈ $M (⟨x, $u⟩ = 0)
                x ∈ V
                ∀ $u ∈ $M (⟨x, $u⟩ = 0)
                let u ∈ $M
                    u ∈ V
                    ⟨x, u⟩ = 0
                    ⟨λ · x, u⟩ = λ · ⟨x, u⟩             ; (S1)
                               = λ · 0
                               = 0
                λ · x ∈ V ∧ ∀ $u ∈ $M (⟨λ · x, $u⟩ = 0)
                λ · x ∈ Perp($M)
        subspace(Perp($M))
qed

; Satz: 0 ∈ M ⇒ M ∩ M^⊥ = {0}, with the set {0} written out
show $M ⊂ V ∧ 0 ∈ $M  ⇒  ∀ $v ($v ∈ $M ∩ Perp($M)  ⇔  $v = 0)        "Perp-meet"
proof
    assume $M ⊂ V ∧ 0 ∈ $M
        $M ⊂ V
        0 ∈ $M
        let v
            ; "⊂": let v ∈ M ∩ M^⊥
            assume v ∈ $M ∩ Perp($M)
                v ∈ $M ∧ v ∈ Perp($M)
                v ∈ $M
                v ∈ Perp($M)
                v ∈ V ∧ ∀ $u ∈ $M (⟨v, $u⟩ = 0)
                v ∈ V
                ∀ $u ∈ $M (⟨v, $u⟩ = 0)
                ⟨v, v⟩ = 0                              ; in particular v ⊥ v
                v = 0                                   ; S3-zero
            ; "⊃", which the slide doesn't write out: 0 is in both
            assume v = 0
                subspace(Perp($M))                      ; Perp-subspace
                0 ∈ Perp($M)                            ; U-zero
                0 ∈ $M ∩ Perp($M)
                v ∈ $M ∩ Perp($M)
            v ∈ $M ∩ Perp($M)  ⇔  v = 0
qed
