; eigenvalues and eigenvectors (course "Mathematik für Informatik 1" (mafi1), lecture 26)
;
; "Sei f: V → V ein Endomorphismus."
load 06-subspaces
const f
arity f 1
use $x ∈ V  ⇒  f($x) ∈ V                                             "f-map"
use $x ∈ V ∧ $y ∈ V  ⇒  f($x + $y) = f($x) + f($y)                   "f-additive"
use $a ∈ K ∧ $x ∈ V  ⇒  f($a · $x) = $a · f($x)                      "f-homogeneous"

; Definition: v is an eigenvector of f for the eigenvalue λ
arity eigenvector 2
def eigenvector($v, $l)  ⇔  f($v) = $l · $v ∧ $v ≠ 0                 "eigenvector"

; Definition: the eigenspace E_λ = Kern(f - λ Id)
arity E 1
def E($l) = { $v ∈ V | f($v) = $l · $v }                             "eigenspace"

; Satz: λ ≠ μ ⇒ E_λ ∩ E_μ = {0}, i.e. (as on the slide) v ∈ E_λ ∩ E_μ ⇔ v = 0
show $l ∈ K ∧ $m ∈ K ∧ $l ≠ $m  ⇒  ∀ $v ($v ∈ E($l) ∩ E($m)  ⇔  $v = 0)   "eigenspaces-meet"
proof
    assume $l ∈ K ∧ $m ∈ K ∧ $l ≠ $m
        $l ∈ K
        $m ∈ K
        $l ≠ $m
        let v
            ; "⇒"
            assume v ∈ E($l) ∩ E($m)
                v ∈ E($l) ∧ v ∈ E($m)
                v ∈ E($l)
                v ∈ { $w ∈ V | f($w) = $l · $w }
                v ∈ V ∧ f(v) = $l · v                   ; separation
                v ∈ E($m)
                v ∈ { $w ∈ V | f($w) = $m · $w }
                v ∈ V ∧ f(v) = $m · v
                v ∈ V
                f(v) = $l · v
                f(v) = $m · v
                $l · v = $m · v
                ; (λ - μ) v = λ v - μ v = 0
                - $m ∈ K
                $m · v ∈ V
                $l - $m ∈ K
                $l - $m = $l + (- $m)
                ($l - $m) · v = ($l + (- $m)) · v
                              = $l · v + (- $m) · v
                              = $l · v + (- ($m · v))
                              = $m · v + (- ($m · v))
                              = 0
                ; v = 0, since λ - μ ≠ 0
                $l - $m ≠ 0                             ; difference-nonzero
                inv ($l - $m) ∈ K
                v = 1 · v
                  = (inv ($l - $m) · ($l - $m)) · v
                  = inv ($l - $m) · (($l - $m) · v)
                  = inv ($l - $m) · 0
                  = 0
            ; "⇐": f(0) = 0 = λ 0 and f(0) = 0 = μ 0
            assume v = 0
                0 ∈ V
                0 · 0 = 0                               ; zero-times-vector
                f(0) ∈ V
                f(0) = f(0 · 0)
                     = 0 · f(0)
                     = 0
                f(0) = $l · 0
                f(0) = $m · 0
                0 ∈ { $w ∈ V | f($w) = $l · $w }        ; separation
                0 ∈ E($l)
                0 ∈ { $w ∈ V | f($w) = $m · $w }
                0 ∈ E($m)
                0 ∈ E($l) ∩ E($m)
                v ∈ E($l) ∩ E($m)
            v ∈ E($l) ∩ E($m)  ⇔  v = 0
qed
