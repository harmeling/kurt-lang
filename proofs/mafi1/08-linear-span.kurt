; the span (course "Mathematik für Informatik 1" (mafi1), lecture 08: linear independence),
; for two vectors: L(v1, v2) = { λ1 v1 + λ2 v2 | λ1, λ2 ∈ K }
; (the slides take r vectors, which needs sums with indices; their scalars λi, μi, κ are
; written ai, bi, k here, since Kurt reads λ1 as λ 1)
load 06-subspaces
arity L 2
def L($v1, $v2) = { $u ∈ V | ∃ $a1 ∃ $a2 ($a1 ∈ K ∧ $a2 ∈ K ∧ $u = $a1 · $v1 + $a2 · $v2) }   "span"

; Theorem: for v1, v2 ∈ V, U := L(v1, v2) is a subspace of V
show $v1 ∈ V ∧ $v2 ∈ V  ⇒  subspace(L($v1, $v2))                     "span-subspace"
proof
    assume $v1 ∈ V ∧ $v2 ∈ V
        $v1 ∈ V
        $v2 ∈ V
        ; U ⊂ V
        let c
            assume c ∈ L($v1, $v2)
                c ∈ { $u ∈ V | ∃ $a1 ∃ $a2 ($a1 ∈ K ∧ $a2 ∈ K ∧ $u = $a1 · $v1 + $a2 · $v2) }
                c ∈ V ∧ ∃ $a1 ∃ $a2 ($a1 ∈ K ∧ $a2 ∈ K ∧ c = $a1 · $v1 + $a2 · $v2)
                c ∈ V
        L($v1, $v2) ⊂ V
        ; (U1): v1 + v2 = 1 v1 + 1 v2 ∈ U, so U ≠ ∅
        1 · $v1 = $v1                                   ; (V6)
        $v1 + $v2 = 1 · $v1 + $v2
                  = 1 · $v1 + 1 · $v2                   ; (V6)
        1 ∈ K ∧ 1 ∈ K ∧ $v1 + $v2 = 1 · $v1 + 1 · $v2
        ∃ $a2 (1 ∈ K ∧ $a2 ∈ K ∧ $v1 + $v2 = 1 · $v1 + $a2 · $v2)
        ∃ $a1 ∃ $a2 ($a1 ∈ K ∧ $a2 ∈ K ∧ $v1 + $v2 = $a1 · $v1 + $a2 · $v2)
        $v1 + $v2 ∈ V
        $v1 + $v2 ∈ { $u ∈ V | ∃ $a1 ∃ $a2 ($a1 ∈ K ∧ $a2 ∈ K ∧ $u = $a1 · $v1 + $a2 · $v2) }
        $v1 + $v2 ∈ L($v1, $v2)
        L($v1, $v2) ≠ ∅
        ; (U2): (a1 v1 + a2 v2) + (b1 v1 + b2 v2) = (a1 + b1) v1 + (a2 + b2) v2
        let x ∈ L($v1, $v2)
            let y ∈ L($v1, $v2)
                x ∈ { $u ∈ V | ∃ $a1 ∃ $a2 ($a1 ∈ K ∧ $a2 ∈ K ∧ $u = $a1 · $v1 + $a2 · $v2) }
                y ∈ { $u ∈ V | ∃ $a1 ∃ $a2 ($a1 ∈ K ∧ $a2 ∈ K ∧ $u = $a1 · $v1 + $a2 · $v2) }
                x ∈ V ∧ ∃ $a1 ∃ $a2 ($a1 ∈ K ∧ $a2 ∈ K ∧ x = $a1 · $v1 + $a2 · $v2)
                y ∈ V ∧ ∃ $b1 ∃ $b2 ($b1 ∈ K ∧ $b2 ∈ K ∧ y = $b1 · $v1 + $b2 · $v2)
                x ∈ V
                y ∈ V
                x + y ∈ V
                ∃ $a1 ∃ $a2 ($a1 ∈ K ∧ $a2 ∈ K ∧ x = $a1 · $v1 + $a2 · $v2)
                ∃ $b1 ∃ $b2 ($b1 ∈ K ∧ $b2 ∈ K ∧ y = $b1 · $v1 + $b2 · $v2)
                pick a1 with ∃ $a2 (a1 ∈ K ∧ $a2 ∈ K ∧ x = a1 · $v1 + $a2 · $v2)
                    pick a2 with a1 ∈ K ∧ a2 ∈ K ∧ x = a1 · $v1 + a2 · $v2
                        pick b1 with ∃ $b2 (b1 ∈ K ∧ $b2 ∈ K ∧ y = b1 · $v1 + $b2 · $v2)
                            pick b2 with b1 ∈ K ∧ b2 ∈ K ∧ y = b1 · $v1 + b2 · $v2
                                a1 ∈ K
                                a2 ∈ K
                                b1 ∈ K
                                b2 ∈ K
                                x = a1 · $v1 + a2 · $v2
                                y = b1 · $v1 + b2 · $v2
                                a1 · $v1 ∈ V
                                a2 · $v2 ∈ V
                                b1 · $v1 ∈ V
                                b2 · $v2 ∈ V
                                (a1 · $v1 + a2 · $v2) + (b1 · $v1 + b2 · $v2) = (a1 · $v1 + b1 · $v1) + (a2 · $v2 + b2 · $v2)   ; (V1), (V2): vector-shuffle
                                x + y = (a1 · $v1 + a2 · $v2) + y
                                      = (a1 · $v1 + a2 · $v2) + (b1 · $v1 + b2 · $v2)
                                      = (a1 · $v1 + b1 · $v1) + (a2 · $v2 + b2 · $v2)
                                      = (a1 + b1) · $v1 + (a2 · $v2 + b2 · $v2)         ; (V8)
                                      = (a1 + b1) · $v1 + (a2 + b2) · $v2               ; (V8)
                                a1 + b1 ∈ K
                                a2 + b2 ∈ K
                                a1 + b1 ∈ K ∧ a2 + b2 ∈ K ∧ x + y = (a1 + b1) · $v1 + (a2 + b2) · $v2
                                ∃ $q (a1 + b1 ∈ K ∧ $q ∈ K ∧ x + y = (a1 + b1) · $v1 + $q · $v2)
                                ∃ $p ∃ $q ($p ∈ K ∧ $q ∈ K ∧ x + y = $p · $v1 + $q · $v2)
                                x + y ∈ { $u ∈ V | ∃ $a1 ∃ $a2 ($a1 ∈ K ∧ $a2 ∈ K ∧ $u = $a1 · $v1 + $a2 · $v2) }
                                x + y ∈ L($v1, $v2)
        ; (U3): k (a1 v1 + a2 v2) = (k a1) v1 + (k a2) v2
        let k ∈ K
            let x ∈ L($v1, $v2)
                x ∈ { $u ∈ V | ∃ $a1 ∃ $a2 ($a1 ∈ K ∧ $a2 ∈ K ∧ $u = $a1 · $v1 + $a2 · $v2) }
                x ∈ V ∧ ∃ $a1 ∃ $a2 ($a1 ∈ K ∧ $a2 ∈ K ∧ x = $a1 · $v1 + $a2 · $v2)
                x ∈ V
                k · x ∈ V
                ∃ $a1 ∃ $a2 ($a1 ∈ K ∧ $a2 ∈ K ∧ x = $a1 · $v1 + $a2 · $v2)
                pick a1 with ∃ $a2 (a1 ∈ K ∧ $a2 ∈ K ∧ x = a1 · $v1 + $a2 · $v2)
                    pick a2 with a1 ∈ K ∧ a2 ∈ K ∧ x = a1 · $v1 + a2 · $v2
                        a1 ∈ K
                        a2 ∈ K
                        x = a1 · $v1 + a2 · $v2
                        a1 · $v1 ∈ V
                        a2 · $v2 ∈ V
                        k · x = k · (a1 · $v1 + a2 · $v2)
                              = k · (a1 · $v1) + k · (a2 · $v2)                      ; (V7)
                              = (k · a1) · $v1 + k · (a2 · $v2)                      ; (V5)
                              = (k · a1) · $v1 + (k · a2) · $v2                      ; (V5)
                        k · a1 ∈ K
                        k · a2 ∈ K
                        k · a1 ∈ K ∧ k · a2 ∈ K ∧ k · x = (k · a1) · $v1 + (k · a2) · $v2
                        ∃ $q (k · a1 ∈ K ∧ $q ∈ K ∧ k · x = (k · a1) · $v1 + $q · $v2)
                        ∃ $p ∃ $q ($p ∈ K ∧ $q ∈ K ∧ k · x = $p · $v1 + $q · $v2)
                        k · x ∈ { $u ∈ V | ∃ $a1 ∃ $a2 ($a1 ∈ K ∧ $a2 ∈ K ∧ $u = $a1 · $v1 + $a2 · $v2) }
                        k · x ∈ L($v1, $v2)
        subspace(L($v1, $v2))
qed
