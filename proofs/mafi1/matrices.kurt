; matrices -- the rules for n × n matrices that the course "Mathematik für Informatik 1" (mafi1)
; uses in lectures 12-30 (some are exercises, some "without proof" there); here they are axioms, so
; that the derivations on the slides can be checked: 15-inverse-matrix.kurt and the ones after.
;
; `Mat` is the set of n × n matrices over K, `GL` the invertible ones; `·` is the matrix product
; (and the product in K, decided by the memberships as in vectorspace.kurt), `E` the identity
; matrix, `T(A)` the transposed matrix, `inv A` the inverse.
load field
const Mat, GL, E, T, det
arity T 1, det 1

use E ∈ Mat                                                          "E-in"
use $A ∈ Mat ∧ $B ∈ Mat  ⇒  $A · $B ∈ Mat                            "Mat-times"
use $A ∈ Mat  ⇒  T($A) ∈ Mat                                         "T-in"
use $A ∈ GL  ⇒  $A ∈ Mat                                             "GL-in"

; (M1) of Theorem 5.9 (lecture 12), and E is neutral (lecture 12, Theorem 5.13: a ring)
use $A ∈ Mat ∧ $B ∈ Mat ∧ $C ∈ Mat  ⇒  ($A · $B) · $C = $A · ($B · $C)   "M1"
use $A ∈ Mat  ⇒  E · $A = $A                                         "E-left"
use $A ∈ Mat  ⇒  $A · E = $A                                         "E-right"

; the inverse: A A⁻¹ = A⁻¹ A = E (lecture 12, Theorem 5.12; lecture 15, Definition 5.38: regulär)
use $A ∈ GL  ⇒  inv $A ∈ Mat                                         "inv-in"
use $A ∈ GL  ⇒  $A · (inv $A) = E                                    "inv-right"
use $A ∈ GL  ⇒  (inv $A) · $A = E                                    "inv-left"
; a one-sided inverse is the inverse: for n × n matrices, A B = E makes A invertible (lecture 15,
; with the rank: A B = E gives rank A = n)
use $A ∈ Mat ∧ $B ∈ Mat ∧ $A · $B = E  ⇒  $A ∈ GL                     "one-sided-inverse"

; the transposed matrix (lecture 15, Theorem 5.27, "Übungsaufgabe" there)
use $A ∈ Mat ∧ $B ∈ Mat  ⇒  T($A · $B) = T($B) · T($A)              "T-times"
use T(E) = E                                                         "T-E"

; the determinant: det(A B) = det(A) det(B) (lecture 18, Theorem 6.62), normiert (lecture 16,
; Theorem 6.17), det(A) = det(Aᵀ) (lecture 17, Theorem 6.53, "without proof" there)
use $A ∈ Mat  ⇒  det($A) ∈ K                                         "det-in"
use $A ∈ Mat ∧ $B ∈ Mat  ⇒  det($A · $B) = det($A) · det($B)         "det-times"
use det(E) = 1                                                       "det-E"
use $A ∈ Mat  ⇒  det($A) = det(T($A))                                "det-T"
