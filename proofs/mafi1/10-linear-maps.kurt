; linear maps (course "Mathematik für Informatik 1" (mafi1), lecture 10)
;
; "Let V, W, Y be vector spaces over K, and f: V → W, g: W → Y linear."
load vectorspace
const V, W, Y, f, g
arity f 1, g 1

use vectorspace(V)                                                   "V-vectorspace"
use vectorspace(W)                                                   "W-vectorspace"
use vectorspace(Y)                                                   "Y-vectorspace"

; f: V → W is linear
use $x ∈ V  ⇒  f($x) ∈ W                                             "f-map"
use $x ∈ V ∧ $y ∈ V  ⇒  f($x + $y) = f($x) + f($y)                   "f-additive"
use $a ∈ K ∧ $x ∈ V  ⇒  f($a · $x) = $a · f($x)                      "f-homogeneous"

; g: W → Y is linear
use $x ∈ W  ⇒  g($x) ∈ Y                                             "g-map"
use $x ∈ W ∧ $y ∈ W  ⇒  g($x + $y) = g($x) + g($y)                   "g-additive"
use $a ∈ K ∧ $x ∈ W  ⇒  g($a · $x) = $a · g($x)                      "g-homogeneous"

; Lemma: f(x - y) = f(x) - f(y) and f(0) = 0, where x - y is x + (-y)
show $x ∈ V ∧ $y ∈ V  ⇒  f($x + (- $y)) = f($x) + (- f($y))          "f-minus"
proof
    assume $x ∈ V ∧ $y ∈ V
        $x ∈ V
        $y ∈ V
        - $y ∈ V
        - 1 ∈ K
        f($y) ∈ W
        f($x + (- $y)) = f($x) + f(- $y)
                       = f($x) + f((- 1) · $y)
                       = f($x) + (- 1) · f($y)
                       = f($x) + (- f($y))
qed

show f(0) = 0                                                        "f-zero"
proof
    0 ∈ V
    f(0) ∈ W
    0 · 0 = 0                                           ; 0 x = 0 in V
    f(0) = f(0 · 0)
         = 0 · f(0)
         = 0                                            ; 0 x = 0 in W
qed

; Theorem: g ∘ f is linear, with h(x) = (g f)(x) = g(f(x))
arity h 1
def h($x) = g(f($x))                                                 "h"

show $x ∈ V  ⇒  h($x) ∈ Y                                            "h-map"
proof
    assume $x ∈ V
        f($x) ∈ W
        g(f($x)) ∈ Y
        h($x) ∈ Y
qed

show $x ∈ V ∧ $y ∈ V  ⇒  h($x + $y) = h($x) + h($y)                  "h-additive"
proof
    assume $x ∈ V ∧ $y ∈ V
        $x ∈ V
        $y ∈ V
        f($x) ∈ W
        f($y) ∈ W
        h($x + $y) = g(f($x + $y))
                   = g(f($x) + f($y))
                   = g(f($x)) + g(f($y))
                   = h($x) + g(f($y))
                   = h($x) + h($y)
qed

show $a ∈ K ∧ $x ∈ V  ⇒  h($a · $x) = $a · h($x)                     "h-homogeneous"
proof
    assume $a ∈ K ∧ $x ∈ V
        $a ∈ K
        $x ∈ V
        f($x) ∈ W
        h($a · $x) = g(f($a · $x))
                   = g($a · f($x))
                   = $a · g(f($x))
                   = $a · h($x)
qed

; Kern f and Bild f; Null is {0} ⊂ V
def Kern = { $v ∈ V | f($v) = 0 }                                    "Kern"
def Null = { $v ∈ V | $v = 0 }                                       "Null"
def Bild = { $w ∈ W | ∃ $v ($v ∈ V ∧ $w = f($v)) }                   "Bild"

; in V, x - y = 0 gives x = y
show $x ∈ V ∧ $y ∈ V ∧ $x + (- $y) = 0  ⇒  $x = $y                   "V-minus-zero"
proof
    assume $x ∈ V ∧ $y ∈ V ∧ $x + (- $y) = 0
        $x ∈ V
        $y ∈ V
        $x + (- $y) = 0
        - $y ∈ V
        (- $y) + $x = $x + (- $y)                       ; (V2)
        (- $y) + $x = 0
        $y + (- $y) = 0                                 ; (V4)
        (- $y) + $y = $y + (- $y)                       ; (V2)
        (- $y) + $y = 0
        $x = $y                                         ; vector-minus-unique, with -y as the vector
qed

; Theorem: Kern f = {0} ⇔ f injective
show Kern = Null  ⇔  ∀ $x ∈ V ∀ $y ∈ V (f($x) = f($y) ⇒ $x = $y)     "kernel-injective"
proof
    ; "⇒"
    assume Kern = Null
        let x ∈ V
            let y ∈ V
                assume f(x) = f(y)
                    - y ∈ V
                    x + (- y) ∈ V
                    f(y) ∈ W
                    f(x + (- y)) = f(x) + (- f(y))      ; f-minus
                                 = f(y) + (- f(y))
                                 = 0
                    x + (- y) ∈ { $v ∈ V | f($v) = 0 }
                    x + (- y) ∈ Kern
                    x + (- y) ∈ Null
                    x + (- y) ∈ { $v ∈ V | $v = 0 }
                    x + (- y) ∈ V ∧ x + (- y) = 0
                    x + (- y) = 0
                    x = y
    ; "⇐"
    assume ∀ $x ∈ V ∀ $y ∈ V (f($x) = f($y) ⇒ $x = $y)
        0 ∈ V
        f(0) = 0                                        ; f-zero
        ; Kern ⊂ Null
        let x
            assume x ∈ Kern
                x ∈ { $v ∈ V | f($v) = 0 }
                x ∈ V ∧ f(x) = 0
                x ∈ V
                f(x) = 0
                f(x) = f(0)
                ∀ $y ∈ V (f(x) = f($y) ⇒ x = $y)       ; f injective
                f(x) = f(0) ⇒ x = 0
                x = 0
                x ∈ { $v ∈ V | $v = 0 }
                x ∈ Null
        Kern ⊂ Null
        ; Null ⊂ Kern
        let x
            assume x ∈ Null
                x ∈ { $v ∈ V | $v = 0 }
                x ∈ V ∧ x = 0
                x ∈ V
                x = 0
                f(x) = 0
                x ∈ { $v ∈ V | f($v) = 0 }
                x ∈ Kern
        Null ⊂ Kern
        Kern = Null
qed

; Theorem: Bild f = W ⇔ f surjective
show Bild = W  ⇔  ∀ $w ∈ W ∃ $v ($v ∈ V ∧ $w = f($v))                "image-surjective"
proof
    ; "⇒"
    assume Bild = W
        let w ∈ W
            w ∈ Bild
            w ∈ { $u ∈ W | ∃ $v ($v ∈ V ∧ $u = f($v)) }
            w ∈ W ∧ ∃ $v ($v ∈ V ∧ w = f($v))
            ∃ $v ($v ∈ V ∧ w = f($v))
    ; "⇐"
    assume ∀ $w ∈ W ∃ $v ($v ∈ V ∧ $w = f($v))
        ; Bild ⊂ W holds always
        let w
            assume w ∈ Bild
                w ∈ { $u ∈ W | ∃ $v ($v ∈ V ∧ $u = f($v)) }
                w ∈ W ∧ ∃ $v ($v ∈ V ∧ w = f($v))
                w ∈ W
        Bild ⊂ W
        ; W ⊂ Bild
        let w
            assume w ∈ W
                ∃ $v ($v ∈ V ∧ w = f($v))               ; f surjective
                w ∈ { $u ∈ W | ∃ $v ($v ∈ V ∧ $u = f($v)) }
                w ∈ Bild
        W ⊂ Bild
        Bild = W
qed
