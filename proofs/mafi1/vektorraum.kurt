; Vektorräume -- vector spaces over a field (lecture "Mathematik für Informatik 1" (mafi1),
; decks 04-reelle-vektorraeume and 05-komplexe-vektorraeume, axioms (V1)-(V8))
;
; As on the slides, `+`, `·`, `-` and `0` are used for scalars and vectors alike: which axiom
; applies is decided by the memberships (`λ ∈ K`, `x ∈ V`).  That is sound -- there is a model
; for each real one, in which the zero scalar and the zero vector are the same object (all the
; operations agree on it: `0 + 0 = 0`, `- 0 = 0`, `λ · 0 = 0`, `0 · 0 = 0`).
;
; (V3) and (V4) are given by names, as the slides do after proving uniqueness (below): the zero
; vector `0` and the inverse `- x`.
;
; The axioms hold for every vector space `$V` over `K` (`vectorspace($V)`), so that there can be
; several of them, e.g. for a linear map from `V` to `W`.
load koerper
arity vectorspace 1

use vectorspace($V)  ⇒  0 ∈ $V                                                       "V-zero"
use vectorspace($V) ∧ $x ∈ $V ∧ $y ∈ $V  ⇒  $x + $y ∈ $V                             "V-plus"
use vectorspace($V) ∧ $a ∈ K ∧ $x ∈ $V  ⇒  $a · $x ∈ $V                              "V-times"
use vectorspace($V) ∧ $x ∈ $V  ⇒  - $x ∈ $V                                          "V-minus"

use vectorspace($V) ∧ $x ∈ $V ∧ $y ∈ $V ∧ $z ∈ $V  ⇒  ($x + $y) + $z = $x + ($y + $z) "V1"
use vectorspace($V) ∧ $x ∈ $V ∧ $y ∈ $V  ⇒  $x + $y = $y + $x                        "V2"
use vectorspace($V) ∧ $x ∈ $V  ⇒  $x + 0 = $x                                        "V3"
use vectorspace($V) ∧ $x ∈ $V  ⇒  $x + (- $x) = 0                                    "V4"
use vectorspace($V) ∧ $a ∈ K ∧ $b ∈ K ∧ $x ∈ $V  ⇒  $a · ($b · $x) = ($a · $b) · $x  "V5"
use vectorspace($V) ∧ $x ∈ $V  ⇒  1 · $x = $x                                        "V6"
use vectorspace($V) ∧ $a ∈ K ∧ $x ∈ $V ∧ $y ∈ $V  ⇒  $a · ($x + $y) = $a · $x + $a · $y "V7"
use vectorspace($V) ∧ $a ∈ K ∧ $b ∈ K ∧ $x ∈ $V  ⇒  ($a + $b) · $x = $a · $x + $b · $x "V8"

; deck 04: the zero vector is unique
show vectorspace($V) ∧ $o ∈ $V ∧ (∀ $x ∈ $V ($x + $o = $x))  ⇒  $o = 0                 "V-zero-unique"
proof
    assume vectorspace($V) ∧ $o ∈ $V ∧ (∀ $x ∈ $V ($x + $o = $x))
        vectorspace($V)
        $o ∈ $V
        ∀ $x ∈ $V ($x + $o = $x)
        0 ∈ $V                                          ; V-zero
        0 + $o = 0                                      ; (V3) for 0'  with x = 0
        $o = $o + 0
           = 0 + $o
           = 0
qed

; deck 04: the inverse is unique
show vectorspace($V) ∧ $x ∈ $V ∧ $a ∈ $V ∧ $b ∈ $V ∧ $x + $a = 0 ∧ $x + $b = 0  ⇒  $a = $b   "V-minus-unique"
proof
    assume vectorspace($V) ∧ $x ∈ $V ∧ $a ∈ $V ∧ $b ∈ $V ∧ $x + $a = 0 ∧ $x + $b = 0
        vectorspace($V)
        $x ∈ $V
        $a ∈ $V
        $b ∈ $V
        $x + $a = 0
        $x + $b = 0
        0 ∈ $V                                          ; V-zero
        $a = $a + 0
           = $a + ($x + $b)                             ; hypothesis on b
           = ($a + $x) + $b                             ; V1
           = ($x + $a) + $b                             ; V2
           = 0 + $b                                     ; hypothesis on a
           = $b + 0                                     ; V2
           = $b                                         ; V3
qed

; deck 06 (in the proof that 0 ∈ U): 0 x = 0
show vectorspace($V) ∧ $x ∈ $V  ⇒  0 · $x = 0                                          "zero-times-vector"
proof
    assume vectorspace($V) ∧ $x ∈ $V
        vectorspace($V)
        $x ∈ $V
        0 · $x ∈ $V
        - (0 · $x) ∈ $V
        0 · $x + 0 · $x ∈ $V
        0 = 0 · $x + (- (0 · $x))                       ; V4
          = (0 + 0) · $x + (- (0 · $x))                 ; 0 = 0 + 0 in K
          = (0 · $x + 0 · $x) + (- (0 · $x))            ; V8
          = 0 · $x + (0 · $x + (- (0 · $x)))            ; V1
          = 0 · $x + 0                                  ; V4
          = 0 · $x                                      ; V3
qed

; deck 06 (in the proof that -x ∈ U): (-1) x = -x
show vectorspace($V) ∧ $x ∈ $V  ⇒  (- 1) · $x = - $x                                   "minus-one-times-vector"
proof
    assume vectorspace($V) ∧ $x ∈ $V
        vectorspace($V)
        $x ∈ $V
        - 1 ∈ K
        (- 1) · $x ∈ $V
        - $x ∈ $V
        0 = 0 · $x
          = (1 + (- 1)) · $x                            ; 0 = 1 + (-1) in K
          = 1 · $x + (- 1) · $x                         ; V8
          = $x + (- 1) · $x                             ; V6
        $x + (- $x) = 0                                 ; V4
        (- 1) · $x = - $x                               ; V-minus-unique
qed

; (-λ) x = -(λ x)
show vectorspace($V) ∧ $a ∈ K ∧ $x ∈ $V  ⇒  (- $a) · $x = - ($a · $x)   "minus-times-vector"
proof
    assume vectorspace($V) ∧ $a ∈ K ∧ $x ∈ $V
        vectorspace($V)
        $a ∈ K
        $x ∈ $V
        - 1 ∈ K
        $a · $x ∈ $V
        (- 1) · $a = - $a                               ; minus-one-times
        (- $a) · $x = ((- 1) · $a) · $x
                    = (- 1) · ($a · $x)
                    = - ($a · $x)
qed

; regrouping a sum of four: (x + y) + (z + u) = (x + z) + (y + u), from (V1) and (V2)
show vectorspace($V) ∧ $x ∈ $V ∧ $y ∈ $V ∧ $z ∈ $V ∧ $u ∈ $V  ⇒  ($x + $y) + ($z + $u) = ($x + $z) + ($y + $u)   "V-shuffle"
proof
    assume vectorspace($V) ∧ $x ∈ $V ∧ $y ∈ $V ∧ $z ∈ $V ∧ $u ∈ $V
        vectorspace($V)
        $x ∈ $V
        $y ∈ $V
        $z ∈ $V
        $u ∈ $V
        $x + $y ∈ $V
        $z + $u ∈ $V
        $y + $z ∈ $V
        $z + $y ∈ $V
        $y + $u ∈ $V
        ($x + $y) + ($z + $u) = $x + ($y + ($z + $u))
                              = $x + (($y + $z) + $u)
                              = $x + (($z + $y) + $u)
                              = $x + ($z + ($y + $u))
                              = ($x + $z) + ($y + $u)
qed
