; formulas (course "Mathematik für Informatik 1" (mafi1), lecture 03)
;
; Kontraposition and the "Andere nützliche Formeln" are in 11a-proofs.kurt and tautologies.kurt.
load 11a-proofs, set
const P
arity P 1

; "Noch mehr nützliche Formeln" (i): ¬∀x P(x) ⇔ ∃x ¬P(x)
show ¬(∀ x P(x))  ⇔  ∃ x ¬P(x)                                       "not-forall"
proof
    assume ¬(∀ x P(x))
        assume ¬(∃ x ¬P(x))
            let a
                assume ¬P(a)
                    ∃ x ¬P(x)
                    ⊥
                P(a)
            ∀ x P(x)
            ⊥
        ∃ x ¬P(x)
    assume ∃ x ¬P(x)
        pick a with ¬P(a)
            assume ∀ x P(x)
                P(a)
                ⊥
            ¬(∀ x P(x))
qed

; (ii): ¬∃x P(x) ⇔ ∀x ¬P(x)
show ¬(∃ x P(x))  ⇔  ∀ x ¬P(x)                                       "not-exists"
proof
    assume ¬(∃ x P(x))
        let a
            assume P(a)
                ∃ x P(x)
                ⊥
            ¬P(a)
        ∀ x ¬P(x)
    assume ∀ x ¬P(x)
        assume ∃ x P(x)
            pick a with P(a)
                ¬P(a)
                ⊥
        ¬(∃ x P(x))
qed

; an equivalence is two implications ("Äquivalenz")
show (%A ⇔ %B)  ⇔  (%A ⇒ %B) ∧ (%B ⇒ %A)                            "iff-as-and"
proof
    assume %A ⇔ %B
        %A ⇒ %B
        %B ⇒ %A
        (%A ⇒ %B) ∧ (%B ⇒ %A)
    assume (%A ⇒ %B) ∧ (%B ⇒ %A)
        %A ⇒ %B
        %B ⇒ %A
        %A ⇔ %B
qed

; "Alternative Formulierungen der Mengengleichheit"
const A, B

; ∀ distributes over ∧ (here for the formulas of the next proof)
show (∀ x ((x ∈ A ⇒ x ∈ B) ∧ (x ∈ B ⇒ x ∈ A)))  ⇔  (∀ x (x ∈ A ⇒ x ∈ B)) ∧ (∀ x (x ∈ B ⇒ x ∈ A))   "forall-and"
proof
    assume ∀ x ((x ∈ A ⇒ x ∈ B) ∧ (x ∈ B ⇒ x ∈ A))
        let x
            x ∈ A ⇒ x ∈ B
        let x
            x ∈ B ⇒ x ∈ A
        (∀ x (x ∈ A ⇒ x ∈ B)) ∧ (∀ x (x ∈ B ⇒ x ∈ A))
    assume (∀ x (x ∈ A ⇒ x ∈ B)) ∧ (∀ x (x ∈ B ⇒ x ∈ A))
        ∀ x (x ∈ A ⇒ x ∈ B)
        ∀ x (x ∈ B ⇒ x ∈ A)
        let x
            (x ∈ A ⇒ x ∈ B) ∧ (x ∈ B ⇒ x ∈ A)
qed

show A = B  ⇔  A ⊂ B ∧ B ⊂ A                                         "set-equality"
proof
    A = B ⇔ ∀ x (x ∈ A ⇔ x ∈ B)                                        ; extensionality
          ⇔ ∀ x ((x ∈ A ⇒ x ∈ B) ∧ (x ∈ B ⇒ x ∈ A))                    ; iff-as-and, under the ∀
          ⇔ (∀ x (x ∈ A ⇒ x ∈ B)) ∧ (∀ x (x ∈ B ⇒ x ∈ A))              ; forall-and
          ⇔ (∀ x ∈ A (x ∈ B)) ∧ (∀ x (x ∈ B ⇒ x ∈ A))                  ; forall-cond-def
          ⇔ (∀ x ∈ A (x ∈ B)) ∧ (∀ x ∈ B (x ∈ A))                      ; forall-cond-def
          ⇔ A ⊂ B ∧ (∀ x ∈ B (x ∈ A))                                  ; definition of ⊂
          ⇔ A ⊂ B ∧ B ⊂ A                                              ; definition of ⊂
qed

; "Kontraposition": the two forms of injectivity of f: A → B are the same
const f
arity f 1

; contraposition, with x ≠ y for ¬(x = y) (read as the same, equality.kurt's `inline`)
show ($a ≠ $b ⇒ $c ≠ $d)  ⇔  ($c = $d ⇒ $a = $b)                     "contraposition-neq"
proof
    ($a ≠ $b ⇒ $c ≠ $d) ⇔ (¬($a = $b) ⇒ ¬($c = $d))                  ; the same, read so
                        ⇔ (¬¬($c = $d) ⇒ ¬¬($a = $b))                ; contraposition
                        ⇔ ($c = $d ⇒ ¬¬($a = $b))                    ; not-not
                        ⇔ ($c = $d ⇒ $a = $b)                        ; not-not
qed

show (∀ $x1 ∈ A ∀ $x2 ∈ A ($x1 ≠ $x2 ⇒ f($x1) ≠ f($x2)))  ⇔  (∀ $x1 ∈ A ∀ $x2 ∈ A (f($x1) = f($x2) ⇒ $x1 = $x2))   "injective-forms"
proof
    assume ∀ $x1 ∈ A ∀ $x2 ∈ A ($x1 ≠ $x2 ⇒ f($x1) ≠ f($x2))
        let x1 ∈ A
            ∀ $x2 ∈ A (x1 ≠ $x2 ⇒ f(x1) ≠ f($x2))
            let x2 ∈ A
                x1 ≠ x2 ⇒ f(x1) ≠ f(x2)
                f(x1) = f(x2) ⇒ x1 = x2                              ; contraposition-neq
    assume ∀ $x1 ∈ A ∀ $x2 ∈ A (f($x1) = f($x2) ⇒ $x1 = $x2)
        let x1 ∈ A
            ∀ $x2 ∈ A (f(x1) = f($x2) ⇒ x1 = $x2)
            let x2 ∈ A
                f(x1) = f(x2) ⇒ x1 = x2
                x1 ≠ x2 ⇒ f(x1) ≠ f(x2)                              ; contraposition-neq
qed
