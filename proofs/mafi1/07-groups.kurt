; groups (course "Mathematik für Informatik 1" (mafi1), lecture 07)
;
; A group needs (G1), (G3) and (G4) only, where (G3) and (G4) give a neutral element and inverses
; from the right; Theorem a shows that they also work from the left (after Bosch, Algebra, p. 286).
; As on the slides, (G4) says that an inverse exists; the neutral element has the name `e`.
load set
infix ∘ 70 70                 ; syntax only; (G-closed) makes ∘ a constant and reports `const ∘`
const G, e

use $a ∈ G ∧ $b ∈ G  ⇒  $a ∘ $b ∈ G                                  "G-closed"
use e ∈ G                                                            "G-e"

use $a ∈ G ∧ $b ∈ G ∧ $c ∈ G  ⇒  ($a ∘ $b) ∘ $c = $a ∘ ($b ∘ $c)     "G1"
use $a ∈ G  ⇒  $a ∘ e = $a                                           "G3"
use $a ∈ G  ⇒  ∃ $b ∈ G ($a ∘ $b = e)                                "G4"

; Theorem a (iii): a right inverse is a left inverse, a b = e ⇒ b a = e
show $a ∈ G ∧ $b ∈ G ∧ $a ∘ $b = e  ⇒  $b ∘ $a = e                   "left-inverse"
proof
    assume $a ∈ G ∧ $b ∈ G ∧ $a ∘ $b = e
        $a ∈ G
        $b ∈ G
        $a ∘ $b = e                                     ; (i)
        ∃ $c ∈ G ($b ∘ $c = e)                          ; G4
        pick c with c ∈ G ∧ $b ∘ c = e
            c ∈ G
            $b ∘ c = e                                  ; (ii)
            $b ∘ $a ∈ G
            $b ∘ $a = ($b ∘ $a) ∘ e                     ; G3
                    = ($b ∘ $a) ∘ ($b ∘ c)              ; (ii)
                    = (($b ∘ $a) ∘ $b) ∘ c              ; G1
                    = ($b ∘ ($a ∘ $b)) ∘ c              ; G1
                    = ($b ∘ e) ∘ c                      ; (i)
                    = $b ∘ c                            ; G3
                    = e                                 ; (ii)
qed

; Theorem a (iv): the neutral element is neutral from the left too, e a = a
show $a ∈ G  ⇒  e ∘ $a = $a                                          "left-neutral"
proof
    assume $a ∈ G
        ∃ $b ∈ G ($a ∘ $b = e)                          ; G4
        pick b with b ∈ G ∧ $a ∘ b = e
            b ∈ G
            $a ∘ b = e                                  ; (i)
            e ∘ $a = ($a ∘ b) ∘ $a                      ; (i)
                   = $a ∘ (b ∘ $a)                      ; G1
                   = $a ∘ e                             ; (iii)
                   = $a                                 ; G3
qed

; Theorem b: left-unique (cancellation from the right), b a = c a ⇒ b = c
show $a ∈ G ∧ $b ∈ G ∧ $c ∈ G ∧ $b ∘ $a = $c ∘ $a  ⇒  $b = $c        "left-unique"
proof
    assume $a ∈ G ∧ $b ∈ G ∧ $c ∈ G ∧ $b ∘ $a = $c ∘ $a
        $a ∈ G
        $b ∈ G
        $c ∈ G
        $b ∘ $a = $c ∘ $a                               ; (i)
        ∃ $d ∈ G ($a ∘ $d = e)                          ; G4
        pick d with d ∈ G ∧ $a ∘ d = e                  ; d is the inverse a⁻¹
            d ∈ G
            $a ∘ d = e                                  ; (ii)
            $b = $b ∘ e                                 ; G3
               = $b ∘ ($a ∘ d)                          ; (ii)
               = ($b ∘ $a) ∘ d                          ; G1
               = ($c ∘ $a) ∘ d                          ; (i)
               = $c ∘ ($a ∘ d)                          ; G1
               = $c ∘ e                                 ; (ii)
               = $c                                     ; G3
qed

; Theorem b: right-unique (cancellation from the left), a b = a c ⇒ b = c ("analog", with Theorem a)
show $a ∈ G ∧ $b ∈ G ∧ $c ∈ G ∧ $a ∘ $b = $a ∘ $c  ⇒  $b = $c        "right-unique"
proof
    assume $a ∈ G ∧ $b ∈ G ∧ $c ∈ G ∧ $a ∘ $b = $a ∘ $c
        $a ∈ G
        $b ∈ G
        $c ∈ G
        $a ∘ $b = $a ∘ $c                               ; (i)
        ∃ $d ∈ G ($a ∘ $d = e)                          ; G4
        pick d with d ∈ G ∧ $a ∘ d = e                  ; d is the inverse a⁻¹
            d ∈ G
            $a ∘ d = e                                  ; (ii)
            $b = e ∘ $b                                 ; Theorem a (iv)
               = (d ∘ $a) ∘ $b                          ; Theorem a (iii)
               = d ∘ ($a ∘ $b)                          ; G1
               = d ∘ ($a ∘ $c)                          ; (i)
               = (d ∘ $a) ∘ $c                          ; G1
               = e ∘ $c                                 ; Theorem a (iii)
               = $c                                     ; Theorem a (iv)
qed
