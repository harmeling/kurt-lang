;;; two-equal sets

load set

var A, B, C, M, N
use M ⊂ N  ⇔  ∀x (x ∈ M ⇒ x ∈ N)    "subset-def"  ; subset
use M = N  ⇔  M ⊂ N  ∧  N ⊂ M       "eq-def"      ; equality of sets

show A ∩ (B ∪ C) = (A ∩ B) ∪ (A ∩ C)   "set-distribution"
proof
    show A ∩ (B ∪ C) ⊂ (A ∩ B) ∪ (A ∩ C)
    proof
        fix x
            assume x ∈ A ∩ (B ∪ C)
                x ∈ A  ∧  x ∈ B ∪ C
                x ∈ A
                x ∈ B ∪ C
                assume x ∈ B
                    x ∈ A  ∧  x ∈ B
                    x ∈ A ∩ B
                    x ∈ (A ∩ B) ∪ (A ∩ C)
                thus x ∈ B  ⇒  x ∈ (A ∩ B) ∪ (A ∩ C)
                assume x ∈ C
                    x ∈ A  ∧  x ∈ C
                    x ∈ A ∩ C
                    x ∈ (A ∩ B) ∪ (A ∩ C)
                thus x ∈ C  ⇒  x ∈ (A ∩ B) ∪ (A ∩ C)
                x ∈ (A ∩ B) ∪ (A ∩ C)
            thus x ∈ A ∩ (B ∪ C)  ⇒  x ∈ (A ∩ B) ∪ (A ∩ C)
        thus ∀ $x  $x ∈ A ∩ (B ∪ C)  ⇒  $x ∈ (A ∩ B) ∪ (A ∩ C)
    qed
    show (A ∩ B) ∪ (A ∩ C) ⊂ A ∩ (B ∪ C)
    proof
        fix x
            assume x ∈ (A ∩ B) ∪ (A ∩ C)
                assume x ∈ A ∩ B
                    x ∈ A  ∧  x ∈ B
                    x ∈ A
                    x ∈ B ∪ C
                    x ∈ A ∩ (B ∪ C)
                thus x ∈ A ∩ B ⇒ x ∈ A ∩ (B ∪ C)
                assume x ∈ A ∩ C
                    x ∈ A  ∧  x ∈ C
                    x ∈ A
                    x ∈ B ∪ C
                    x ∈ A ∩ (B ∪ C)
                thus x ∈ A ∩ C ⇒ x ∈ A ∩ (B ∪ C)
            thus x ∈ (A ∩ B) ∪ (A ∩ C) ⇒ x ∈ A ∩ (B ∪ C)
    qed
qed
;;; Proof checked.