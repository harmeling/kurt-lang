; worked examples of beta-reduction (see src/kurt/theories/lambda-calculus.kurt for the
; theory itself and its known gaps -- in particular, everything here needs a lambda body
; that's a genuine compound expression mentioning the bound variable, not just the bound
; variable alone).
load lambda-calculus, prop
const c
bool P, Q, R
arity P 1, Q 1, R 1

; applying a single-predicate abstraction
(λ $x (P $x)) c = P c

; the argument can be any term, not just a bare constant -- here, the result of applying a
; different lambda abstraction to `c`
(λ $x (P $x)) ((λ $y (P $y)) c) = P ((λ $y (P $y)) c)

; a compound body: beta-reduction distributes across `and` for free, since substitution
; itself is structural (see doc/kurt-soundness.md #3 on capture-avoiding substitution) --
; note the explicit parens around the whole right-hand side, needed because `=` binds looser
; than `and`, the same precedence quirk `set.kurt`'s own axioms have to work around
(λ $x ((Q $x) and (R $x))) c = ((Q c) and (R c))

; and across `not`
(λ $x (not (P $x))) c = not (P c)
