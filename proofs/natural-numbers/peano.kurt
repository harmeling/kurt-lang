; peano.kurt
;
; natural numbers from zero and a successor function `s`, with addition defined by
; recursion: `n + 0 = n`, and `s n + m = s (n + m)`
load set
infix + 60 60                       ; (before: undeclared, a word applied to its neighbours)

var n, m
use 0 in Nat                        "zero"
use n in Nat  implies  s n in Nat   "succ"   ; function application binds most tightly
use n + 0 = n                       "add-zero"
use (s n) + m = s (n + m)           "add-succ"
use 1 = s 0                         "one"
use 2 = s 1                         "two"

; 2 is a natural number
(s 0) in Nat
1 in Nat
(s 1) in Nat
2 in Nat

; 1 + 1 = 2
(s 0) + 1 = s (0 + 1)
1 + 1 = s (0 + 1)
; ... but here we are stuck: `0 + 1 = 1` needs `0 + n = n`, which is not an axiom -- and doesn't
; follow from the two above: `n + m := n` satisfies both ("add-zero": n = n; "add-succ": s n =
; s n) but not `0 + 1 = 1`. (With the recursion on the second argument, `n + s m = s (n + m)`, it
; would follow by induction.) So it is a further axiom here:
use 0 + n = n                       "zero-add"
1 + 1 = s 1
1 + 1 = 2
