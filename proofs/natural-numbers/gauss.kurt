;; gauss.kurt
; proof of Gauss' summation formula 0 + 1 + ... + n = n * (n+1) / 2, by induction on n
load natural
calc on                  ; e.g. `(k + 1) + 1` is `k + 2`, and `0 * (0 + 1) / 2` is `0`

; sums of the form `sum i (a, b) i`, i.e., a + (a+1) + ... + b
; (only with the bound variable itself as the summand: a general summand `$T` that depends on
; the bound variable `$i` can't be written as a pattern yet)
const sum
arity sum 3
bindop sum
use (sum $i ($a, $a) $i) = $a                                   "sum-one"
use (sum $i ($a, $b + 1) $i) = ($b + 1) + (sum $i ($a, $b) $i)  "sum-last"

2 ≠ 0                    ; needed for dividing by 2
show ∀ $n ∈ Nat  ((sum x (0, $n) x) = $n * ($n + 1) / 2)
proof
    ; base case
    (sum x (0, 0) x) = 0 * (0 + 1) / 2
    ; induction step
    show ∀ $k ∈ Nat  ((sum x (0, $k) x) = $k * ($k + 1) / 2  ⇒  (sum x (0, $k + 1) x) = ($k + 1) * ($k + 2) / 2)
    proof
        let k ∈ Nat
            assume (sum x (0, k) x) = k * (k + 1) / 2
                ; the two arithmetic facts needed below
                ((k + 1) * 2) / 2 = k + 1
                ((k + 1) * 2) / 2 + k * (k + 1) / 2 = ((k + 1) * 2 + k * (k + 1)) / 2
                (sum x (0, k + 1) x) = (k + 1) + (sum x (0, k) x)      ; by sum-last
                    = (k + 1) + k * (k + 1) / 2                        ; by assumption
                    = ((k + 1) * 2) / 2 + k * (k + 1) / 2
                    = ((k + 1) * 2 + k * (k + 1)) / 2
                    = ((2 + k) * (k + 1)) / 2                          ; by distrib-add
    ; by induction (natural.kurt)
qed
