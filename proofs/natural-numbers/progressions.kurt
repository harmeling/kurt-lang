; sets of numbers with `...` (natural.kurt, since 2026-10-12): `{a, ..., c}` in steps of one,
; `{a, b, ..., c}` and `{a, b, ...}` in steps of `b - a`; a list whose pattern would be a guess is
; refused. (The arithmetic facts are computed with `calc on`, which keeps a line as written: `7 = 1 + 6`
; stays `7 = 1 + 6`, so "exists-cond-intro" sees the instance.)
load natural
calc on

; 7 is one of 1, ..., 10: 7 = 1 + 6
6 ∈ Nat
7 = 1 + 6
7 <= 10
6 ∈ Nat ∧ 7 = 1 + 6 ∧ 7 <= 10
∃ k ∈ Nat (7 = 1 + k ∧ 7 <= 10)
7 ∈ {1, ..., 10}                            ; by range

; 9 is one of 1, 3, ..., 99: 9 = 1 + 4 · (3 - 1)
4 ∈ Nat
9 = 1 + 4 * (3 - 1)
9 <= 99
1 < 3
4 ∈ Nat ∧ 9 = 1 + 4 * (3 - 1) ∧ 9 <= 99
∃ k ∈ Nat (9 = 1 + k * (3 - 1) ∧ 9 <= 99)
9 ∈ {1, 3, ..., 99}                         ; by progression-intro

; an element of the even numbers is a multiple of two
0 < 2
use n ∈ {0, 2, ...}
∃ k ∈ Nat (n = 0 + k * (2 - 0))             ; by progression-infinite

; refused: the pattern would be a guess
expect "ParseError" "set-builder"
    use 13 ∈ {2, 3, 5, 7, 11, ...}
expect "ParseError" "set-builder"
    use 8 ∈ {1, 2, 4, ...}
expect "ParseError" "set-builder"
    use 8 ∈ {1, ..., 4, 8}
; and `...` gives no rule "element": 10 is not simply listed in `{1, ..., 10}`
expect "ProofError" "can not derive `10 ∈ {1, ..., 10}`"
    10 ∈ {1, ..., 10}
