; the keywords that only print something -- the declarations without arguments list what is
; declared so far, and the inspection keywords show the state -- and their wrong uses
load numbers
const c
use c > 0 "c-pos"
show c + 1 > 1
proof
    ; inside a block, to have something to show
    summary
    show
    c + 1 > 0 + 1
qed

; what is declared so far
infix
prefix
postfix
brackets
arity
bindop
flat
sym
chain
alias
var
const
bool
use
def
theory
theory >
syntax
syntax +
load
help
hint
parse c + 1, -c
tokenize c + 1, -c
format sexpr
c > 0
format normal
c > 0
theory
cert 15
cert
cert 5, 999

; wrong arguments
expect "EvalError"
    summary 1
expect "EvalError"
    format latex
expect "EvalError"
    format sexpr normal
expect "EvalError"
    calc maybe
expect "EvalError"
    calc on, off
expect "EvalError"
    syntax 1
expect "EvalError"
    theory 1
expect "EvalError"
    cert x
expect "EvalError"
    save
expect "EvalError"
    save "a.kurt", "b.kurt"
