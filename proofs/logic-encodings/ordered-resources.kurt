; An ordered multiplicative fragment with no exchange, weakening, or contraction.
;
; A context is either one formula or an ordered pair `(Γ, Δ)`. Tensor introduction splits the
; context between its two premises and preserves their order. The three expected failures below
; demonstrate that the omitted structural rules are not silently supplied by Kurt.

infix * 50 50
infix ⊢ 10 10

const *, ⊢
bool ⊢ 0

var A, B, Γ, Δ

use A ⊢ A "identity"
use (Γ ⊢ A) and (Δ ⊢ B) implies ((Γ, Δ) ⊢ (A * B)) "tensor-introduction"

const P, Q

P ⊢ P
Q ⊢ Q
(P, Q) ⊢ (P * Q)

; No exchange: reversing the resources cannot prove the original ordered tensor.
expect "ProofError" "can not derive"
    (Q, P) ⊢ (P * Q)

; No weakening: an unused Q cannot remain in the context.
expect "ProofError" "can not derive"
    (P, Q) ⊢ P

; No contraction: one occurrence of P cannot supply both tensor premises.
expect "ProofError" "can not derive"
    P ⊢ (P * P)
