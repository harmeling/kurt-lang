; injective.kurt
load logic
load equality

; task: prove that the composition of two injective functions is injective

infix ∘ 40 40                  ; composition
def ($f∘$g)($x) = $f($g($x))   ; def of composition
alias circ ∘

const f, g
arity f 1, g 1
use ∀x ∀y (f(x)=f(y) ⇒ x=y)          ; f is injective
use ∀x ∀y (g(x)=g(y) ⇒ x=y)          ; g is injective

; let's first proof a lemma
show ($a ∘ $b)($c) = ($d ∘ $e)($f) implies $a($b($c)) = $d($e($f))
proof
    assume ($a ∘ $b)($c) = ($d ∘ $e)($f)
        ($a ∘ $b)($c) = $d($e($f))
        $a($b($c)) = $d($e($f))
qed

; theorem
show ∀x ∀y ((f∘g)(x)=(f∘g)(y) ⇒ x=y) ; composition of f and g is injective
proof
    let x, y                              ; arbitrary but constant
        assume (f∘g)(x) = (f∘g)(y)
            f(g(x)) = f(g(y))             ; def of composition
            g(x) = g(y)                   ; f injective
            x = y                         ; g injective
qed
;;; Proof checked.
