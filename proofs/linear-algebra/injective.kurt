; injective.kurt
load first-order
load equality

; task: prove that the composition of two injective functions is injective

infix ∘ 40 40                  ; composition
use ($f∘$g)($x) = $f($g($x))   ; def of composition

const f, g

use ∀x ∀y (f(x)=f(y) ⇒ x=y)          ; f is injective
use ∀x ∀y (g(x)=g(y) ⇒ x=y)          ; g is injective

show ∀x ∀y ((f∘g)(x)=(f∘g)(y) ⇒ x=y) ; composition of f and g is injective
proof
    fix x, y                              ; arbitrary but constant
        assume (f∘g)(x) = (f∘g)(y)
            f(g(x)) = f(g(y))             ; def of composition
            g(x) = g(y)                   ; f injective
            x = y                         ; g injective
        thus (f∘g)(x)=(f∘g)(y) ⇒ x=y      ; impl-intro
    thus ∀x ∀y ((f∘g)(x)=(f∘g)(y) ⇒ x=y)  ; forall-intro
qed
;;; Proof checked.
