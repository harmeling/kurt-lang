; injective.kurt
load logic
load equality

; task: prove that the composition of two injective functions is injective

infix ∘ 40 40                  ; composition
var φ, ψ, χ, ω                 ; operator variables: an operator is no object (doc/kurt-doc.md §5.3),
arity φ 1, ψ 1, χ 1, ω 1       ; so the functions that `∘` composes are operator parameters
def (φ∘ψ)($x) = φ(ψ($x))       ; def of composition
alias circ ∘

const f, g
arity f 1, g 1
use ∀x ∀y (f(x)=f(y) ⇒ x=y)          ; f is injective
use ∀x ∀y (g(x)=g(y) ⇒ x=y)          ; g is injective

; let's first proof a lemma
show (φ ∘ ψ)($c) = (χ ∘ ω)($f) implies φ(ψ($c)) = χ(ω($f))
proof
    assume (φ ∘ ψ)($c) = (χ ∘ ω)($f)
        (φ ∘ ψ)($c) = χ(ω($f))
        φ(ψ($c)) = χ(ω($f))
qed

; theorem
show ∀x ∀y ((f∘g)(x)=(f∘g)(y) ⇒ x=y) ; composition of f and g is injective
proof
    let x, y                              ; arbitrary but constant
        assume (f∘g)(x) = (f∘g)(y)
            f(g(x)) = f(g(y))             ; def of composition
            g(x) = g(y)                   ; f injective
            x = y                         ; g injective
qed
