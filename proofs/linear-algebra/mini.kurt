; mini.kurt
; simple proofs from group theory
load first-order, equality

; define function symbols for infix and prefix notations
infix  +  60 60           ; binary plus
prefix -     80           ; unary minus

parse ∀z (-(z + -z) + (z + (0 + -z)) = 0)

var x, y, z

use (x + y) + z = x + (y + z)       "G1" ; associativity
use 0 + x = x                       "G2" ; neutral element
use -x + x = 0                      "G3" ; left inverse

let z
    0 = -(z + -z) + (z + -z)                 ; by G3
      = -(z + -z) + (z + (0 + -z))           ; by G2
∀z (-(z + -z) + (z + (0 + -z)) = 0)
;;; Proof checked.