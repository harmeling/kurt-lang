; injective2.kurt
load logic
load equality

; 1.  injective(f), use def
; 2.  free vars not blocked, but different style, then again check for contain_blocked
; 3.  before going through all sub, just match the current formula with the previous ones, to find the correct sub
; 4. s.lookup(v) is None 

; task: prove that the composition of two injective functions is injective

infix ∘ 40 40                  ; composition
var φ, ψ, χ, ω                 ; operator variables: an operator is no object (doc/kurt-ref.md §5.3),
arity φ 1, ψ 1, χ 1, ω 1       ; so the functions that `∘` composes are operator parameters

use (%A ⇒ (%B ⇒ %C))  ⇒  (%A ∧ %B ⇒ %C)    "lemma"

def (φ ∘ ψ)($x) = φ(ψ($x))                                        "def of composition"
def injective((φ))  iff  ∀$x ∀$y (φ($x) = φ($y)  ⇒  $x = $y)     "def of injective"

show (φ ∘ ψ)($c) = (χ ∘ ω)($f) implies φ(ψ($c)) = χ(ω($f))  "composition rule"
proof
    assume (φ ∘ ψ)($c) = (χ ∘ ω)($f)
        (φ ∘ ψ)($c) = χ(ω($f))
        φ(ψ($c)) = χ(ω($f))
qed

const f, g
arity f 1, g 1

; theorem
show injective(f) ∧ injective(g) ⇒ injective(f ∘ g)
proof
    assume injective(f)
        ∀x ∀y (f(x)=f(y) ⇒ x=y)
        assume injective(g)
            ∀x ∀y (g(x)=g(y) ⇒ x=y)
            let x, y
                assume (f∘g)(x) = (f∘g)(y)
                    f(g(x)) = f(g(y))             ; def of composition
                    g(x) = g(y)                   ; f injective
                    x = y                         ; g injective
            injective(f ∘ g)
    injective(f) ∧ injective(g)  implies  injective(f ∘ g)
qed
