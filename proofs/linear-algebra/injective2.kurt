; injective2.kurt
load logic
load equality

; 1.  f is injective, use def
; 2.  free vars not blocked, but different style, then again check for contain_blocked
; 3.  before going through all sub, just match the current formula with the previous ones, to find the correct sub
; 4. s.lookup(v) is None 

; task: prove that the composition of two injective functions is injective

infix is 30 30                 ; as in "f is injective"
infix ∘ 40 40                  ; composition

use (%A ⇒ (%B ⇒ %C))  ⇒  (%A ∧ %B ⇒ %C)    "lemma"

const is   ; must be introduced already for the definition
def ($f ∘ $g)($x) = $f($g($x))                                    "def of composition"
def $f is injective  iff  ∀$x ∀$y ($f($x) = $f($y)  ⇒  $x = $y)   "def of injective"

show ($a ∘ $b)($c) = ($d ∘ $e)($f) implies $a($b($c)) = $d($e($f))  "composition rule"
proof
    assume ($a ∘ $b)($c) = ($d ∘ $e)($f)
        ($a ∘ $b)($c) = $d($e($f))
        $a($b($c)) = $d($e($f))
qed

const f, g
arity f 1, g 1

; theorem
show f is injective ∧ g is injective ⇒ (f ∘ g) is injective
proof
    assume f is injective
        ∀x ∀y (f(x)=f(y) ⇒ x=y)
        assume g is injective
            ∀x ∀y (g(x)=g(y) ⇒ x=y)
            let x, y
                assume (f∘g)(x) = (f∘g)(y)
                    f(g(x)) = f(g(y))             ; def of composition
                    g(x) = g(y)                   ; f injective
                    x = y                         ; g injective
            (f ∘ g) is injective
    f is injective ∧ g is injective  implies  (f ∘ g) is injective
qed
;;; Proof checked.
