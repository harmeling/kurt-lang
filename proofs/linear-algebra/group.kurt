; simple proofs from group theory
load "equality"

; define function symbols for infix and prefix notations
infix  +  60 60           ; binary plus
prefix -     80           ; unary minus

;var x, y, z

; group axioms
; (implicitly universally quantified over x, y, z)
use (x + y) + z = x + (y + z)       "G1" ; associativity
use 0 + x = x                       "G2" ; neutral element
use -x + x = 0                      "G3" ; left inverse

; left inverse is also the right inverse
show x + -x = 0                     "G4" ; right inverse
proof
    -(x + -x) + (x + -x)              = 0   ; by G3
    false
    -(x + -x) + (x + (0 + -x))        = 0   ; by G2
    -(x + -x) + (x + ((-x + x) + -x)) = 0   ; by G3
    -(x + -x) + ((x + (-x + x)) + -x) = 0   ; by G1
    -(x + -x) + (((x + -x) + x) + -x) = 0   ; by G1
    -(x + -x) + ((x + -x) + (x + -x)) = 0   ; by G1
    (-(x + -x) + (x + -x)) + (x + -x) = 0   ; by G1
    0 + (x + -x)                      = 0   ; by G3
    x + -x                            = 0   ; by G2
qed

; left neutral is also right neutral
show x + 0 = x                      "G5" ; right neutral
proof
    x + 0 = x + (-x + x)       ; by G3
    x + 0 = (x + -x) + x       ; by G1
    x + 0 = 0 + x              ; by G4
    x + 0 = x                  ; by G2
qed
;;; Proof checked.