; vectors and matrices as literals (matrix.kurt), computed exactly with `calc on`: `[1, 2, 3]` a
; row, `[[1, 2], [3, 4]]` row by row, `[[1], [3]]` a column, or one row per line
load matrix
calc on
[1, 2] + [3, 4] = [4, 6]
[[1, 2], [3, 4]] · [[1], [1]] = [[3], [7]]
2 · [1, 2, 3] = [2, 4, 6]
[1/2, 1] · 2 = [1, 2]
transpose [[1, 2, 3], [4, 5, 6]] = [[1, 4], [2, 5], [3, 6]]
det [[1, 2], [3, 4]] = -2
det [[2, 0, 1], [1, 3, 2], [0, 1, 1]] = 3
[[1, 2], [3, 4]] - [[1, 1], [1, 1]] = [[0, 1], [2, 3]]
[1, 2] ≠ [2, 1]

; one row per line, as on paper
def A = [1, 2, 3
         4, 5, 6]
A = [[1, 2, 3], [4, 5, 6]]
[1, 2, 3] · [1
             0
             1] = [4]

; wrong values and shapes that don't fit
expect "ProofError"
    [1, 2] + [3, 4] = [4, 7]
expect "ProofError"
    [[1, 2], [3, 4]] · [1, 1] = [3, 7]
expect "ProofError"
    det [1, 2, 3] = 0
