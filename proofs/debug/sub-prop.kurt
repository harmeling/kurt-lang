; sub-prop.kurt
infix  iff     10 10     ; logical if-and-only-if
prop   iff     0 1 2     ; `and` and its inputs have type prop
use %A iff %A                                                       "iff-reflexive"
use (sub %x %a %A) and (%a iff %b)  implies  (sub %x %b %A)         "iff-subst"

use A iff B
C and A  iff  C and A
C and A  iff  C and B
