; three-and.kurt
; simple test of the flat, sym of and
; written by Jan Robine (2025-05-08)

;;load prop
use %A  and  %B   implies   %A                                      "and-elim"   ; `and` is symmetric and flat
use p ∧ q ∧ r
p                   ; first position
r                   ; second position
q                   ; third position

bool a, b
use a ∧ b
a                   ; first position
b                   ; second position
