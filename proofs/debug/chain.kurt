; chain.kurt

infix = 10 10, ≤ 10 10, < 10 10
chain = ≤ <

; use $x = $y, $x ≤ $y, $x < $y
; z = y
;   = y
;   ≤ x
; y < x
;   ≤ a
;   = b
;   = c

infix iff 5 5
bool  iff 0 1 2
alias ⇔ iff

infix invimplies 50 50
bool  invimplies 0 1 2
alias ⇐ invimplies

chain iff implies      ; implies forwards
chain iff invimplies   ; implies backwards

use %A iff %B, %B invimplies %C
A iff B
  iff C
  implies C
  implies C
A ⇔ B
  ⇔ C
  ⇒ C
  ⇒ C

A ⇐ B
  ⇔ D
