; chain.kurt

infix = 10 10, ≤ 10 10, < 10 10
chain = ≤ <

; use $x = $y, $x ≤ $y, $x < $y
; z = y
;   = y
;   ≤ x
; y < x
;   ≤ a
;   = b
;   = c

; `iff`, `invimplies` and their chains with `implies` come from `prop.kurt` -- a file can't
; declare such a chain for its own `iff`, since that would derive new facts about the built-in
; `implies` from whatever that `iff` means
load prop

use %A iff %B, %B invimplies %C
A iff B
  iff C
  implies C
  implies C
A ⇔ B
  ⇔ C
  ⇒ C
  ⇒ C

A ⇐ B
  ⇔ D
