; `calc` computes only the symbols that a theory binds to the calculator (`calc + add`)
load equality
infix + 30 30
calc on
expect "ProofError"
    1 + 1 = 2                   ; `+` means nothing to the calculator yet
builtin + add
1 + 1 = 2
expect "EvalError"
    builtin + frobnicate           ; not an operation of the calculator
expect "EvalError"
    builtin + add multiply
