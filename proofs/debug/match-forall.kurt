; match-forall.kurt
load "first-order"
const A, B, C, D
arity A 1, B 1, C 1, D 1
bool A, B, C, D

; case 1: let's check the matching
use ∀ x  A x
∀ $x  A $x

; case 2: let's check the matching with a default variable
use ∀ $x  B $x
∀ x  B x

; case 3: let's check implicit variables
var x
use ∀ $x  C $x
C x

; case 4
use D x
∀ $x  D $x
;;; Proof checked.
