; set.kurt has no function extensionality: with mappings as opaque objects, every object is in
; `∅ → B` (there is nothing to check), so it gave any two objects equal -- here `0 = 1`
; (soundness review of 2026-09-29, §8.17)
load natural
let a
    assume a ∈ ∅
        not (a ∈ ∅)
        false
        (0 a) ∈ Nat
∀ a (a ∈ ∅ implies (0 a) ∈ Nat)
0 ∈ (∅ → Nat)
let a
    assume a ∈ ∅
        not (a ∈ ∅)
        false
        (1 a) ∈ Nat
∀ a (a ∈ ∅ implies (1 a) ∈ Nat)
1 ∈ (∅ → Nat)
let a
    assume a ∈ ∅
        not (a ∈ ∅)
        false
        (0 a) = (1 a)
∀ a (a ∈ ∅ implies (0 a) = (1 a))
expect "ProofError"
    0 = 1
