; the operators that come with Kurt's theories (and its core) are frozen: a file can't declare
; them `flat`/`sym`/`nonassoc`, or put them into a new `chain`, since that would change their
; meaning -- e.g. `chain ≠` would derive `a ≠ a` from `a ≠ b` and `b ≠ a`, and `sym -` would
; derive `a - b = b - a`
load arith
expect "EvalError"
    chain ≠
expect "EvalError"
    sym -
expect "EvalError"
    flat -
expect "EvalError"
    sym implies

; a file's own operators can still be chained after the frozen ones: `a = b and b lt c`
; concluding `a lt c` says nothing new about `=`
infix lt 20 20
bool lt 0
expect "EvalError"
    chain lt =         ; but this one would conclude `=` from `lt`
chain = lt

; and a file can't declare `flat`/`sym` for an operator it already used in a formula
infix plus 60 60
const a, b
use a plus b = b plus a
expect "EvalError"
    sym plus
