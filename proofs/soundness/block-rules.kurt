; the rules of the blocks, from the soundness review of 2026-09-29 (§8.17) -- each of these
; used to give `false`, `P d` from `P c`, or `a = b`
load numbers, logic
prop P, Q
arity P 1
arity Q 1
const P, Q, a, b, c, d
use P c

; `let`/`pick` can't take a variable that an assumption fixed: it would become "for all"
expect "EvalError"
    assume P $x
        let $x
            P $x
use ∃ $y ($y = d)
expect "EvalError"
    assume P $x
        pick $x with $x = d
            P $x

; the other variables of a `let` condition are fixed in its block, as for `assume`
expect "ProofError"
    let x = $y
        x = a
expect "ProofError"
    let x < $y
        x < 0

; the witness of a `pick` never leaves the block, even if it is a "vocabulary" symbol; since
; operators are no objects (doc/kurt-ref.md §5.3), an operator `w` can't even be the witness: the
; type check stops `w = x` before the block rules are asked
arity w 1
expect "TypeError" "`w` is an operator without its arguments"
    let x
        x = x
        ∃ $y ($y = x)
        pick w with w = x
            w = x
; (a statement witness: since 2026-10-20 binders range over terms, so `∃ %X` is a type error itself)
expect "TypeError" "a binder ranges over terms"
    let x
        use ∃ %X (%X iff P x)
        pick D with D iff P x
            D iff P x

; a condition binds the same variable outside its block: `e < x` binds `x` (stored when it is
; read, proofs/soundness/binder-variable-stored.kurt) -- it was a `ProofError` before, since `e`,
; a constant inside the block, is free outside it, and `e < x` would have bound `e` there
var x
sandbox
    let (0 < e)
        let (e < x)
            0 < x
    ∀ (0 < e) (∀ (e < x) (0 < x))
    break

; a bare `todo` is not the last line of a block
expect "ProofError"
    assume Q c
        todo

; an empty `sandbox` just closes
sandbox
    prop R
true
