; a term schema variable of an axiom may depend on a bound variable only if it is used like
; that: as the whole body of a binder over the same variable, and otherwise only inside binders
; over it or `sub`s for it (see `find_dependent_vars`) -- like `$T` in the sum axioms below;
; anywhere else it stays a fixed term
load natural
default real
const sum
arity sum 3
binder sum
use (sum $i ($a, $b + 1) $T) = (sub $i ($b + 1) $T) + (sum $i ($a, $b) $T)  "sum-last"
const n
(sum x (0, n + 1) (x * x)) = (n + 1) * (n + 1) + (sum x (0, n) (x * x))
(sum y (0, n + 1) 7) = 7 + (sum y (0, n) 7)

; inside a body, next to other things: `$S` and `$T` are the whole bodies of sums over `$i` too
use (sum $i ($a, $b) ($S + $T)) = (sum $i ($a, $b) $S) + (sum $i ($a, $b) $T)   "sum-add"
(sum x (0, n) (x + x * x)) = (sum x (0, n) x) + (sum x (0, n) (x * x))
; ... but a sum over another variable doesn't make `$T` depend on this one
use (sum $j (0, 1) $T) + (sum $i (0, 1) ($T * 0)) = 7   "sum-other"
(sum j (0, 1) 2) + (sum i (0, 1) (2 * 0)) = 7
expect "ProofError"
    (sum j (0, 1) i) + (sum i (0, 1) (i * 0)) = 7

; `$C` also occurs outside the binder, so it must not depend on the bound variable
use (sum $i ($a, $b) $C) = ($b - $a + 1) * $C                          "sum-const"
(sum y (1, n) 7) = (n - 1 + 1) * 7
expect "ProofError"
    (sum y (1, n) y) = (n - 1 + 1) * y

; and `$T` in the body of `forall`, next to other things, is a fixed term too
prop Q
use (forall $x ($x = $T)) and (P $T) implies Q    "attack"
use forall $w (P $w)
expect "ProofError"
    Q
