; numbers.kurt and `calc` on powers (soundness review of 2026-09-29): each of these used to give `0 = 1`
; or `1 = -1`, crash Kurt, or hang it
load numbers
calc on

; `calc` doesn't compute `0 ^ 0` (numbers.kurt leaves it open, "pow-zero" needs `$a ≠ 0`): with
; "pow-add", `0 = 0 ^ 1 * 0 ^ (-1) = 0 ^ 0 = 1`
const x
use x = 0 ^ 0
expect "ProofError"
    x = 1
2 ^ 0 = 1

; "pow-add" and "pow-mul" only for a positive base: `((-1) ^ 2) ^ (1 / 2)` is `1 ^ (1 / 2)`, which
; is `1` (by "pow-mul" with the base `1`), but `(-1) ^ (2 * (1 / 2))` is `-1`
expect "ProofError"
    ((- 1) ^ 2) ^ (1 / 2) = (- 1) ^ (2 * (1 / 2))
expect "ProofError"
    0 ^ 1 * 0 ^ (- 1) = 0 ^ (1 + (- 1))

; no number is too big for `calc`: it just doesn't compute results with more than 1000 digits
; (Python can't print them, and `(3 ^ 10000) ^ 10000` would take forever) ...
10 ^ 5000 = 10 ^ 5000
const y
use y = (3 ^ 10000) ^ 10000
expect "ProofError"
    y = 0
2 ^ 1000 * 2 ^ 1000 = 2 ^ 2000
; ... and a number with more than 1000 digits is a syntax error (the lexer would crash)
expect "SyntaxError"
    use y = 

; `^` is right-associative, and the prefix `-` weaker than it: `- 2 ^ 2` is `- 4`, as usual
- 2 ^ 2 = - 4
2 ^ 3 ^ 2 = 512
(- 2) ^ 2 = 4
