; coverage test for arith.kurt's exponent laws ("pow-zero", "pow-add", "pow-mul"), added
; alongside "pow-identity" (previously the only real axiom about `^`, kept minimal originally
; just to stop `^`'s own syntax from being silently dropped by selective export -- see
; doc/kurt-soundness.md #7.3). "pow-zero" is guarded by `$a != 0` since 0^0 is conventionally
; left undefined.
load arith
use 5 ≠ 0
use 2 > 0

5 ^ 0 = 1
2 ^ 3 * 2 ^ 4 = 2 ^ (3 + 4)
(2 ^ 3) ^ 4 = 2 ^ (3 * 4)
