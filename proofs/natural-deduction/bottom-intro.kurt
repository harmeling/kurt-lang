; bottom-intro.kurt
; minimal setup from propositional.kurt
prefix not        18  ; logical not
prop   not     0 1    ; `not` and its inputs have type prop
prop   false          ; false has type prop

use %A  and  %B   implies   %A and %B                               "and-intro"
use %A and not %A implies false                                     "bottom-intro"

prop p
use p
use not p
; p and not p
false
