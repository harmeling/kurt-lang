; two-styles.kurt

; syntax
prefix not        18  ; logical not
prop   not     0 1    ; `not` and its inputs have type prop
prop   false          ; false has type prop
alias  ¬ not
alias  ⊥ false

; inference rules
use ¬¬%p implies %p           "double-not-elim"
use (%p implies ⊥) implies ¬%p      "not-intro"

; let's prove something!
const q
show ⊥ implies q  "ex-falso-quodlibet"
proof
    assume ⊥
        assume ¬q
            ⊥
        ¬¬q
        q
qed

show ⊥ implies %q  "ex-falso-quodlibet"
proof
    assume ⊥
        assume ¬%q
            ⊥
        ¬¬%q
        %q
    ⊥ implies %q
qed
