; example: exists-intro
;load "first-order"
load "equality"
load "first-order"

bool  prime
arity prime 1        ; `prime` expects exactly one argument

use prime 2

consider
    const x
    use x = 2
    prime x
thus ∃ $z prime $z

fix x
    use x = 2
    prime x
thus ∃ $z prime $z

take x = 2
    prime x
thus ∃ $z prime $z

;;; Proof checked.
