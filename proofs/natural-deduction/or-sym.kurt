load propositional

; this version should be usable when loaded as an extension in another file, since we do not declare anything local here
; the key is that there are no quantifier for bool vars, but
; they are implicitly universally quantified

var a, b
show a ∨ b  ⇔  b ∨ a   "or-sym"
proof
    fix a, b
        assume a ∨ b
            assume a
                b ∨ a
            thus a ⇒ b ∨ a
            assume b
                b ∨ a
            thus b ⇒ b ∨ a
            b ∨ a
        thus a ∨ b ⇒ b ∨ a
        assume b ∨ a
            assume b
                a ∨ b
            thus b ⇒ a ∨ b
            assume a
                a ∨ b
            thus a ⇒ a ∨ b
            a ∨ b
        thus b ∨ a ⇒ a ∨ b
    thus a ∨ b  ⇔  b ∨ a
qed
;;; Proof checked.