; lemma.kurt

show (%A ⇒ (%B ⇒ %C))  ⇒  (%A ∧ %B ⇒ %C)
proof
    fix A, B, C
        assume (A ⇒ (B ⇒ C))
            assume A ∧ B
                A
                B
                B ⇒ C
                C
            thus A ∧ B ⇒ C
        thus (A ⇒ (B ⇒ C))  ⇒  (A ∧ B ⇒ C)
    thus (%A ⇒ (%B ⇒ %C))  ⇒  (%A ∧ %B ⇒ %C)
qed
;;; Proof checked.