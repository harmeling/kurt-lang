; lemma.kurt
load propositional
var A, B, C
show (A ⇒ (B ⇒ C))  ⇒  (A ∧ B ⇒ C)
proof
    let A, B, C                              ; `let` turns variables into constants
        assume (A ⇒ (B ⇒ C))
            assume A ∧ B
                A
                B
                B ⇒ C
                C
qed

show %E ∧ %F  ⇒  %F ∧ %E
proof
    let %E, %F
        assume %E ∧ %F
            %E
            %F
            %F ∧ %E
qed
;;; Proof checked.