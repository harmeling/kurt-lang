; lemma.kurt
load propositional

show %E ∧ %F  ⇒  %F ∧ %E
proof
    fix E, F
        assume E ∧ F
            E
            F
            F ∧ E
        thus E ∧ F ⇒ F ∧ E
    thus %E ∧ %F  ⇒  %F ∧ %E
qed

show (%A ⇒ (%B ⇒ %C))  ⇒  (%A ∧ %B ⇒ %C)
proof
    fix A, B, C
        assume (A ⇒ (B ⇒ C))
            assume A ∧ B
                A
                B
                B ⇒ C
                C
            thus A ∧ B ⇒ C
        thus (A ⇒ (B ⇒ C))  ⇒  (A ∧ B ⇒ C)
    thus (%A ⇒ (%B ⇒ %C))  ⇒  (%A ∧ %B ⇒ %C)
qed
;;; Proof checked.