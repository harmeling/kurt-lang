load "propositional"
bool p

; what to show
show p ∨ ¬p  "excluded-middle"
proof
    show ¬ (p ∨ ¬ p) ⇒ ⊥
    proof
        assume ¬ (p ∨ ¬ p)
            assume p
                p ∨ ¬ p
                ⊥
            thus p ⇒ ⊥
            ¬ p
            p ∨ ¬ p
            ⊥
        thus ¬ (p ∨ ¬ p) ⇒ ⊥
    qed
    ¬ ¬ (p ∨ ¬ p)
    p ∨ ¬ p
qed
;;; Proof checked.