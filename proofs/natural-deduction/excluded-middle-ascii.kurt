load "propositional"
bool p
var p

; what to show
show p or not p  "excluded-middle"
proof
    show not (p or not p) implies false
    proof
        const p             ; locally make it a constant
        assume not (p or not p)
            assume p
                p or not p
                contradiction
            thus p implies false
            not p
            p or not p
            contradiction
        thus not (p or not p) implies false
    qed
    not not (p or not p)
    p or not p
qed
;;; Proof checked.