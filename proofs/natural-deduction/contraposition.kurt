; contraposition.kurt
load prop
load excluded-middle      ; `%p ∨ ¬%p`, proven in excluded-middle.kurt
var A, B

; lemma
show A ⇒ B  ≡  ¬A ∨ B
proof
    show (A ⇒ B)  ⇒  (¬A ∨ B)
    proof
        assume A ⇒ B
            assume A
                B
                ¬A ∨ B
            assume ¬A
                ¬A ∨ B
            A ∨ ¬A                ; the excluded middle
            ¬A ∨ B                ; by or-elim
    qed
    show (¬A ∨ B)  ⇒  (A ⇒ B)
    proof
        assume ¬A ∨ B
            assume A
                assume ¬A
                    contradiction
                    B
                assume B
                    B
                B
    qed
    A ⇒ B  ≡  ¬A ∨ B
qed

; theorem
show (A ⇒ B)  ≡  (¬B ⇒ ¬A)   "contraposition"
proof
    A ⇒ B  ≡  ¬A ∨ B
           ≡  B ∨ ¬A
           ≡  ¬¬B ∨ ¬A
           ≡  ¬B ⇒ ¬A
qed
