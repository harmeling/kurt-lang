; contraposition.kurt
load prop
var A, B

; lemma
show A ⇒ B  ≡  ¬A ∨ B
proof
    show (A ⇒ B)  ⇒  (¬A ∨ B)
    proof
        assume A ⇒ B
            assume A
                B
                ¬A ∨ B
            assume ¬A
                ¬A ∨ B
            ; the excluded middle, A ∨ ¬A: otherwise A, and also ¬A, would give A ∨ ¬A
            assume ¬(A ∨ ¬A)
                assume A
                    A ∨ ¬A
                    contradiction
                ¬A
                A ∨ ¬A
                contradiction
            ¬¬(A ∨ ¬A)
            A ∨ ¬A                ; by not-elim
            ¬A ∨ B                ; by case-elim
    qed
    show (¬A ∨ B)  ⇒  (A ⇒ B)
    proof
        assume ¬A ∨ B
            assume A
                assume ¬A
                    contradiction
                    B
                assume B
                    B
                B
    qed
    A ⇒ B  ≡  ¬A ∨ B
qed

; theorem
show (A ⇒ B)  ≡  (¬B ⇒ ¬A)   "contraposition"
proof
    A ⇒ B  ≡  ¬A ∨ B
           ≡  B ∨ ¬A
           ≡  ¬¬B ∨ ¬A
           ≡  ¬B ⇒ ¬A
qed
