; de Morgan's law
load "propositional"
bool p, q       ; constants

; axioms
use p ∨ ¬p         "excluded-middle"

; first law
show ¬(p∧q) ≡ ¬p ∨ ¬q    "de-morgan"
proof
    show ¬(p∧q) ⇒ ¬p ∨ ¬q
    proof
        assume ¬(p∧q)
        show p ⇒ ¬p ∨ ¬q
        proof
            assume p
            show q ⇒ ⊥
            proof
                assume q
                p and q
                ⊥
            qed
            ¬ q
            ¬p ∨ ¬q
        qed
        show ¬p ⇒ ¬p ∨ ¬q
        proof
            assume ¬p
            ¬p ∨ ¬q
        qed
        ¬p ∨ ¬q
    qed
    show ¬p ∨ ¬q ⇒ ¬(p∧q)
    proof
        assume ¬p ∨ ¬q
        show ¬p ⇒ ¬(p∧q)
        proof
            assume ¬p
            show p∧q ⇒ ⊥
            proof
                assume p∧q
                p
                ⊥
            qed
            ¬(p∧q)
        qed
        show ¬q ⇒ ¬(p∧q)
        proof
            assume ¬q
            show p∧q ⇒ ⊥
            proof
                assume p∧q
                q
                ⊥
            qed
            ¬(p∧q)
        qed
        ¬(p∧q)
    qed
    ¬(p∧q) ≡ ¬p ∨ ¬q
qed

;; second law
show ¬(p∨q) ≡ ¬p ∧ ¬q        "de-morgan"
proof
    show ¬(p∨q) ⇒ ¬p ∧ ¬q
    proof
        assume ¬(p∨q)
        show ¬p
        proof
            show p ⇒ ⊥
            proof
                assume p
                p ∨ q
                ⊥
            qed
            ¬p
        qed
        show ¬q
        proof
            show q ⇒ ⊥
            proof
                assume q
                p ∨ q
                ⊥
            qed
            ¬q
        qed
        ¬p ∧ ¬q
    qed
    show ¬p ∧ ¬q ⇒ ¬(p∨q)
    proof
        assume ¬p ∧ ¬q
        show p∨q ⇒ ⊥
        proof
            assume p∨q
            show p ⇒ ⊥
            proof
                assume p
                ¬p
                ⊥
            qed
            show q ⇒ ⊥
            proof
                assume q
                ¬q
                ⊥
            qed
            ⊥
        qed
        ¬(p∨q)
    qed
    ¬(p∨q) ≡ ¬p ∧ ¬q
qed
;;; Proof checked.