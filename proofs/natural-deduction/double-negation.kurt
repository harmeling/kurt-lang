load "propositional"
var p
bool p
show p ⇒ ¬¬p
proof
    const p             ; local constant
    assume p
        assume ¬p
            p ∧ ¬p
            ⊥
        thus ¬p ⇒ ⊥
        ¬¬p
    thus p ⇒ ¬¬p
qed                     ; finally generalize from the local constant to a variable
;;; Proof checked.
