load "propositional"
bool p
show p ⇒ ¬¬p
proof
    assume p
        assume ¬p
            p ∧ ¬p
            ⊥
        thus ¬p ⇒ ⊥
        ¬¬p
    thus p ⇒ ¬¬p
qed

