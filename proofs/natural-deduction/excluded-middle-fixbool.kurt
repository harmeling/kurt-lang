load "propositional"

; this version should be usable when loaded as well
; the key is that there are no quantifier for bool vars, but
; they are implicitly universally quantified

show %p ∨ ¬%p  "excluded-middle"
proof
    fix p 
        bool p
        assume ¬(p ∨ ¬p)
            assume p
                p ∨ ¬p
                ⊥
            thus p ⇒ ⊥
            ¬p
            p ∨ ¬p
            ⊥
        thus ¬(p ∨ ¬p) ⇒ ⊥
        ¬¬(p ∨ ¬p)
        p ∨ ¬p
    thus %p ∨ ¬%p
qed
;;; Proof checked.