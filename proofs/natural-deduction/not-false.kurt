; proof-not-false.kurt
load propositional
show ¬⊥
proof
    assume ⊥
        ⊥              ; restatement
    thus ⊥ ⇒ ⊥         ; impl-intro
    ¬⊥                 ; not-intro
qed

;; alternative syntax
; show not false
; proof
;     assume false
;         contradiction
;     not false
; qed

;;; Proof checked.