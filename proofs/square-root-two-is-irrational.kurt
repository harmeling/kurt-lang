; squareroot of two is not a rational number.

false ; NOT YET

; `forall` leads locally to new free variables
; `exists` on top-level leads to new constants

var x, y, a, b
const Q
var m:Nat, n:Nat

; axioms
use x in Q  iff  exists (m, n)   m/n=x                                ; Q1
use y = sqrt(x) implies y*y = x                                       ; S1
use a divides b  implies  exists k  a*k = b                           ; D1
use coprime(m, n)  iff  not exists k  (k divides m) and (k divides n) ; C1

show not coprime(m0, n0)  implies  exists (m,n) coprime(m,n) and m/n = m0/n0
proof
    assume not coprime(m0, n0)
    exists k (k divides m0) and (k divides n0)
    m := m0/k
    n := n0/k
    ; here is still some difficulty, because we have to repeat this step as often as necessary
qed

show not (sqrt(2) in Q)
proof
    x := sqrt(2)
    assume x in Q
    exists (m0, n0) m0/n0=x
    coprime(m0,n0) or not coprime(m0,n0)
    begin
        assume coprime(m0, n0)
        m := m0
        n := n0
        coprime(m, n) and x = m/n
    end
    begin
        assume not coprime(m0, n0)
        exists (m,n) coprime(m,n) and m/n = m0/n0
        coprime(m, n) and x = m/n
    end
    coprime(m, n) and x = m/n
    coprime(m, n)
    x = m/n
    m = n * x
    m*m = n*n * x*x = n*n * 2
    2 divides m*m
    2 divides m
    show 2 divides n
    proof
        2 divides m          ; again
        exists k 2*k=m       ; D1
        2*n*n = m*m = 4*k*k
        n*n = 2*k*k
        2 divides n*n
        2 divides n
    qed
    (2 divides m) and (2 divides n)
    exists k  (k divides m) and (k divides n)
    not coprime(m ,n)
    contradiction
    not (x in Q)
qed
