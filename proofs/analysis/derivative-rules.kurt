; the rules of differentiation, step by step: each rule needs that its parts are differentiable
; (`diff`), and the derivative of a constant needs a constant (see derivative.kurt)
load derivative

; (y² + 1)³ at y = 1, by the chain rule: the outer function x³ at x = 2, times the inner one
calc on
3 ∈ Nat
diff x 2 (x ^ 3)
(deriv x 2 (x ^ 3)) = 3 * 2 ^ (3 - 1)                     ; by deriv-pow
    = 12
diff y 1 y
diff y 1 (y * y)                                        ; by diff-mul
diff y 1 1                                              ; by diff-const, a constant
diff y 1 (y * y + 1)                                    ; by diff-add
calc off                                                ; (with `calc on`, a rule's `1 * ...` isn't computed)
(deriv y 1 y) = 1                                       ; by deriv-id
(deriv y 1 (y * y)) = (deriv y 1 y) * 1 + 1 * (deriv y 1 y)       ; by deriv-mul
    = 1 * 1 + 1 * 1
(deriv y 1 1) = 0                                       ; by deriv-const
(deriv y 1 (y * y + 1)) = (deriv y 1 (y * y)) + (deriv y 1 1)   ; by deriv-add
    = (1 * 1 + 1 * 1) + (deriv y 1 1)
    = (1 * 1 + 1 * 1) + 0
calc on                                                 ; (the point of the outer function: 1 * 1 + 1)
(deriv y 1 (y * y + 1)) = 2
diff y 1 ((y * y + 1) ^ 3)                              ; by diff-chain
(deriv y 1 ((y * y + 1) ^ 3)) = (deriv x 2 (x ^ 3)) * (deriv y 1 (y * y + 1))   ; by deriv-chain
calc off                                                ; (a substitution's `12 * 2` isn't computed)
(deriv y 1 ((y * y + 1) ^ 3)) = 12 * (deriv y 1 (y * y + 1))
    = 12 * 2
calc on
(deriv y 1 ((y * y + 1) ^ 3)) = 24
calc off

; the rules for functions `f`, `g` that are differentiable at 2
const f, g
arity f 1, g 1
use diff x 2 (f x)
use diff x 2 (g x)
diff x 2 (3 * f x)                                      ; by diff-scale
(deriv x 2 (3 * f x)) = 3 * (deriv x 2 (f x))
(deriv x 2 (f x - g x)) = (deriv x 2 (f x)) - (deriv x 2 (g x))
(deriv x 2 (f x * g x)) = (deriv x 2 (f x)) * g 2 + f 2 * (deriv x 2 (g x))
use g 2 ≠ 0
(deriv x 2 (f x / g x)) = ((deriv x 2 (f x)) * g 2 - f 2 * (deriv x 2 (g x))) / (g 2) ^ 2

; Fermat: a local maximum of `f` at 2
use ∃ $d > 0 ∀ $y (abs($y - 2) < $d ⇒ f $y <= f 2)
(deriv x 2 (f x)) = 0                                   ; by deriv-max

; the mean value theorem for `g` on [0, 1]
use ∀ $y ((0 <= $y ∧ $y <= 1) ⇒ cont x $y (g x))
use ∀ $y ((0 < $y ∧ $y < 1) ⇒ diff x $y (g x))
calc on
0 < 1
calc off
∃ $c (0 < $c ∧ $c < 1 ∧ (deriv x $c (g x)) * (1 - 0) = g 1 - g 0)   ; by mean-value
