load integral
; the integral of 2x from 0 to 1 is 1: x^2 is an antiderivative of 2x
calc on
0 <= 1
2 ∈ Nat
0 < 2
let y
    assume 0 <= y ∧ y <= 1
        diff x y (x ^ 2)
        (deriv x y (x ^ 2)) = 2 * y ^ (2 - 1)
            = 2 * y ^ 1
            = 2 * y
        (diff x y (x ^ 2)) ∧ (deriv x y (x ^ 2)) = 2 * y
let y
    assume 0 <= y ∧ y <= 1
        diff x y x
        diff x y (2 * x)
        cont x y (2 * x)
integrable x (0, 1) (2 * x)
calc off
(integral x (0, 1) (2 * x)) = 1 ^ 2 - 0 ^ 2          ; by ftc
calc on
(integral x (0, 1) (2 * x)) = 1
