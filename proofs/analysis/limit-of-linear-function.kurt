; the limit of 3x + 1 for x going to 2 is 7, by ε and δ: for every ε > 0, δ = ε / 3 will do
load analysis
calc on

show lim x 2 (3 * x + 1) = 7
proof
    let ε > 0
        3 > 0
        ε / 3 > 0
        let y
            assume 0 < abs(y - 2) ∧ abs(y - 2) < ε / 3
                abs(y - 2) < ε / 3
                (3 * y + 1) - 7 = 3 * y - 6                         ; by add-sub, computing `7 - 1`
                (y - 2) * 3 = 3 * y - 6                             ; by distrib-sub, computing `2 * 3`
                (3 * y + 1) - 7 = (y - 2) * 3
                abs(y - 2) * 3 < (ε / 3) * 3                        ; by lt-mul-pos
                3 ≠ 0
                (ε / 3) * 3 = ε                                     ; by div-mul
                3 >= 0
                abs(3) = 3                                          ; by abs-nonneg
                abs((3 * y + 1) - 7) = abs((y - 2) * 3)
                    = abs(y - 2) * abs(3)
                    = abs(y - 2) * 3
                    < (ε / 3) * 3
                    = ε
        ∃ δ > 0 ∀ y ((0 < abs(y - 2) ∧ abs(y - 2) < δ) ⇒ abs((3 * y + 1) - 7) < ε)
qed
